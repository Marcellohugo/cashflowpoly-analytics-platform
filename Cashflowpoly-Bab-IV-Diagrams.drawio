ik" style="rounded=0;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#173A55;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="message-d4d112ae55"><mxGeometry x="8" y="0" width="264.0" height="48" as="geometry"/></mxCell><mxCell id="message-4345bd8c13" style="group;" vertex="1" connectable="0" parent="1"><mxGeometry x="437.5" y="284" width="280.0" height="56" as="geometry"/></mxCell><mxCell id="message-edge-213a7bf426" style="edgeStyle=none;html=1;strokeColor=#0D6F69;strokeWidth=2;endArrow=classic;" edge="1" parent="message-4345bd8c13"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="56" as="sourcePoint"/><mxPoint x="280.0" y="56" as="targetPoint"/></mxGeometry></mxCell><mxCell id="text-d2ca91c929" value="2. Operator memilih aksi dan mengisi bukti" style="rounded=0;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#173A55;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="message-4345bd8c13"><mxGeometry x="8" y="0" width="264.0" height="48" as="geometry"/></mxCell><mxCell id="text-e56f1e5082" value="3. IDN memvalidasi field lokal dan membuat UUID" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F7FAFB;strokeColor=#BCD6E1;fontColor=#173A55;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="597.5" y="364" width="240" height="58" as="geometry"/></mxCell><mxCell id="message-551de37f5f" style="group;" vertex="1" connectable="0" parent="1"><mxGeometry x="717.5" y="424" width="280.0" height="56" as="geometry"/></mxCell><mxCell id="message-edge-dc1c03c1a6" style="edgeStyle=none;html=1;strokeColor=#0D6F69;strokeWidth=2;endArrow=classic;" edge="1" parent="message-551de37f5f"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="56" as="sourcePoint"/><mxPoint x="280