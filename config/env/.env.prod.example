# Fungsi file: Menyediakan template variabel environment untuk deployment production.
# Cashflowpoly Analytics Platform - Production Environment Variables
# Salin file ini ke config/env/.env.prod lalu isi nilainya.
#   Copy-Item config/env/.env.prod.example config/env/.env.prod

# ---------- PostgreSQL ----------
POSTGRES_DB=cashflowpoly
POSTGRES_USER=cashflowpoly
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_PORT=5432

# ---------- API ----------
API_ASPNETCORE_ENVIRONMENT=Production
API_HTTP_PORT=5041
LEGACY_API_COMPATIBILITY=false

# ---------- Bootstrap akun awal (opsional) ----------
# Untuk instalasi baru, isi akun Instruktur pertama lalu aktifkan flag ini.
# Setelah akun berhasil dibuat, kembalikan flag ke false dan kosongkan password.
AUTH_BOOTSTRAP_SEED_DEFAULT_USERS=false
AUTH_BOOTSTRAP_INSTRUCTOR_USERNAME=
AUTH_BOOTSTRAP_INSTRUCTOR_PASSWORD=
AUTH_BOOTSTRAP_PLAYER_USERNAME=
AUTH_BOOTSTRAP_PLAYER_PASSWORD=

# ---------- UI ----------
UI_ASPNETCORE_ENVIRONMENT=Production
UI_HTTP_PORT=5203

# ---------- Local Source Build Deployment ----------
# Deployment production membangun image langsung dari source lokal.
# Tidak perlu registry image, tag branch, atau credential registry eksternal.

# ---------- JWT ----------
JWT_SIGNING_KEY=GANTI_DENGAN_SIGNING_KEY_MINIMAL_32_KARAKTER
JWT_ACTIVE_KEY_ID=legacy
# JWT_SIGNING_KEYS_JSON=
# JWT_SIGNING_KEY_FILE=
# JWT_SIGNING_KEYS_FILE=

# ---------- Nginx / Domain ----------
DOMAIN=narafin.org

# ---------- Cloudflare Tunnel ----------
# Wajib untuk template production ini karena tunnel menjadi terminasi HTTPS publik.
CLOUDFLARE_TUNNEL_TOKEN=
