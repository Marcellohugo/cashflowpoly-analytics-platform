# Fungsi file: Menyediakan template variabel environment untuk deployment development.
# Cashflowpoly Analytics Platform - Development Environment Variables
# Salin file ini ke config/env/.env.dev lalu isi nilainya.
#   Copy-Item config/env/.env.dev.example config/env/.env.dev

# ---------- PostgreSQL ----------
# Uraian baris: Nama database PostgreSQL yang dibuat/dipakai layanan db; aplikasi mengarah ke database ini melalui connection string hasil konfigurasi Compose.
POSTGRES_DB=cashflowpoly
# Uraian baris: Nama pengguna PostgreSQL yang dipakai koneksi aplikasi; nilainya harus cocok dengan akun yang tersedia pada volume database.
POSTGRES_USER=cashflowpoly
# Uraian baris: Kata sandi untuk akun PostgreSQL. Nilai contoh ini adalah placeholder dan akan dipakai oleh interpolasi environment saat menyiapkan database serta koneksi API.
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
# Uraian baris: Port PostgreSQL pada host; pemetaan Compose memungkinkan alat lokal mengakses database, sedangkan koneksi antarlayanan memakai nama layanan dan port internal.
POSTGRES_PORT=5432

# ---------- API ----------
# Uraian baris: Environment ASP.NET Core bagi API. Development mengaktifkan perilaku pengembangan, sedangkan Production memakai kebijakan konfigurasi produksi.
API_ASPNETCORE_ENVIRONMENT=Development
# Uraian baris: Port HTTP API yang dipetakan pada host untuk mengakses REST API dan health check dari luar jaringan internal container.
API_HTTP_PORT=5041
# Uraian baris: Sakelar kompatibilitas rute API lama. false mempertahankan penggunaan kontrak versi /api/v1 tanpa mengaktifkan rewrite rute transisi.
LEGACY_API_COMPATIBILITY=false

# ---------- Bootstrap akun awal (opsional) ----------
# Aktifkan hanya saat perlu membuat akun pertama. Password harus 12-72 byte UTF-8.
# Uraian baris: Sakelar bootstrap akun awal pada startup. false tidak meminta pembuatan akun awal melalui variabel kredensial bootstrap.
AUTH_BOOTSTRAP_SEED_DEFAULT_USERS=false
# Uraian baris: Nama pengguna akun Instruktur awal. String kosong berarti template belum menentukan akun; harus berpasangan dengan password bila bootstrap diaktifkan.
AUTH_BOOTSTRAP_INSTRUCTOR_USERNAME=
# Uraian baris: Password akun Instruktur awal. Template mengosongkannya agar nilai nyata diberikan melalui environment saat bootstrap akun diperlukan.
AUTH_BOOTSTRAP_INSTRUCTOR_PASSWORD=
# Uraian baris: Nama pengguna akun Player awal. Bootstrap memeriksa kelengkapan pasangan username/password sebelum membuat akun.
AUTH_BOOTSTRAP_PLAYER_USERNAME=
# Uraian baris: Password akun Player awal yang opsional. Nilai ini dibaca konfigurasi bootstrap, bukan dipakai sebagai password seluruh peserta sesi.
AUTH_BOOTSTRAP_PLAYER_PASSWORD=

# ---------- UI ----------
# Uraian baris: Environment ASP.NET Core bagi aplikasi MVC; menentukan pemuatan konfigurasi development/production dan penanganan error pada antarmuka.
UI_ASPNETCORE_ENVIRONMENT=Development
# Uraian baris: Port host untuk aplikasi Web Analitik; browser mengakses UI melalui port ini pada deployment lokal.
UI_HTTP_PORT=5203

# ---------- Local Source Build ----------
# Development dan production sama-sama build image dari source lokal.

# ---------- JWT ----------
# Uraian baris: Rahasia penandatanganan JWT API. Validator produksi menolak placeholder dan panjang kurang dari 32 karakter; klien menggunakan token hasil tanda tangan, bukan rahasia ini.
JWT_SIGNING_KEY=GANTI_DENGAN_SIGNING_KEY_MINIMAL_32_KARAKTER
# Uraian baris: Identitas kunci aktif yang dimasukkan sebagai kid pada token. Identitas ini menghubungkan penandatanganan token baru dengan kunci validasi yang sesuai.
JWT_ACTIVE_KEY_ID=legacy
# JWT_SIGNING_KEYS_JSON=
# JWT_SIGNING_KEY_FILE=
# JWT_SIGNING_KEYS_FILE=

# ---------- Nginx / Domain ----------
# Uraian baris: Nama host publik yang digunakan konfigurasi deployment. Validator produksi melarang localhost; skrip deployment memakainya sebagai header Host saat pemeriksaan akses.
DOMAIN=localhost

# ---------- Cloudflare Tunnel ----------
# Uraian baris: Token autentikasi cloudflared untuk menghubungkan layanan tunnel ke Cloudflare; kosong pada template dan wajib diisi pada konfigurasi produksi dengan tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
