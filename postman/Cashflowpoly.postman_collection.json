{
  "info": {
    "name": "Cashflowpoly API",
    "description": "Collection kontrak API Cashflowpoly baseline schema 3.0.13 (20 Agustus 2026). Isi authUsername dan authPassword dengan akun Instruktur yang sudah di-bootstrap, lalu jalankan koleksi dari awal. Dua request event bertanda Reject adalah uji negatif dan harus menghasilkan 422.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date().toISOString();",
          "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
          "  const r = Math.random() * 16 | 0;",
          "  const v = c === 'x' ? r : (r & 0x3 | 0x8);",
          "  return v.toString(16);",
          "});",
          "const setVar = (key, value) => {",
          "  pm.collectionVariables.set(key, value);",
          "  pm.environment.set(key, value);",
          "};",
          "const ensure = (key, value) => {",
          "  const current = pm.variables.get(key);",
          "  if (!current || String(current).trim() === '' || String(current).startsWith('replace-with-')) {",
          "    setVar(key, value);",
          "  }",
          "};",
          "setVar('timestamp', now);",
          "const suffix = Date.now().toString().slice(-8);",
          "ensure('deniedInstructorUsername', `instructor_denied_${suffix}`);",
          "ensure('deniedInstructorPassword', 'Pass123!Aa2026');",
          "ensure('playerUsername', `player_${suffix}`);",
          "ensure('playerPassword', 'Pass123!Aa2026');",
          "ensure('secondPlayerUsername', `player_b_${suffix}`);",
          "ensure('secondPlayerPassword', 'Pass123!Aa2026');",
          "ensure('rulesetVersionNumber', '1');",
          "const startsCollectionRun = pm.info.requestName === 'Verify Public Instructor Registration Is Rejected';",
          "if (startsCollectionRun) {",
          "  setVar('deniedInstructorUsername', `instructor_denied_${suffix}`);",
          "  setVar('playerUsername', `player_${suffix}`);",
          "  setVar('secondPlayerUsername', `player_b_${suffix}`);",
          "  setVar('accessToken', '');",
          "}",
          "const eventIdKeys = [",
          "  'eventIdFreelance','eventIdNeedPrimary','eventIdNeedSecondary','eventIdNeedTertiary','eventIdIngredient',",
          "  'eventIdOrder','eventIdRisk','eventIdInsuranceUsed','eventIdTurnEnd','eventIdMission','eventIdInsurance',",
          "  'eventIdSavingDeposit','eventIdSavingWithdraw','eventIdSavingGoal','eventIdLoanTaken','eventIdLoanRepaid',",
          "  'eventIdOrderPassed','eventIdIngredientDiscarded','eventIdRiskEmergency','eventIdBatch1','eventIdBatch2',",
          "  'eventIdDonation','eventIdGoldBuy'",
          "];",
          "eventIdKeys.forEach(function(key) {",
          "  if (startsCollectionRun || !pm.collectionVariables.get(key)) {",
          "    setVar(key, uuid());",
          "  }",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedByRequest = {",
          "  'Verify Public Instructor Registration Is Rejected': [403],",
          "  'Login': [200],",
          "  'Create Ruleset PEMULA': [201],",
          "  'Update Ruleset PEMULA': [200],",
          "  'Create Ruleset MAHIR': [201],",
          "  'List Rulesets': [200],",
          "  'Get Ruleset Detail': [200],",
          "  'Get Ruleset Components': [200],",
          "  'Get Default Ruleset Components': [200],",
          "  'Get Game Components Alias': [200],",
          "  'Get Ruleset Sections': [200],",
          "  'Activate Ruleset Version': [200],",
          "  'Delete Ruleset Version': [422],",
          "  'Delete Ruleset': [422],",
          "  'Create Session': [201],",
          "  'List Sessions': [200],",
          "  'Start Session': [200],",
          "  'End Session': [200],",
          "  'Get Session State': [200],",
          "  'Write Session State Disabled': [410],",
          "  'Create Player A': [201],",
          "  'Create Player B': [201],",
          "  'List Players': [200],",
          "  'Add Player A To Session': [200],",
          "  'Add Player B To Session': [200],",
          "  'List Session Players': [200],",
          "  'Create Event': [201],",
          "  'Need Primary Purchased': [201],",
          "  'Ingredient Purchased': [201],",
          "  'Order Claimed': [201],",
          "  'Reject Future Friday Donation': [422],",
          "  'Reject Future Saturday Gold Buy': [422],",
          "  'Turn Ended': [201],",
          "  'Create Events Batch': [200],",
          "  'Get Events By Session': [200],",
          "  'Recompute Session Analytics': [200],",
          "  'Get Session Analytics': [200],",
          "  'Get Transactions': [200],",
          "  'Get Gameplay Metrics': [200],",
          "  'Get Ruleset Analytics Summary': [200],",
          "  'Get Observability Summary': [200],",
          "  'Get Security Audit Logs': [200],",
          "  'Get Prometheus Metrics': [200],",
          "  'Health Live': [200],",
          "  'Health Ready': [200]",
          "};",
          "const current = pm.info.requestName;",
          "const expected = expectedByRequest[current];",
          "if (expected) {",
          "  pm.test(`${current} status is expected`, function () {",
          "    pm.expect(expected).to.include(pm.response.code);",
          "  });",
          "}",
          "const setVar = (key, value) => {",
          "  pm.collectionVariables.set(key, value);",
          "  pm.environment.set(key, value);",
          "};",
          "const tryJson = () => {",
          "  try { return pm.response.json(); } catch (e) { return null; }",
          "};",
          "const findUuid = (text) => {",
          "  if (!text) return null;",
          "  const m = String(text).match(/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/);",
          "  return m ? m[0] : null;",
          "};",
          "const pickId = (obj, keys) => {",
          "  if (!obj || typeof obj !== 'object') return null;",
          "  for (const key of keys) {",
          "    if (obj[key]) return obj[key];",
          "  }",
          "  if (obj.data && typeof obj.data === 'object') {",
          "    for (const key of keys) {",
          "      if (obj.data[key]) return obj.data[key];",
          "    }",
          "  }",
          "  return null;",
          "};",
          "if (current === 'Login' && pm.response.code === 200) {",
          "  const data = tryJson();",
          "  if (data && data.access_token) setVar('accessToken', data.access_token);",
          "  pm.test('Login returns access token', function () {",
          "    pm.expect(pm.collectionVariables.get('accessToken')).to.be.a('string').and.not.empty;",
          "  });",
          "}",
          "if ((current === 'Create Ruleset PEMULA' || current === 'Update Ruleset PEMULA') && [200, 201].includes(pm.response.code)) {",
          "  const data = tryJson();",
          "  const rulesetId = pickId(data, ['ruleset_id', 'rulesetId', 'id']) || findUuid(pm.response.text());",
          "  const rulesetVersionId = pickId(data, ['ruleset_version_id', 'rulesetVersionId']);",
          "  if (rulesetId) setVar('rulesetId', rulesetId);",
          "  if (rulesetVersionId) setVar('rulesetVersionId', rulesetVersionId);",
          "  if (data && data.version) setVar('rulesetVersionNumber', String(data.version));",
          "}",
          "if (current === 'Create Ruleset MAHIR' && pm.response.code === 201) {",
          "  const data = tryJson();",
          "  const rulesetId = pickId(data, ['ruleset_id', 'rulesetId', 'id']) || findUuid(pm.response.text());",
          "  const rulesetVersionId = pickId(data, ['ruleset_version_id', 'rulesetVersionId']);",
          "  if (rulesetId) setVar('mahirRulesetId', rulesetId);",
          "  if (rulesetVersionId) setVar('mahirRulesetVersionId', rulesetVersionId);",
          "  if (data && data.version) setVar('mahirRulesetVersionNumber', String(data.version));",
          "}",
          "if (current === 'Activate Ruleset Version' && pm.response.code === 200) {",
          "  const data = tryJson();",
          "  const rulesetVersionId = pickId(data, ['ruleset_version_id', 'rulesetVersionId']);",
          "  if (rulesetVersionId) setVar('rulesetVersionId', rulesetVersionId);",
          "  if (data && data.version) setVar('rulesetVersionNumber', String(data.version));",
          "}",
          "if (current === 'Create Session' && pm.response.code === 201) {",
          "  const data = tryJson();",
          "  const sessionId = pickId(data, ['session_id', 'sessionId', 'id']) || findUuid(pm.response.text());",
          "  const rulesetVersionId = pickId(data, ['ruleset_version_id', 'rulesetVersionId']);",
          "  if (sessionId) setVar('sessionId', sessionId);",
          "  if (rulesetVersionId) setVar('rulesetVersionId', rulesetVersionId);",
          "}",
          "if (current === 'Create Player A' && [200, 201, 409].includes(pm.response.code)) {",
          "  const data = tryJson();",
          "  const userId = pickId(data, ['user_id', 'userId', 'id']) || findUuid(pm.response.text());",
          "  if (userId) setVar('playerUserId', userId);",
          "}",
          "if (current === 'Create Player B' && [200, 201, 409].includes(pm.response.code)) {",
          "  const data = tryJson();",
          "  const userId = pickId(data, ['user_id', 'userId', 'id']) || findUuid(pm.response.text());",
          "  if (userId) setVar('secondPlayerUserId', userId);",
          "}",
          "if (current === 'Add Player A To Session' && pm.response.code === 200) {",
          "  const data = tryJson();",
          "  const userId = pickId(data, ['user_id', 'userId', 'id']) || findUuid(pm.response.text());",
          "  if (userId) setVar('playerUserId', userId);",
          "}",
          "if (current === 'Add Player B To Session' && pm.response.code === 200) {",
          "  const data = tryJson();",
          "  const userId = pickId(data, ['user_id', 'userId', 'id']) || findUuid(pm.response.text());",
          "  if (userId) setVar('secondPlayerUserId', userId);",
          "}",
          "if (current === 'Get Session State' && pm.response.code === 200) {",
          "  const data = tryJson();",
          "  const firstPlayer = data && Array.isArray(data.players) ? data.players.find(player => player.player_order_no === 1) : null;",
          "  const nextPlayer = data && Array.isArray(data.players) ? data.players.find(player => player.player_order_no === 2) : null;",
          "  const nextSequence = data && Number(data.next_sequence_number);",
          "  if (firstPlayer && firstPlayer.user_id) setVar('activePlayerUserId', firstPlayer.user_id);",
          "  if (nextPlayer && nextPlayer.user_id) setVar('nextPlayerUserId', nextPlayer.user_id);",
          "  if (Number.isInteger(nextSequence)) {",
          "    for (let offset = 0; offset <= 8; offset += 1) setVar(`sequence${offset}`, String(nextSequence + offset));",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Verify Public Instructor Registration Is Rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{deniedInstructorUsername}}\",\"password\":\"{{deniedInstructorPassword}}\",\"role\":\"INSTRUCTOR\",\"display_name\":\"Instructor Ditolak\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{authUsername}}\",\"password\":\"{{authPassword}}\"}"
            }
          }
        }
      ]
    },
