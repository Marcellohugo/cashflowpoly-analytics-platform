@* Fungsi file: Merender tampilan Razor untuk bagian Sessions/_SessionJourneyScript.cshtml beserta interaksi presentasinya. *@
@model Cashflowpoly.Ui.Models.SessionDetailViewModel
@using System.Text.Json

<script>
    (() => {
        const filterEl = document.getElementById("session-journey-filter");
        const feedEl = document.getElementById("session-journey-feed");
        const errorEl = document.getElementById("session-journey-error");
        const syncedEl = document.getElementById("session-journey-synced");
        const insightTotalEl = document.getElementById("session-journey-insight-total");
        const insightPlayersEl = document.getElementById("session-journey-insight-players");
        const insightDayTurnEl = document.getElementById("session-journey-insight-day-turn");
        const insightPlayerEl = document.getElementById("session-journey-insight-player");
        const insightActionEl = document.getElementById("session-journey-insight-action");

        if (!filterEl || !feedEl || !errorEl || !syncedEl) {
            return;
        }

        const timelineUrl = "@Url.Action("Timeline", "Sessions", new { sessionId = Model.SessionId })";
        const activeLanguage = @Html.Raw(JsonSerializer.Serialize(UiText.NormalizeLanguage(Context.Session.GetString(AuthConstants.SessionLanguageKey))));
        const browserLocale = activeLanguage === "en" ? "en-US" : "id-ID";
        const emptyMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.journey.no_events")));
        const playerEmptyMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_player_empty")));
        const filteredEmptyMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_filtered_empty")));
        const realtimeStatusTemplate = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.journey.realtime_status")));
        const realtimeNetworkMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.journey.realtime_network")));
        const activityFallbackLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.activity_default")));
        const allPlayersLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_filter_all")));
        const playerFallbackLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.actor.player")));
        const dayLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.day_label")));
        const turnLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.turn_label")));
        const seqLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_seq")));
        const playerLookupRaw = @Html.Raw(JsonSerializer.Serialize(Model.PlayerDisplayNames));
        const initialTimelineRaw = @Html.Raw(JsonSerializer.Serialize(Model.Timeline));
        const pollIntervalMs = 10000;

        const playerLookup = Object.fromEntries(
            Object.entries(playerLookupRaw ?? {}).map(([key, value]) => [String(key).toLowerCase(), value])
        );
        let timeline = [];
        let pollingTimerId = null;
        let lastSequence = 0;
        let selectedPlayerKey = "all";

        const hasOwn = (obj, key) => Object.prototype.hasOwnProperty.call(obj, key);
        const toNumber = (value, fallback = 0) => {
            const numericValue = Number(value);
            return Number.isFinite(numericValue) ? numericValue : fallback;
        };
        const displayDayNumber = (dayIndex) => Math.max(1, toNumber(dayIndex, 1));
        const readValue = (obj, camelKey, pascalKey) => {
            if (!obj || typeof obj !== "object") {
                return undefined;
            }

            if (hasOwn(obj, camelKey)) {
                return obj[camelKey];
            }

            if (hasOwn(obj, pascalKey)) {
                return obj[pascalKey];
            }

            return undefined;
        };
        const escapeHtml = (text) =>
            String(text ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll("\"", "&quot;")
                .replaceAll("'", "&#39;");
        const actorBucket = (actorType) => {
            const normalized = String(actorType ?? "").toUpperCase();
            return normalized === "PLAYER" || normalized === "SYSTEM" || normalized === "INSTRUCTOR"
                ? normalized
                : "OTHER";
        };
        const flowBucket = (actionType) => {
            const normalized = String(actionType ?? "").toLowerCase();
            if (normalized.startsWith("setup.")) return "setup";
            if (normalized.startsWith("day.")) return "day";
            if (normalized.startsWith("risk.")) return "risk";
            if (normalized.startsWith("loan.")) return "loan";
            if (normalized.startsWith("saving.")) return "saving";
            if (normalized.startsWith("mission.")) return "mission";
            if (normalized.includes("order")) return "order";
            return "generic";
        };
        const actorLabel = (item) => {
            if (item.playerDisplayName) {
                return item.playerDisplayName;
            }

            const lookupName = playerLookup[String(item.playerId ?? "").toLowerCase()];
            return lookupName || playerFallbackLabel;
        };
        const actionLabel = (item) => item.flowLabel || item.actionType || activityFallbackLabel;
        const normalizeTimeline = (rawTimeline) => {
            if (!Array.isArray(rawTimeline)) {
                return [];
            }

            return rawTimeline
                .map((item) => {
                    const sequenceNumber = toNumber(readValue(item, "sequenceNumber", "SequenceNumber"), 0);
                    return {
                        timestamp: readValue(item, "timestamp", "Timestamp"),
                        sequenceNumber,
                        dayIndex: toNumber(readValue(item, "dayIndex", "DayIndex"), 0),
                        weekday: String(readValue(item, "weekday", "Weekday") ?? ""),
                        turnNumber: Math.max(1, toNumber(readValue(item, "turnNumber", "TurnNumber"), 1)),
                        actorType: String(readValue(item, "actorType", "ActorType") ?? ""),
                        playerId: readValue(item, "playerId", "PlayerId"),
                        playerDisplayName: readValue(item, "playerDisplayName", "PlayerDisplayName"),
                        actionType: String(readValue(item, "actionType", "ActionType") ?? ""),
                        flowLabel: String(readValue(item, "flowLabel", "FlowLabel") ?? ""),
                        flowDescription: String(readValue(item, "flowDescription", "FlowDescription") ?? "")
                    };
                })
                .filter((item) => item.sequenceNumber > 0)
                .sort((a, b) => {
                    if (a.sequenceNumber !== b.sequenceNumber) {
                        return a.sequenceNumber - b.sequenceNumber;
                    }

                    return String(a.timestamp ?? "").localeCompare(String(b.timestamp ?? ""));
                });
        };
        const resolvePlayerKey = (item) => {
            const playerId = String(item.playerId ?? "").trim().toLowerCase();
            if (playerId) {
                return playerId;
            }

            const normalizedLabel = actorLabel(item).trim().toLowerCase();
            return normalizedLabel ? `name:${normalizedLabel}` : "player";
        };
        const formatDateTime = (rawValue) => {
            const dt = new Date(rawValue);
            if (Number.isNaN(dt.getTime())) {
                return "-";
            }

            return dt.toLocaleString(browserLocale, {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit"
            });
        };
        const isVisiblePlayerEvent = (item) =>
            actorBucket(item.actorType) === "PLAYER" &&
            item.actionType !== "turn.action.used";
        const getPlayerTimeline = () => timeline.filter(isVisiblePlayerEvent);
        const buildPlayerOptions = (playerTimeline) => {
            const seen = new Set();
            const options = [];

            playerTimeline.forEach((item) => {
                const key = resolvePlayerKey(item);
                if (seen.has(key)) {
                    return;
                }

                seen.add(key);
                options.push({
                    key,
                    label: actorLabel(item)
                });
            });

            return options;
        };
        const getVisibleTimeline = (playerTimeline) => {
            if (selectedPlayerKey === "all") {
                return playerTimeline;
            }

            return playerTimeline.filter((item) => resolvePlayerKey(item) === selectedPlayerKey);
        };
        const bindFilterInteractions = () => {
            filterEl.querySelectorAll("[data-player-key]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextPlayerKey = button.getAttribute("data-player-key") || "all";
                    if (nextPlayerKey === selectedPlayerKey) {
                        return;
                    }

                    selectedPlayerKey = nextPlayerKey;
                    renderAll();
                });
            });
        };
        const setError = (message) => {
            if (!message) {
                errorEl.textContent = "";
                errorEl.classList.add("hidden");
                return;
            }

            errorEl.textContent = message;
            errorEl.classList.remove("hidden");
        };
        const mergeTimeline = (incoming) => {
            if (!Array.isArray(incoming) || incoming.length === 0) {
                return;
            }

            const map = new Map(timeline.map((item) => [item.sequenceNumber, item]));
            incoming.forEach((item) => {
                map.set(item.sequenceNumber, item);
            });
            timeline = Array.from(map.values()).sort((a, b) => a.sequenceNumber - b.sequenceNumber);
        };
        const renderFilters = (playerOptions) => {
            if (selectedPlayerKey !== "all" && !playerOptions.some((option) => option.key === selectedPlayerKey)) {
                selectedPlayerKey = "all";
            }

            const buttons = [
                `
                    <button type="button"
                            class="session-journey-filter-btn ${selectedPlayerKey === "all" ? "is-active" : ""}"
                            data-player-key="all">${escapeHtml(allPlayersLabel)}</button>
                `
            ];

            playerOptions.forEach((option) => {
                buttons.push(`
                    <button type="button"
                            class="session-journey-filter-btn ${selectedPlayerKey === option.key ? "is-active" : ""}"
                            data-player-key="${escapeHtml(option.key)}">${escapeHtml(option.label)}</button>
                `);
            });

            filterEl.innerHTML = buttons.join("");
            bindFilterInteractions();
        };
        const renderJourneyFeed = (playerTimeline, visibleTimeline) => {
            if (playerTimeline.length === 0) {
                feedEl.innerHTML = `<li class="session-journey-empty">${escapeHtml(timeline.length === 0 ? emptyMessage : playerEmptyMessage)}</li>`;
                return;
            }

            if (visibleTimeline.length === 0) {
                feedEl.innerHTML = `<li class="session-journey-empty">${escapeHtml(filteredEmptyMessage)}</li>`;
                return;
            }

            feedEl.innerHTML = visibleTimeline.map((item, index) => {
                const displaySequenceNumber = index + 1;
                const dayTurnLabel = `${dayLabel} ${displayDayNumber(item.dayIndex)} | ${turnLabel} ${item.turnNumber}`;
                const detailLabel = item.flowDescription || activityFallbackLabel;
                return `
                    <li class="session-journey-feed-item"
                        data-player-key="${escapeHtml(resolvePlayerKey(item))}"
                        data-flow="${escapeHtml(flowBucket(item.actionType))}">
                        <div class="session-journey-feed-head">
                            <div class="session-journey-feed-player">
                                <p class="session-journey-feed-player-name">${escapeHtml(actorLabel(item))}</p>
                                <div class="session-journey-feed-meta">
                                    <span class="session-journey-feed-seq">${escapeHtml(seqLabel)} ${displaySequenceNumber}</span>
                                    <span class="session-journey-feed-dayturn">${escapeHtml(dayTurnLabel)}</span>
                                </div>
                            </div>
                            <span class="session-journey-feed-time">${escapeHtml(formatDateTime(item.timestamp))}</span>
                        </div>
                        <p class="session-journey-feed-title">${escapeHtml(actionLabel(item))}</p>
                        <p class="session-journey-feed-subtitle">${escapeHtml(item.weekday || "-")}</p>
                        <p class="session-journey-feed-detail">${escapeHtml(detailLabel)}</p>
                    </li>`;
            }).join("");
        };
        const renderJourneyInsights = (visibleTimeline) => {
            if (!insightTotalEl || !insightPlayersEl || !insightDayTurnEl || !insightPlayerEl || !insightActionEl) {
                return;
            }

            if (visibleTimeline.length === 0) {
                insightTotalEl.textContent = "0";
                insightPlayersEl.textContent = "0";
                insightDayTurnEl.textContent = "-";
                insightPlayerEl.textContent = "-";
                insightActionEl.textContent = "-";
                return;
            }

            const latestItem = visibleTimeline[visibleTimeline.length - 1];
            const activePlayers = new Set(visibleTimeline.map((item) => resolvePlayerKey(item)));

            insightTotalEl.textContent = `${visibleTimeline.length}`;
            insightPlayersEl.textContent = `${activePlayers.size}`;
            insightDayTurnEl.textContent = `${dayLabel} ${displayDayNumber(latestItem.dayIndex)} | ${turnLabel} ${latestItem.turnNumber}`;
            insightPlayerEl.textContent = actorLabel(latestItem);
            insightActionEl.textContent = actionLabel(latestItem);
        };
        const renderAll = () => {
            const playerTimeline = getPlayerTimeline();
            const playerOptions = buildPlayerOptions(playerTimeline);
            const visibleTimeline = getVisibleTimeline(playerTimeline);

            renderFilters(playerOptions);
            renderJourneyInsights(visibleTimeline);
            renderJourneyFeed(playerTimeline, visibleTimeline);
            lastSequence = timeline.length > 0
                ? Math.max(...timeline.map((item) => item.sequenceNumber))
                : 0;
        };
        const syncTimeline = async () => {
            try {
                const response = await fetch(`${timelineUrl}?fromSeq=${encodeURIComponent(lastSequence)}&limit=200`, {
                    method: "GET",
                    headers: { "Accept": "application/json" }
                });

                if (!response.ok) {
                    setError(realtimeStatusTemplate.replace("{status}", `${response.status}`));
                    return;
                }

                const data = await response.json();
                const incomingTimeline = normalizeTimeline(data?.timeline);
                mergeTimeline(incomingTimeline);
                renderAll();
                setError(data?.errorMessage || "");
                syncedEl.textContent = formatDateTime(data?.lastSyncedAt ?? new Date().toISOString());
            } catch {
                setError(realtimeNetworkMessage);
            }
        };
        const startPolling = () => {
            if (pollingTimerId !== null) {
                return;
            }

            syncTimeline();
            pollingTimerId = setInterval(syncTimeline, pollIntervalMs);
        };
        const stopPolling = () => {
            if (pollingTimerId === null) {
                return;
            }

            clearInterval(pollingTimerId);
            pollingTimerId = null;
        };
        const handleVisibility = () => {
            if (document.visibilityState === "visible") {
                startPolling();
                return;
            }

            stopPolling();
        };

        timeline = normalizeTimeline(initialTimelineRaw);
        renderAll();
        document.addEventListener("visibilitychange", handleVisibility);
        handleVisibility();
    })();
</script>
