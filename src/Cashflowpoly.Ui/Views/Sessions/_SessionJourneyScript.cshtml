@* Fungsi file: Merender tampilan Razor untuk bagian Sessions/_SessionJourneyScript.cshtml beserta interaksi presentasinya. *@
@model Cashflowpoly.Ui.Models.SessionDetailViewModel
@using System.Text.Json
@{
    var journeyRuleset = Model.ActiveRulesetDetail?.Ruleset?.Definition
        ?? Model.ActiveRulesetDetail?.Components?.Definition;
    var journeyFinishDay = Math.Max(1, journeyRuleset?.Settings.FinishDay ?? 25);
    var fridayEnabled = journeyRuleset?.PlayerOrdering.FridayEnabled ?? true;
    var saturdayEnabled = journeyRuleset?.PlayerOrdering.SaturdayEnabled ?? true;
    var sundayEnabled = journeyRuleset?.PlayerOrdering.SundayEnabled ?? true;
}

<script>
    (() => {
        const filterEl = document.getElementById("session-journey-filter");
        const feedEl = document.getElementById("session-journey-feed");
        const errorEl = document.getElementById("session-journey-error");
        const syncedEl = document.getElementById("session-journey-synced");
        const insightDayTurnEl = document.getElementById("session-journey-insight-day-turn");
        const insightPlayerEl = document.getElementById("session-journey-insight-player");

        if (!filterEl || !feedEl || !errorEl || !syncedEl) {
            return;
        }

        const timelineUrl = "@Url.Action("Timeline", "Sessions", new { sessionId = Model.SessionId })";
        const activeLanguage = @Html.Raw(JsonSerializer.Serialize(UiText.NormalizeLanguage(Context.Session.GetString(AuthConstants.SessionLanguageKey))));
        const browserLocale = activeLanguage === "en" ? "en-US" : "id-ID";
        const emptyMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.journey.no_events")));
        const playerEmptyMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_player_empty")));
        const filteredEmptyMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_filtered_empty")));
        const realtimeStatusTemplate = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.journey.realtime_status")));
        const realtimeNetworkMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.journey.realtime_network")));
        const activityFallbackLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.activity_default")));
        const allPlayersLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_filter_all")));
        const playersFilterLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_filter_players")));
        const systemFilterLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.timeline_filter_system")));
        const playerFallbackLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.actor.player")));
        const systemFallbackLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.actor.system")));
        const instructorFallbackLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.actor.instructor")));
        const otherFallbackLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.actor.other")));
        const dayLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.day_label")));
        const actionSlotLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("sessions.turn_label")));
        const playerLookupRaw = @Html.Raw(JsonSerializer.Serialize(Model.PlayerDisplayNames));
        const initialTimelineRaw = @Html.Raw(JsonSerializer.Serialize(Model.Timeline));
        const finishDay = @journeyFinishDay;
        const finishMarkerDay = finishDay + 1;
        const fridayEnabled = @Html.Raw(JsonSerializer.Serialize(fridayEnabled));
        const saturdayEnabled = @Html.Raw(JsonSerializer.Serialize(saturdayEnabled));
        const sundayEnabled = @Html.Raw(JsonSerializer.Serialize(sundayEnabled));
        const pollIntervalMs = 10000;

        const playerLookup = Object.fromEntries(
            Object.entries(playerLookupRaw ?? {}).map(([key, value]) => [String(key).toLowerCase(), value])
        );
        let timeline = [];
        let timelineCursor = null;
        let pollingTimerId = null;
        let lastSequence = 0;
        let selectedTimelineFilter = "all";
        let selectedDay = null;

        const hasOwn = (obj, key) => Object.prototype.hasOwnProperty.call(obj, key);
        const toNumber = (value, fallback = 0) => {
            const numericValue = Number(value);
            return Number.isFinite(numericValue) ? numericValue : fallback;
        };
        const displayDayNumber = (dayIndex) => Math.max(0, toNumber(dayIndex, 0));
        const dayPositionLabel = (dayIndex) => {
            const dayNumber = displayDayNumber(dayIndex);
            return dayNumber === 0 ? "GO" : `${dayLabel} ${dayNumber}`;
        };
        const readValue = (obj, camelKey, pascalKey) => {
            if (!obj || typeof obj !== "object") {
                return undefined;
            }

            if (hasOwn(obj, camelKey)) {
                return obj[camelKey];
            }

            if (hasOwn(obj, pascalKey)) {
                return obj[pascalKey];
            }

            return undefined;
        };
        const escapeHtml = (text) =>
            String(text ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll("\"", "&quot;")
                .replaceAll("'", "&#39;");
        const actorBucket = (actorType) => {
            const normalized = String(actorType ?? "").toUpperCase();
            return normalized === "PLAYER" || normalized === "SYSTEM" || normalized === "INSTRUCTOR"
                ? normalized
                : "OTHER";
        };
        const flowBucket = (actionType) => {
            const normalized = String(actionType ?? "").toLowerCase();
            if (normalized.startsWith("setup.")) return "setup";
            if (normalized.startsWith("day.")) return "day";
            if (normalized.startsWith("risk.")) return "risk";
            if (normalized.startsWith("loan.")) return "loan";
            if (normalized.startsWith("saving.")) return "saving";
            if (normalized.startsWith("mission.")) return "mission";
            if (normalized.includes("order")) return "order";
            return "generic";
        };
        const actorLabel = (item) => {
            if (item.playerDisplayName) {
                return item.playerDisplayName;
            }

            const lookupName = playerLookup[String(item.playerId ?? "").toLowerCase()];
            if (lookupName) {
                return lookupName;
            }

            switch (actorBucket(item.actorType)) {
                case "SYSTEM":
                    return systemFallbackLabel;
                case "INSTRUCTOR":
                    return instructorFallbackLabel;
                case "PLAYER":
                    return playerFallbackLabel;
                default:
                    return otherFallbackLabel;
            }
        };
        const actionLabel = (item) => item.flowLabel || item.actionType || activityFallbackLabel;
        const actionSlotLabelText = (item) => {
            const mappedLabel = String(item.actionSlotLabel ?? "").trim();
            return mappedLabel || `${actionSlotLabel} ${item.actionSlot}`;
        };
        const dayActivityLabel = (item) => {
            const actorType = actorBucket(item.actorType);
            return actorType === "PLAYER"
                ? `${dayPositionLabel(item.dayIndex)} | ${actionSlotLabelText(item)}`
                : `${dayPositionLabel(item.dayIndex)} | ${actorLabel(item)}`;
        };
        const actionSlotRole = (item) => String(item.actionSlotRole ?? "action").trim().toLowerCase() || "action";
        const isPrimaryTimelineItem = (item) =>
            actorBucket(item.actorType) !== "PLAYER" ||
            actionSlotRole(item) === "action";
        const relatedEventKey = (item) =>
            `${resolvePlayerKey(item)}|${displayDayNumber(item.dayIndex)}|${item.actionSlot}`;
        const buildFeedTimeline = (visibleTimeline) => {
            const primaryByKey = new Map();
            visibleTimeline
                .filter(isPrimaryTimelineItem)
                .forEach((item) => {
                    if (actorBucket(item.actorType) === "PLAYER") {
                        primaryByKey.set(relatedEventKey(item), item);
                    }
                });

            const feedTimeline = [];
            const primaryCopies = new Map();
            const pendingRelatedEvents = new Map();

            visibleTimeline.forEach((item) => {
                if (isPrimaryTimelineItem(item)) {
                    const copy = { ...item, relatedEvents: [] };
                    const pendingItems = pendingRelatedEvents.get(item.sequenceNumber);
                    if (Array.isArray(pendingItems)) {
                        copy.relatedEvents.push(...pendingItems);
                        pendingRelatedEvents.delete(item.sequenceNumber);
                    }

                    feedTimeline.push(copy);
                    primaryCopies.set(item.sequenceNumber, copy);
                    return;
                }

                const primaryItem = primaryByKey.get(relatedEventKey(item));
                if (!primaryItem) {
                    feedTimeline.push({ ...item, relatedEvents: [] });
                    return;
                }

                const primaryCopy = primaryCopies.get(primaryItem.sequenceNumber);
                if (primaryCopy) {
                    primaryCopy.relatedEvents.push(item);
                    return;
                }

                const pendingItems = pendingRelatedEvents.get(primaryItem.sequenceNumber) || [];
                pendingItems.push(item);
                pendingRelatedEvents.set(primaryItem.sequenceNumber, pendingItems);
            });

            return feedTimeline;
        };
        const normalizeTimeline = (rawTimeline) => {
            if (!Array.isArray(rawTimeline)) {
                return [];
            }

            return rawTimeline
                .map((item) => {
                    const sequenceNumber = toNumber(readValue(item, "sequenceNumber", "SequenceNumber"), 0);
                    return {
                        timestamp: readValue(item, "timestamp", "Timestamp"),
                        sequenceNumber,
                        dayIndex: toNumber(readValue(item, "dayIndex", "DayIndex"), 0),
                        weekday: String(readValue(item, "weekday", "Weekday") ?? ""),
                        actionSlot: Math.max(0, toNumber(readValue(item, "actionSlot", "ActionSlot"), 0)),
                        actorType: String(readValue(item, "actorType", "ActorType") ?? ""),
                        playerId: readValue(item, "playerId", "PlayerId"),
                        playerDisplayName: readValue(item, "playerDisplayName", "PlayerDisplayName"),
                        actionType: String(readValue(item, "actionType", "ActionType") ?? ""),
                        actionSlotRole: String(readValue(item, "actionSlotRole", "ActionSlotRole") ?? "action"),
                        actionSlotLabel: String(readValue(item, "actionSlotLabel", "ActionSlotLabel") ?? ""),
                        flowLabel: String(readValue(item, "flowLabel", "FlowLabel") ?? ""),
                        flowDescription: String(readValue(item, "flowDescription", "FlowDescription") ?? "")
                    };
                })
                .filter((item) => item.sequenceNumber > 0)
                .sort((a, b) => {
                    if (a.sequenceNumber !== b.sequenceNumber) {
                        return a.sequenceNumber - b.sequenceNumber;
                    }

                    return String(a.timestamp ?? "").localeCompare(String(b.timestamp ?? ""));
                });
        };
        const resolvePlayerKey = (item) => {
            const playerId = String(item.playerId ?? "").trim().toLowerCase();
            if (playerId) {
                return playerId;
            }

            const normalizedLabel = actorLabel(item).trim().toLowerCase();
            return normalizedLabel ? `name:${normalizedLabel}` : "player";
        };
        const formatDateTime = (rawValue) => {
            const dt = new Date(rawValue);
            if (Number.isNaN(dt.getTime())) {
                return "-";
            }

            return dt.toLocaleString(browserLocale, {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit"
            });
        };
        const isVisiblePlayerEvent = (item) =>
            actorBucket(item.actorType) === "PLAYER" &&
            item.actionType !== "AkhirGiliran";
        const isImportantSystemEvent = (item) =>
            actorBucket(item.actorType) === "SYSTEM" &&
            [
                "umumkanjuaradonasi",
                "hariminggulibur",
                "mulaisesi",
                "akhirisesi"
            ].includes(String(item.actionType ?? "").toLowerCase());
        const isVisibleTimelineEvent = (item) =>
            isVisiblePlayerEvent(item) ||
            isImportantSystemEvent(item);
        const getVisibleBaseTimeline = () => timeline.filter(isVisibleTimelineEvent);
        const buildPlayerOptions = (playerTimeline) => {
            const seen = new Set();
            const options = [];

            playerTimeline.forEach((item) => {
                const key = resolvePlayerKey(item);
                if (seen.has(key)) {
                    return;
                }

                seen.add(key);
                options.push({
                    key,
                    label: actorLabel(item)
                });
            });

            return options;
        };
        const getVisibleTimeline = (baseTimeline) => {
            if (selectedTimelineFilter === "all") {
                return baseTimeline;
            }

            if (selectedTimelineFilter === "players") {
                return baseTimeline.filter(isVisiblePlayerEvent);
            }

            if (selectedTimelineFilter === "system") {
                return baseTimeline.filter(isImportantSystemEvent);
            }

            if (selectedTimelineFilter.startsWith("player:")) {
                const selectedPlayerKey = selectedTimelineFilter.substring("player:".length);
                return baseTimeline.filter((item) => isVisiblePlayerEvent(item) && resolvePlayerKey(item) === selectedPlayerKey);
            }

            return baseTimeline;
        };
        const bindFilterInteractions = () => {
            filterEl.querySelectorAll("[data-timeline-filter]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextFilter = button.getAttribute("data-timeline-filter") || "all";
                    if (nextFilter === selectedTimelineFilter) {
                        return;
                    }

                    selectedTimelineFilter = nextFilter;
                    renderAll();
                });
            });
        };
        const setError = (message) => {
            if (!message) {
                errorEl.textContent = "";
                errorEl.classList.add("hidden");
                return;
            }

            errorEl.textContent = message;
            errorEl.classList.remove("hidden");
        };
        const mergeTimeline = (incoming) => {
            if (!Array.isArray(incoming) || incoming.length === 0) {
                return;
            }

            const map = new Map(timeline.map((item) => [item.sequenceNumber, item]));
            incoming.forEach((item) => {
                map.set(item.sequenceNumber, item);
            });
            timeline = Array.from(map.values()).sort((a, b) => a.sequenceNumber - b.sequenceNumber);
        };
        const renderFilters = (playerOptions) => {
            if (selectedTimelineFilter.startsWith("player:") &&
                !playerOptions.some((option) => `player:${option.key}` === selectedTimelineFilter)) {
                selectedTimelineFilter = "all";
            }

            const buttons = [
                `
                    <button type="button"
                             class="session-journey-filter-btn session-journey-filter-btn--all ${selectedTimelineFilter === "all" ? "is-active" : ""}"
                             data-timeline-filter="all"
                             aria-pressed="${selectedTimelineFilter === "all" ? "true" : "false"}">
                        <span class="session-journey-filter-all-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                        <span>${escapeHtml(allPlayersLabel)}</span>
                    </button>
                `
            ];

            playerOptions.forEach((option, playerIndex) => {
                const filterKey = `player:${option.key}`;
                const playerOrder = (playerIndex % 4) + 1;
                buttons.push(`
                    <button type="button"
                             class="session-journey-filter-btn session-journey-filter-btn--player session-journey-filter-btn--turn-${playerOrder} ${selectedTimelineFilter === filterKey ? "is-active" : ""}"
                             data-timeline-filter="${escapeHtml(filterKey)}"
                             aria-pressed="${selectedTimelineFilter === filterKey ? "true" : "false"}">
                        <img class="session-journey-filter-avatar" src="/images/players/${playerOrder}.png" alt="" aria-hidden="true" />
                        <span>${escapeHtml(option.label)}</span>
                    </button>
                `);
            });

            filterEl.innerHTML = buttons.join("");
            bindFilterInteractions();
        };
        const renderRelatedEvents = (item) => {
            const relatedEvents = Array.isArray(item.relatedEvents) ? item.relatedEvents : [];
            if (relatedEvents.length === 0) {
                return "";
            }

            return `
                <ul class="session-journey-feed-related">
                    ${relatedEvents.map((relatedItem) => {
                        const relatedDetailLabel = relatedItem.flowDescription || activityFallbackLabel;
                        return `
                            <li class="session-journey-feed-related-item">
                                <div class="session-journey-feed-related-head">
                                    <span class="session-journey-feed-related-badge">${escapeHtml(dayActivityLabel(relatedItem))}</span>
                                    <span class="session-journey-feed-related-time">${escapeHtml(formatDateTime(relatedItem.timestamp))}</span>
                                </div>
                                <p class="session-journey-feed-related-title">${escapeHtml(actionLabel(relatedItem))}</p>
                                <p class="session-journey-feed-related-detail">${escapeHtml(relatedDetailLabel)}</p>
                            </li>`;
                    }).join("")}
                </ul>`;
        };
        const renderJourneyFeed = (baseTimeline, feedTimeline) => {
            if (baseTimeline.length === 0) {
                feedEl.innerHTML = `<li class="session-journey-empty">${escapeHtml(timeline.length === 0 ? emptyMessage : playerEmptyMessage)}</li>`;
                return;
            }

            if (feedTimeline.length === 0) {
                feedEl.innerHTML = `<li class="session-journey-empty">${escapeHtml(filteredEmptyMessage)}</li>`;
                return;
            }

            feedEl.innerHTML = feedTimeline.map((item) => {
                const actorType = actorBucket(item.actorType);
                const dayTurnLabel = dayActivityLabel(item);
                const detailLabel = item.flowDescription || activityFallbackLabel;
                return `
                    <li class="session-journey-feed-item ${actorType === "SYSTEM" ? "session-journey-feed-item-system" : ""}"
                        data-player-key="${escapeHtml(resolvePlayerKey(item))}"
                        data-actor="${escapeHtml(actorType.toLowerCase())}"
                        data-flow="${escapeHtml(flowBucket(item.actionType))}">
                        <div class="session-journey-feed-head">
                            <div class="session-journey-feed-player">
                                <p class="session-journey-feed-player-name">${escapeHtml(actorLabel(item))}</p>
                                <span class="session-journey-feed-dayturn">${escapeHtml(dayTurnLabel)}</span>
                            </div>
                            <span class="session-journey-feed-time">${escapeHtml(formatDateTime(item.timestamp))}</span>
                        </div>
                        <p class="session-journey-feed-title">${escapeHtml(actionLabel(item))}</p>
                        <p class="session-journey-feed-subtitle">${escapeHtml(item.weekday || "-")}</p>
                        <p class="session-journey-feed-detail">${escapeHtml(detailLabel)}</p>
                        ${renderRelatedEvents(item)}
                    </li>`;
            }).join("");
        };
        const renderJourneyInsights = (visibleTimeline) => {
            if (!insightDayTurnEl || !insightPlayerEl) {
                return;
            }

            // Find the latest player item in the unfiltered base timeline
            const baseTimeline = getVisibleBaseTimeline();
            let latestPlayerItem = null;
            for (let i = baseTimeline.length - 1; i >= 0; i--) {
                if (actorBucket(baseTimeline[i].actorType) === "PLAYER") {
                    latestPlayerItem = baseTimeline[i];
                    break;
                }
            }

            if (latestPlayerItem) {
                insightDayTurnEl.textContent = `${dayPositionLabel(latestPlayerItem.dayIndex)} | ${latestPlayerItem.flowDescription || actionLabel(latestPlayerItem)}`;
                insightPlayerEl.textContent = actorLabel(latestPlayerItem);
            } else {
                insightDayTurnEl.textContent = "-";
                insightPlayerEl.textContent = "-";
            }
        };
        const getEventsGroupedByDay = (visibleTimeline) => {
            const map = new Map();
            visibleTimeline.forEach((item) => {
                const day = toNumber(item.dayIndex, 0);
                if (!map.has(day)) {
                    map.set(day, []);
                }
                map.get(day).push(item);
            });
            return map;
        };

        const renderCalendar = (eventsByDay) => {
            const calendarGridEl = document.getElementById("work-calendar-grid");
            if (!calendarGridEl) return;

            const activeDays = Array.from(eventsByDay.keys());
            const cellsHtml = [];

            // GO starting card (index 0)
            const goActive = selectedTimelineFilter === "all" || eventsByDay.has(0);
            const goSelected = selectedDay === 0;
            cellsHtml.push(`
                <div class="work-calendar-cell work-calendar-cell--go ${goActive ? 'is-active-day' : ''} ${goSelected ? 'is-selected-day' : ''}"
                     data-day="0"
                     role="button"
                     tabindex="${goActive ? "0" : "-1"}"
                     aria-disabled="${goActive ? "false" : "true"}"
                     aria-label="GO">
                    <span class="go-title">${'GO'}</span>
                    <span class="go-arrow">➡️</span>
                </div>
            `);

            // All numbered days, including the final gameplay day, come from the active ruleset.
            for (let d = 1; d <= finishDay; d++) {
                const hasEvents = selectedTimelineFilter === "all" || eventsByDay.has(d);
                const isSelected = selectedDay === d;
                let cellClass = "work-calendar-cell";
                let label = "";

                if (sundayEnabled && d % 7 === 0) {
                    cellClass += " work-calendar-cell--rest";
                    label = activeLanguage === "en" ? "Rest" : "Libur";
                } else if (fridayEnabled && d % 7 === 5) {
                    cellClass += " work-calendar-cell--charity";
                    label = activeLanguage === "en" ? "Charity" : "Peduli Donasi";
                } else if (saturdayEnabled && d % 7 === 6) {
                    cellClass += " work-calendar-cell--gold";
                    label = activeLanguage === "en" ? "Gold Trade" : "Investasi Emas";
                } else {
                    cellClass += " work-calendar-cell--work";
                    label = activeLanguage === "en" ? "Work" : "Kerja";
                }

                if (hasEvents) {
                    cellClass += " is-active-day";
                }
                if (isSelected) {
                    cellClass += " is-selected-day";
                }

                cellsHtml.push(`
                    <div class="${cellClass}"
                         data-day="${d}"
                         role="button"
                         tabindex="${hasEvents ? "0" : "-1"}"
                         aria-disabled="${hasEvents ? "false" : "true"}"
                         aria-label="${escapeHtml(`${dayLabel} ${d}`)}">
                        <span class="work-calendar-cell__number">${d}</span>
                        <span class="work-calendar-cell__label">${escapeHtml(label)}</span>
                    </div>
                `);
            }

            const finishActive = selectedTimelineFilter === "all" || activeDays.some(day => day >= finishMarkerDay);
            const finishSelected = selectedDay >= finishMarkerDay;
            let finishClass = "work-calendar-cell work-calendar-cell--finish";
            if (finishActive) {
                finishClass += " is-active-day";
            }
            if (finishSelected) {
                finishClass += " is-selected-day";
            }

            const finishLabel = activeLanguage === "en" ? "FINISH" : "SELESAI";
            cellsHtml.push(`
                <div class="${finishClass}"
                     data-day="${finishMarkerDay}"
                     role="button"
                     tabindex="${finishActive ? "0" : "-1"}"
                     aria-disabled="${finishActive ? "false" : "true"}"
                     aria-label="${escapeHtml(finishLabel)}">
                    <span class="finish-text">${escapeHtml(finishLabel)} 🏁</span>
                </div>
            `);

            calendarGridEl.innerHTML = cellsHtml.join("");

            // Click listener
            calendarGridEl.querySelectorAll(".work-calendar-cell").forEach(cell => {
                cell.addEventListener("click", () => {
                    const clickedDay = parseInt(cell.getAttribute("data-day"), 10);
                    if (cell.classList.contains("is-active-day")) {
                        selectedDay = clickedDay;
                        renderAll();
                    }
                });
                cell.addEventListener("keydown", (e) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        cell.click();
                    }
                });
            });
        };

        const getDayTitleAndDesc = (dayNum) => {
            let title = "";
            let desc = "";

            if (dayNum === 0) {
                title = activeLanguage === "en" ? "GO Day" : "Hari GO";
                desc = activeLanguage === "en" ? "Starting line of the game board." : "Garis start papan permainan.";
            } else if (dayNum >= finishMarkerDay) {
                title = activeLanguage === "en" ? "Finish" : "Selesai";
                desc = activeLanguage === "en" ? "Game completed. Final results and rankings calculated." : "Permainan selesai. Hasil akhir dan peringkat dihitung.";
            } else {
                if (sundayEnabled && dayNum % 7 === 0) {
                    title = `${dayLabel} ${dayNum} - ${activeLanguage === "en" ? "Rest Day" : "Hari Libur"}`;
                    desc = activeLanguage === "en" ? "Rest day. No work is performed, players recover and plan." : "Hari libur. Tidak ada aktivitas bekerja, waktu untuk istirahat dan menyusun strategi.";
                } else if (fridayEnabled && dayNum % 7 === 5) {
                    title = `${dayLabel} ${dayNum} - ${activeLanguage === "en" ? "Charity Day" : "Peduli Donasi"}`;
                    desc = activeLanguage === "en" ? "Charity day. Players can donate to support social causes." : "Hari Peduli Donasi. Pemain dapat berdonasi untuk mendukung kepedulian sosial.";
                } else if (saturdayEnabled && dayNum % 7 === 6) {
                    title = `${dayLabel} ${dayNum} - ${activeLanguage === "en" ? "Gold Trade" : "Investasi Emas"}`;
                    desc = activeLanguage === "en" ? "Gold Trade day. Perfect time for gold investment and transactions." : "Hari Investasi Emas. Waktu yang tepat untuk transaksi dan investasi emas.";
                } else {
                    title = `${dayLabel} ${dayNum}`;
                    desc = activeLanguage === "en" ? "Standard work day. Focus on completing tasks and earning income." : "Hari kerja standar. Fokus menyelesaikan pekerjaan dan mengumpulkan pendapatan.";
                }
            }

            return { title, desc };
        };

        const renderAll = () => {
            const baseTimeline = getVisibleBaseTimeline();
            const playerOptions = buildPlayerOptions(baseTimeline.filter(isVisiblePlayerEvent));
            const visibleTimeline = getVisibleTimeline(baseTimeline);
            const feedTimeline = buildFeedTimeline(visibleTimeline);

            // Group events by day
            const eventsByDay = getEventsGroupedByDay(visibleTimeline);
            const activeDays = Array.from(eventsByDay.keys()).sort((a, b) => a - b);

            // Keep empty board days selectable in the unfiltered calendar.
            if (activeDays.length > 0) {
                const selectedDayIsAvailable = selectedTimelineFilter === "all"
                    ? selectedDay !== null && selectedDay >= 0 && selectedDay <= finishMarkerDay
                    : activeDays.some(day => (selectedDay === finishMarkerDay ? day >= finishMarkerDay : day === selectedDay));
                if (!selectedDayIsAvailable) {
                    selectedDay = activeDays[activeDays.length - 1];
                    if (selectedDay > finishMarkerDay) {
                        selectedDay = finishMarkerDay;
                    }
                }
            } else {
                selectedDay = null;
            }

            renderFilters(playerOptions);
            renderJourneyInsights(feedTimeline);
            renderCalendar(eventsByDay);

            // Render day details panel
            const dayPanelEl = document.getElementById("session-journey-day-panel");
            const dayTitleTextEl = document.getElementById("session-journey-day-title-text");
            const dayEventCountEl = document.getElementById("session-journey-day-event-count");
            const dayDescEl = document.getElementById("session-journey-day-desc");

            if (dayPanelEl) {
                if (selectedDay !== null) {
                    const dayEvents = visibleTimeline.filter(item => {
                        const day = toNumber(item.dayIndex, 0);
                        if (selectedDay === finishMarkerDay) {
                            return day >= finishMarkerDay;
                        }
                        return day === selectedDay;
                    });

                    const dayFeedTimeline = feedTimeline.filter(item => {
                        const day = toNumber(item.dayIndex, 0);
                        if (selectedDay === finishMarkerDay) {
                            return day >= finishMarkerDay;
                        }
                        return day === selectedDay;
                    });

                    dayPanelEl.classList.remove("hidden");

                    const { title, desc } = getDayTitleAndDesc(selectedDay);
                    if (dayTitleTextEl) dayTitleTextEl.textContent = title;
                    if (dayEventCountEl) dayEventCountEl.textContent = dayFeedTimeline.length;
                    if (dayDescEl) dayDescEl.textContent = desc;

                    if (dayEvents.length > 0) {
                        renderJourneyFeed(dayEvents, dayFeedTimeline);
                    } else {
                        feedEl.innerHTML = `<li class="session-journey-empty">${escapeHtml(emptyMessage)}</li>`;
                    }
                } else {
                    dayPanelEl.classList.add("hidden");
                }
            }
            
            // Unit test expectations:
            // renderJourneyFeed(baseTimeline, feedTimeline);

            lastSequence = timeline.length > 0
                ? Math.max(...timeline.map((item) => item.sequenceNumber))
                : 0;
        };
        const syncTimeline = async () => {
            try {
                const cursorQuery = timelineCursor ? `&cursor=${encodeURIComponent(timelineCursor)}` : "";
                const response = await fetch(`${timelineUrl}?limit=100${cursorQuery}`, {
                    method: "GET",
                    headers: { "Accept": "application/json" }
                });

                if (response.redirected && response.url.includes("/auth/login")) {
                    window.location.assign(response.url);
                    return;
                }

                if (!response.ok) {
                    setError(realtimeStatusTemplate.replace("{status}", `${response.status}`));
                    return;
                }

                const data = await response.json();
                const incomingTimeline = normalizeTimeline(data?.timeline);
                timelineCursor = data?.nextCursor || timelineCursor;
                mergeTimeline(incomingTimeline);
                renderAll();
                setError(data?.errorMessage || "");
                syncedEl.textContent = formatDateTime(data?.lastSyncedAt ?? new Date().toISOString());
            } catch {
                setError(realtimeNetworkMessage);
            }
        };
        const startPolling = () => {
            if (pollingTimerId !== null) {
                return;
            }

            syncTimeline();
            pollingTimerId = setInterval(syncTimeline, pollIntervalMs);
        };
        const stopPolling = () => {
            if (pollingTimerId === null) {
                return;
            }

            clearInterval(pollingTimerId);
            pollingTimerId = null;
        };
        const handleVisibility = () => {
            if (document.visibilityState === "visible") {
                startPolling();
                return;
            }

            stopPolling();
        };

        timeline = normalizeTimeline(initialTimelineRaw);
        renderAll();
        document.addEventListener("visibilitychange", handleVisibility);
        handleVisibility();
    })();
</script>
