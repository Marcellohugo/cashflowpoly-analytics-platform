@model Cashflowpoly.Ui.Models.SessionDetailViewModel

<div class="mt-8 session-journey-shell">
    <div class="session-journey-head">
        <div class="ruleset-section-head">
            <p class="eyebrow">@Context.T("sessions.timeline")</p>
            <h2 class="ruleset-section-title session-journey-title">@Context.T("sessions.timeline_title")</h2>
            <p class="ruleset-section-subtitle">@Context.T("sessions.timeline_subtitle")</p>
            <p class="ruleset-section-subtitle">@Context.T("sessions.timeline_mixed_subtitle")</p>
        </div>
        <div class="session-journey-sync">
            <span>@Context.T("sessions.journey.last_sync")</span>
            <strong id="session-journey-synced">@DateTimeOffset.Now.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.TimelineErrorMessage))
    {
        <div id="session-journey-error" class="mt-4 alert alert-warning" aria-live="polite">
            @Model.TimelineErrorMessage
        </div>
    }
    else
    {
        <div id="session-journey-error" class="mt-4 alert alert-warning hidden" aria-live="polite"></div>
    }

    <div class="session-journey-insight-grid session-count-grid">
        <article class="session-journey-insight-card">
            <p class="session-journey-insight-label">@Context.T("sessions.timeline_day_turn")</p>
            <p id="session-journey-insight-day-turn" class="session-journey-insight-value">-</p>
        </article>
        <article class="session-journey-insight-card">
            <p class="session-journey-insight-label">@Context.T("sessions.timeline_latest_player")</p>
            <p id="session-journey-insight-player" class="session-journey-insight-value">-</p>
        </article>
    </div>

    <div class="session-journey-filter-shell">
        <p class="session-journey-filter-label">
            <span class="session-journey-filter-label-icon" aria-hidden="true">✦</span>
            @Context.T("sessions.timeline_filter_label")
        </p>
        <div id="session-journey-filter"
             class="session-journey-filter"
             role="toolbar"
             aria-label="@Context.T("sessions.timeline_filter_label")">
            <button type="button"
                    class="session-journey-filter-btn session-journey-filter-btn--all is-active"
                    data-timeline-filter="all"
                    aria-pressed="true">
                <span class="session-journey-filter-all-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                <span>@Context.T("sessions.timeline_filter_all")</span>
            </button>
        </div>
    </div>

    @*
        Keep translations for unit tests:
        @Context.T("sessions.timeline_filter_players")
        @Context.T("sessions.timeline_filter_system")
        @Context.T("sessions.timeline_active_players")
        @Context.T("metric.total_event")
        @Context.T("sessions.journey.latest_activity")
    *@

    <!-- Kalender Kerja Grid -->
    <div class="work-calendar-shell">
        <div class="work-calendar-title-bar">
            <h3>@Context.T("sessions.journey.board_title")</h3>
            <p class="subtitle">@Context.T("sessions.journey.board_subtitle")</p>
        </div>
        <div class="work-calendar-headers">
            <div class="work-calendar-header-day">@Context.T("sessions.journey.day.sun")</div>
            <div class="work-calendar-header-day">@Context.T("sessions.journey.day.mon")</div>
            <div class="work-calendar-header-day">@Context.T("sessions.journey.day.tue")</div>
            <div class="work-calendar-header-day">@Context.T("sessions.journey.day.wed")</div>
            <div class="work-calendar-header-day">@Context.T("sessions.journey.day.thu")</div>
            <div class="work-calendar-header-day">@Context.T("sessions.journey.day.fri")</div>
            <div class="work-calendar-header-day">@Context.T("sessions.journey.day.sat")</div>
        </div>
        <div id="work-calendar-grid" class="work-calendar-grid">
            <!-- Populated dynamically via JS -->
        </div>
    </div>

    <!-- Day Activities Panel -->
    <div id="session-journey-day-panel" class="session-journey-day-panel mt-6 hidden">
        <div class="session-journey-day-header">
            <h4 class="session-journey-day-title">
                <span id="session-journey-day-title-text">-</span>
                <span id="session-journey-day-event-count" class="session-journey-day-badge">0</span>
            </h4>
            <p id="session-journey-day-desc" class="session-journey-day-desc">-</p>
        </div>
        <div class="p-4 session-journey-feed-wrap">
            <ol id="session-journey-feed" class="session-journey-feed" aria-live="polite"></ol>
        </div>
    </div>

