@* Fungsi file: Merender tampilan Razor untuk bagian Sessions/Index.cshtml beserta interaksi presentasinya. *@
@model Cashflowpoly.Ui.Models.SessionListViewModel

@{
    ViewData["Title"] = Context.T("nav.sessions");
    var isInstructor = Context.IsInstructor();
    var currentPlayerId = Context.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var totalSessions = Model.Items.Count;
    var startedCount = Model.Items.Count(x => string.Equals(x.Status, "STARTED", StringComparison.OrdinalIgnoreCase));
    var endedCount = Model.Items.Count(x => string.Equals(x.Status, "ENDED", StringComparison.OrdinalIgnoreCase));
    var listTitle = isInstructor
        ? Context.T("sessions.index.list_title.instructor")
        : Context.T("sessions.index.list_title.player");
    var listSubtitle = isInstructor
        ? Context.T("sessions.index.list_subtitle.instructor")
        : Context.T("sessions.index.list_subtitle.player");
}

<section class="section-shell w-full">
    <div class="page-intro">
        <div class="page-intro-main">
            <p class="eyebrow">@(isInstructor ? Context.T("sessions.management") : Context.T("sessions.player_management"))</p>
            <h1 class="headline">@(isInstructor ? Context.T("sessions.title") : Context.T("sessions.player_title"))</h1>
            <p class="subhead">@(isInstructor
                ? Context.T("sessions.subtitle")
                : Context.T("sessions.player_subtitle"))</p>
        </div>
        <div class="page-intro-actions">
            <div class="badge @(isInstructor ? "badge-amber" : "badge-emerald")">@(isInstructor ? Context.T("sessions.live_log") : Context.T("sessions.readonly"))</div>
        </div>
    </div>

    <div class="mt-6 ruleset-unified sessions-index-shell">
        <section class="sessions-index-section session-stats-section" hidden>
            <div class="ruleset-section-head">
                <p class="ruleset-section-title">@Context.T("sessions.index.summary_title")</p>
                <p class="ruleset-section-subtitle">@Context.T("sessions.index.summary_subtitle")</p>
            </div>
            <div class="session-stats-grid mt-3">
                <div class="stat-card session-total-card">
                    <p class="text-xs uppercase text-slate-500">@(isInstructor ? Context.T("sessions.total_sessions") : Context.T("sessions.my_sessions"))</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@(Model.SessionsAvailable ? totalSessions.ToString() : "—")</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("sessions.started")</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@(Model.SessionsAvailable ? startedCount.ToString() : "—")</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("sessions.ended")</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@(Model.SessionsAvailable ? endedCount.ToString() : "—")</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("players.monitored_players")</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@(Model.MonitoredPlayers?.ToString() ?? "—")</p>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="mt-4 alert alert-error" aria-live="polite">
                @Model.ErrorMessage
            </div>
        }

        <section class="sessions-index-section mt-4">
            <details class="mt-3 data-toggle">
                <summary>@(isInstructor ? Context.T("sessions.tips.instructor.title") : Context.T("sessions.tips.player.title"))</summary>
                <div class="mt-3 metric-panel">
                    <div class="metric-list">
                        @if (isInstructor)
                        {
                            <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 1</span><span class="metric-value">@Context.T("sessions.tips.instructor.step1")</span></div>
                            <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 2</span><span class="metric-value">@Context.T("sessions.tips.instructor.step2")</span></div>
                            <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 3</span><span class="metric-value">@Context.T("sessions.tips.instructor.step3")</span></div>
                        }
                        else
                        {
                            <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 1</span><span class="metric-value">@Context.T("sessions.tips.player.step1")</span></div>
                            <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 2</span><span class="metric-value">@Context.T("sessions.tips.player.step2")</span></div>
                            <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 3</span><span class="metric-value">@Context.T("sessions.tips.player.step3")</span></div>
                        }
                    </div>
                </div>
            </details>

        </section>

        <section class="sessions-index-section mt-5">
            <div class="ruleset-section-head">
                <p class="ruleset-section-title">@listTitle</p>
                <p class="ruleset-section-subtitle">@listSubtitle</p>
            </div>
            <div class="mt-3 players-session-stack">
                @if (Model.Items.Count == 0 && Model.SessionsAvailable)
                {
                    <p class="text-slate-500">@Context.T("state.no_sessions")</p>
                }
                @foreach (var session in Model.SessionGroups)
                {
                    var statusClass = session.Status == "STARTED" ? "status-active" : session.Status == "CREATED" ? "status-draft" : "status-retired";
                    <details class="data-toggle players-session-card">
                        <summary class="players-session-summary">
                            <span class="players-session-summary-main">
                                <span class="font-semibold text-slate-900">@session.SessionName</span>
                                <span class="text-xs text-slate-500">(@(session.ParticipantsAvailable ? session.Players.Count.ToString() : "—") @Context.T("players.count_suffix"))</span>
                                <span class="hint-chip">@Context.TRulesetMode(session.Mode)</span>
                                <span class="status-pill @statusClass">@Context.TSessionStatus(session.Status)</span>
                            </span>
                        </summary>
                        <div class="players-session-meta mt-3">
                            <span class="hint-chip">@Context.T("common.created"): <time data-local-time datetime="@session.CreatedAt.ToString("O")">@session.CreatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm") UTC</time></span>
                            @if (session.StartedAt.HasValue)
                            {
                                <span class="hint-chip">@Context.T("common.start"): <time data-local-time datetime="@session.StartedAt.Value.ToString("O")">@session.StartedAt.Value.UtcDateTime.ToString("dd/MM/yyyy HH:mm") UTC</time></span>
                            }
                            @if (session.EndedAt.HasValue)
                            {
                                <span class="hint-chip">@Context.T("common.finish"): <time data-local-time datetime="@session.EndedAt.Value.ToString("O")">@session.EndedAt.Value.UtcDateTime.ToString("dd/MM/yyyy HH:mm") UTC</time></span>
                            }
                            <a class="btn-ghost players-session-detail" asp-controller="Sessions" asp-action="Details" asp-route-sessionId="@session.SessionId">@Context.T("common.detail")</a>
                        </div>
                        @if (!session.ParticipantsAvailable)
                        {
                            <p class="alert alert-info mt-3">@Context.T("players.error.load_session_details_partial")</p>
                        }
                        else if (session.Players.Count == 0)
                        {
                            <p class="mt-3 text-slate-500">@Context.T("state.no_players")</p>
                        }
                        else
                        {
                            @if (session.Status != "ENDED" || !session.ResultsAvailable)
                            {
                                <p class="mt-3 text-sm text-slate-500">@Context.T("sessions.results_pending")</p>
                            }
                            <div class="mt-3 table-wrap">
                                <table class="w-full text-left text-sm mobile-card-table players-session-table">
                                    <colgroup><col class="players-session-col-order" /><col class="players-session-col-rank" /><col class="players-session-col-name" /><col class="players-session-col-score" /><col class="players-session-col-action" /></colgroup>
                                    <thead class="table-head"><tr>
                                        <th class="px-4 py-3">@Context.T("common.turn_order")</th>
                                        <th class="px-4 py-3">@Context.T("common.rank")</th>
                                        <th class="px-4 py-3 players-session-name-heading">@Context.T("common.name")</th>
                                        <th class="px-4 py-3">@Context.T("players.index.happiness_points")</th>
                                        <th class="px-4 py-3">@Context.T("players.index.analytics_column")</th>
                                    </tr></thead>
                                    <tbody>
                                    @foreach (var player in session.Players)
                                    {
                                        <tr class="border-t border-slate-200 @(player.FinalRank == 1 ? "winner-row" : "")">
                                            <td class="px-4 py-3 players-session-number" data-label="@Context.T("common.turn_order")">@(player.PlayerOrder > 0 ? player.PlayerOrder.ToString() : "—")</td>
                                            <td class="px-4 py-3 players-session-number" data-label="@Context.T("common.rank")"><span class="players-session-rank rank-@player.FinalRank">@(player.FinalRank > 0 ? player.FinalRank.ToString() : "—")</span></td>
                                            <td class="px-4 py-3 players-session-player" data-label="@Context.T("common.name")">
                                                <div class="flex items-center gap-3">
                                                    <img class="h-7 w-7 rounded-full border border-slate-200 object-cover" src="/images/players/@(Math.Max(0, player.PlayerOrder - 1) % 4 + 1).png" alt="" />
                                                    <span class="font-medium text-slate-900">@player.DisplayName</span>
                                                </div>
                                            </td>
                                            <td class="px-4 py-3 players-session-number" data-label="@Context.T("players.index.happiness_points")"><strong class="players-session-score">@(player.HappinessPointsTotal?.ToString("0.##") ?? "—")</strong></td>
                                            <td class="px-4 py-3 players-session-action" data-label="@Context.T("players.index.analytics_column")">
                                                @if (session.Status != "CREATED" && (isInstructor || player.PlayerId.ToString() == currentPlayerId))
                                                {
                                                    <a class="table-link" asp-controller="Players" asp-action="Details" asp-route-sessionId="@session.SessionId" asp-route-playerId="@player.PlayerId">@Context.T("players.index.view_detail")</a>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400" aria-label="@Context.T("players.index.detail_unavailable")">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </details>
                }
            </div>
        </section>
    </div>
</section>
