@* Fungsi file: Merender tampilan Razor untuk bagian Sessions/Details.cshtml beserta interaksi presentasinya. *@
@model Cashflowpoly.Ui.Models.SessionDetailViewModel
@{
    ViewData["Title"] = Context.T("sessions.detail_title");
    var isInstructor = Context.IsInstructor();
    var playerDisplayNames = Model.PlayerDisplayNames;
    var fallbackPlayerNames = new Dictionary<Guid, string>();
    var fallbackPlayerIndex = 1;
    var knownPlayerIds = (Model.Analytics?.ByPlayer.Select(item => item.UserId) ?? Enumerable.Empty<Guid>())
        .Concat(Model.Timeline.Where(item => item.PlayerId.HasValue).Select(item => item.PlayerId!.Value))
        .Distinct()
        .ToList();

    foreach (var playerId in knownPlayerIds)
    {
        if (playerDisplayNames.TryGetValue(playerId, out var displayName) && !string.IsNullOrWhiteSpace(displayName))
        {
            continue;
        }

        fallbackPlayerNames[playerId] = $"{Context.T("common.player")} {fallbackPlayerIndex}";
        fallbackPlayerIndex++;
    }

    string ResolvePlayerName(Guid playerId)
    {
        if (playerDisplayNames.TryGetValue(playerId, out var displayName) && !string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        if (fallbackPlayerNames.TryGetValue(playerId, out var fallbackName))
        {
            return fallbackName;
        }

        return Context.T("common.player");
    }

    int ResolvePlayerAvatarIndex(int turnOrder)
    {
        if (turnOrder <= 0)
        {
            return 1;
        }

        return ((turnOrder - 1) % 4) + 1;
    }

    string ResolvePlayerAvatarPath(int turnOrder) => $"/images/players/{ResolvePlayerAvatarIndex(turnOrder)}.png";

    string F(double value) => value == 0d ? "0" : value.ToString("0.##");
}

@section Head {
    <style>
        .session-journey-title {
            max-width: 18ch;
            line-height: 1.15;
            text-wrap: balance;
        }

        .session-journey-insight-grid {
            margin-top: 0.8rem;
            display: grid;
            gap: 0.65rem;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        }

        .session-journey-insight-card {
            border: 1px solid #a8e5de;
            border-radius: 0.85rem;
            background: rgba(255, 255, 255, 0.9);
            padding: 0.62rem 0.7rem;
            min-width: 0;
            min-height: 4.45rem;
            display: grid;
            align-content: start;
        }

        .session-journey-insight-label {
            margin: 0;
            font-size: 0.68rem;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: #547286;
            font-weight: 800;
        }

        .session-journey-insight-value {
            margin: 0.32rem 0 0;
            color: #15394f;
            font-size: 0.92rem;
            font-weight: 800;
            line-height: 1.25;
        }

        .session-ruleset-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
        }

        .session-ruleset-content {
            min-width: 0;
            flex: 1 1 auto;
        }

        .session-ruleset-action {
            margin-top: 0 !important;
            flex-shrink: 0;
            display: flex;
            align-items: center;
        }

        @@media (max-width: 640px) {
            .session-journey-title {
                max-width: none;
            }

            .session-journey-insight-grid {
                grid-template-columns: minmax(0, 1fr);
            }

            .session-ruleset-card {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .session-ruleset-action {
                width: 100%;
            }

            .session-ruleset-action .btn-ghost {
                width: 100%;
                text-align: center;
                justify-content: center;
            }
        }
    </style>
}

<section class="section-shell session-detail-shell">
    <div class="ruleset-hero">
        <div>
            <p class="eyebrow text-emerald-700">@Context.T("sessions.analytics_title")</p>
            <h1 class="headline">@Context.T("sessions.detail_title")</h1>
        </div>
        <div class="ruleset-hero-meta">
            @if (!string.IsNullOrWhiteSpace(Model.SessionStatus))
            {
                var sessionStatusClass = string.Equals(Model.SessionStatus, "STARTED", StringComparison.OrdinalIgnoreCase)
                    ? "status-active"
                    : string.Equals(Model.SessionStatus, "CREATED", StringComparison.OrdinalIgnoreCase)
                        ? "status-draft"
                        : "status-retired";
                <span class="status-pill @sessionStatusClass">@Context.TSessionStatus(Model.SessionStatus)</span>
            }
        </div>
    </div>

    <div class="action-toolbar mt-4">
        <a class="btn-ghost"
           asp-controller="Sessions"
           asp-action="Index">@("<- " + Context.T("sessions.back_to_list"))</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mt-4 alert alert-error" aria-live="polite">
            @Model.ErrorMessage
        </div>
    }

    <section class="session-detail-section mt-5">
        <details class="mt-3 data-toggle">
            <summary>@(isInstructor ? Context.T("analytics.tips.instructor") : Context.T("analytics.tips.player"))</summary>
            <div class="mt-3 metric-panel">
                <div class="metric-list">
                    @if (isInstructor)
                    {
                        <div class="metric-row"><span class="metric-key">@Context.T("analytics.tip_key.input")</span><span class="metric-value">@Context.T("analytics.tip.input")</span></div>
                        <div class="metric-row"><span class="metric-key">@Context.T("analytics.tip_key.interpretation")</span><span class="metric-value">@Context.T("analytics.tip.interpretation")</span></div>
                        <div class="metric-row"><span class="metric-key">@Context.T("analytics.tip_key.followup")</span><span class="metric-value">@Context.T("analytics.tip.followup")</span></div>
                    }
                    else
                    {
                        <div class="metric-row"><span class="metric-key">@Context.T("analytics.tip_key.select_session")</span><span class="metric-value">@Context.T("analytics.tip.select_session")</span></div>
                        <div class="metric-row"><span class="metric-key">@Context.T("analytics.tip_key.focus_score")</span><span class="metric-value">@Context.T("analytics.tip.focus_score")</span></div>
                        <div class="metric-row"><span class="metric-key">@Context.T("analytics.tip_key.risk_control")</span><span class="metric-value">@Context.T("analytics.tip.risk_control")</span></div>
                    }
                </div>
            </div>
        </details>
    </section>

    <section class="session-detail-section mt-5">
        <div class="ruleset-section-head">
            <p class="ruleset-section-title">@Context.T("sessions.active_ruleset.title")</p>
            <p class="ruleset-section-subtitle">@Context.T("sessions.detail.ruleset_subtitle")</p>
        </div>
        <div class="mt-3 metric-panel session-ruleset-card">
            @if (Model.Analytics?.RulesetId.HasValue == true)
            {
                <div class="session-ruleset-content">
                    <h2 class="text-xl font-semibold text-slate-900">
                        @(string.IsNullOrWhiteSpace(Model.Analytics.RulesetName) ? Context.T("common.ruleset") : Model.Analytics.RulesetName)
                    </h2>
                    <p class="mt-2 text-sm text-slate-600">@Context.T("sessions.active_ruleset.subtitle")</p>
                </div>
                <div class="session-ruleset-action action-toolbar">
                    <button type="button"
                            class="btn-ghost"
                            id="openRulesetModalBtn"
                            aria-haspopup="dialog"
                            aria-controls="rulesetModal">@Context.T("sessions.view_analytics")</button>
                </div>
            }
            else
            {
                <p class="mt-2 text-sm text-slate-600">@Context.T("sessions.active_ruleset.empty")</p>
            }
        </div>
    </section>

    @if (Model.Analytics?.RulesetId.HasValue == true)
    {
        var rulesetDetailModel = Model.ActiveRulesetDetail ?? new Cashflowpoly.Ui.Models.RulesetDetailViewModel();
        var rulesetDetail = rulesetDetailModel.Ruleset;
        var isAdvancedModal = string.Equals(rulesetDetail?.Mode ?? rulesetDetail?.Definition?.Mode, "MAHIR", StringComparison.OrdinalIgnoreCase);
        var modalModeCss = isAdvancedModal ? "advanced" : "beginner";

        <div id="rulesetModal"
             class="ruleset-modal-backdrop ruleset-modal--@modalModeCss"
             data-ruleset-mode="@modalModeCss"
             role="dialog"
             aria-modal="true"
             aria-labelledby="rulesetModalTitle"
             aria-hidden="true"
             style="display: none;">
            <div class="ruleset-modal-overlay" id="rulesetModalOverlay"></div>
            <div class="ruleset-modal-container" role="document">
                <div class="ruleset-modal-header">
                    <div>
                        <p class="eyebrow">@Context.T("sessions.active_ruleset.title")</p>
                        <h2 id="rulesetModalTitle" class="text-xl font-bold text-slate-900 mt-1">@Context.T("rulesets.detail_title")</h2>
                    </div>
                    <button type="button"
                            class="ruleset-modal-close"
                            id="closeRulesetModalBtn"
                            aria-label="@Context.T("common.close")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="ruleset-modal-body" id="rulesetModalBody">
                    @await Html.PartialAsync(
                        "_RulesetDetailContent",
                        rulesetDetailModel,
                        new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                        {
                            ["RulesetDetailEmbedded"] = true
                        })
                </div>
            </div>
        </div>
    }

    @if (Model.Analytics is not null)
    {
        var rankedPlayers = Model.Analytics.ByPlayer
            .OrderByDescending(item => item.HappinessPointsTotal)
            .ThenByDescending(item => item.CashInTotal - item.CashOutTotal)
            .ThenBy(item => item.PlayerOrder > 0 ? item.PlayerOrder : int.MaxValue)
            .ThenBy(item => item.UserId)
            .ToList();
        var orderedPlayers = Model.Analytics.ByPlayer
            .OrderBy(item => item.PlayerOrder > 0 ? item.PlayerOrder : int.MaxValue)
            .ThenBy(item => item.UserId)
            .ToList();
        var playerRankLookup = rankedPlayers
            .Select((item, index) => new { item.UserId, Rank = index + 1 })
            .ToDictionary(item => item.UserId, item => item.Rank);
        var currentPlayerSummary = isInstructor ? null : orderedPlayers.FirstOrDefault();
        var happinessScoreRows = new[]
        {
            new { Number = 1, Label = Context.T("sessions.score.need_points"), IsDeduction = false, Values = orderedPlayers.Select(item => item.NeedPointsTotal).ToList() },
            new { Number = 2, Label = Context.T("sessions.score.need_bonus"), IsDeduction = false, Values = orderedPlayers.Select(item => item.NeedSetBonusPoints).ToList() },
            new { Number = 3, Label = Context.T("sessions.score.mission_penalty"), IsDeduction = true, Values = orderedPlayers.Select(item => -item.MissionPenaltyTotal).ToList() },
            new { Number = 4, Label = Context.T("sessions.score.donation_points"), IsDeduction = false, Values = orderedPlayers.Select(item => item.DonationPointsTotal).ToList() },
            new { Number = 5, Label = Context.T("sessions.score.pension_points"), IsDeduction = false, Values = orderedPlayers.Select(item => item.PensionPointsTotal).ToList() },
            new { Number = 6, Label = Context.T("sessions.score.financial_goal"), IsDeduction = false, Values = orderedPlayers.Select(item => item.SavingGoalPointsTotal).ToList() },
            new { Number = 7, Label = Context.T("sessions.score.loan_penalty"), IsDeduction = true, Values = orderedPlayers.Select(item => -item.LoanPenaltyTotal).ToList() },
            new { Number = 8, Label = Context.T("sessions.score.gold_points"), IsDeduction = false, Values = orderedPlayers.Select(item => item.GoldPointsTotal).ToList() }
        };
        <section class="session-detail-section mt-5">
            <div class="ruleset-section-head">
                <p class="ruleset-section-title">@Context.T(isInstructor ? "sessions.detail.summary_title" : "sessions.detail.player_summary_title")</p>
                <p class="ruleset-section-subtitle">@Context.T(isInstructor ? "sessions.detail.summary_subtitle" : "sessions.detail.player_summary_subtitle")</p>
            </div>
            @if (isInstructor)
            {
            <div class="mt-3 ruleset-stats">
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.total_event")</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Analytics.Summary.EventCount</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.cash_in")</p>
                    <p class="mt-2 text-2xl font-semibold text-emerald-700">@Model.Analytics.Summary.CashInTotal</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.cash_out")</p>
                    <p class="mt-2 text-2xl font-semibold text-rose-700">@Model.Analytics.Summary.CashOutTotal</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.net_cashflow")</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Analytics.Summary.CashflowNetTotal</p>
                </div>
            </div>
            }
            else if (currentPlayerSummary is not null)
            {
            <div class="mt-3 session-stats-grid">
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.cash_in")</p>
                    <p class="mt-2 text-2xl font-semibold text-emerald-700">@F(currentPlayerSummary.CashInTotal)</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.cash_out")</p>
                    <p class="mt-2 text-2xl font-semibold text-rose-700">@F(currentPlayerSummary.CashOutTotal)</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.net_cashflow")</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@F(currentPlayerSummary.CashInTotal - currentPlayerSummary.CashOutTotal)</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.happiness")</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@F(currentPlayerSummary.HappinessPointsTotal)</p>
                </div>
                <div class="stat-card">
                    <p class="text-xs uppercase text-slate-500">@Context.T("metric.fulfillment_diversity")</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-900">@($"{Math.Round(currentPlayerSummary.FulfillmentDiversity * 100)}%")</p>
                </div>
            </div>
            }

        <div class="ruleset-section-head mt-6">
            <p class="ruleset-section-title">@Context.T(isInstructor ? "sessions.detail.players_title" : "sessions.detail.player_scores_title")</p>
            <p class="ruleset-section-subtitle">@Context.T(isInstructor ? "sessions.detail.players_subtitle" : "sessions.detail.player_scores_subtitle")</p>
        </div>

        @if (orderedPlayers.Count == 0)
        {
            <div class="mt-3 alert alert-info">@Context.T("state.no_player_data")</div>
        }
        else
        {
            <div class="mt-3 table-wrap happiness-score-sheet happiness-score-desktop" tabindex="0" role="region" aria-label="@Context.T(isInstructor ? "sessions.detail.players_title" : "sessions.detail.player_scores_title")">
                <table class="happiness-score-table text-sm">
                    <colgroup>
                        <col class="happiness-score-label-column" />
                        @for (var playerIndex = 0; playerIndex < orderedPlayers.Count; playerIndex++)
                        {
                            <col class="happiness-score-player-column" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="happiness-score-label happiness-score-title" scope="col">
                                @Context.T("sessions.score.elements_title")
                            </th>
                            @for (var playerIndex = 0; playerIndex < orderedPlayers.Count; playerIndex++)
                            {
                                var item = orderedPlayers[playerIndex];
                                var turnOrder = item.PlayerOrder > 0 ? item.PlayerOrder : playerIndex + 1;
                                var rank = playerRankLookup.TryGetValue(item.UserId, out var resolvedRank)
                                    ? resolvedRank
                                    : 0;
                                <th class="happiness-score-player happiness-score-player--turn-@turnOrder @(rank == 1 ? "happiness-score-player--winner" : string.Empty)" scope="col">
                                    <span class="happiness-score-player-card">
                                        <img src="@ResolvePlayerAvatarPath(turnOrder)"
                                             alt="@($"{Context.T("common.turn_order")} {turnOrder}")" />
                                        <span class="happiness-score-player-name">@ResolvePlayerName(item.UserId)</span>
                                        <span class="happiness-score-player-meta">
                                            @Context.T("common.turn_order") @turnOrder · @Context.T("common.rank") @(rank > 0 ? rank : "-")
                                        </span>
                                        <a class="table-link"
                                           asp-controller="Players" asp-action="Details" asp-route-sessionId="@Model.SessionId"
                                           asp-route-playerId="@item.UserId">@Context.T("sessions.view_analytics")</a>
                                    </span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scoreRow in happinessScoreRows)
                        {
                            <tr class="@(scoreRow.IsDeduction ? "happiness-score-deduction" : string.Empty)">
                                <th class="happiness-score-label" scope="row">
                                    <span class="happiness-score-label-content">
                                        <span class="happiness-score-number">@scoreRow.Number</span>
                                        <span>@scoreRow.Label</span>
                                    </span>
                                </th>
                                @foreach (var value in scoreRow.Values)
                                {
                                    <td>
                                        <span class="happiness-score-value @(scoreRow.IsDeduction ? "happiness-score-value--deduction" : string.Empty)">@F(value)</span>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th class="happiness-score-label" scope="row">@Context.T("sessions.score.total")</th>
                            @foreach (var item in orderedPlayers)
                            {
                                <td><strong>@F(item.HappinessPointsTotal)</strong></td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="happiness-score-mobile">
                @for (var playerIndex = 0; playerIndex < orderedPlayers.Count; playerIndex++)
                {
                    var item = orderedPlayers[playerIndex];
                    var turnOrder = item.PlayerOrder > 0 ? item.PlayerOrder : playerIndex + 1;
                    var rank = playerRankLookup.TryGetValue(item.UserId, out var resolvedRank)
                        ? resolvedRank
                        : 0;
                    <article class="happiness-score-mobile-card @(rank == 1 ? "happiness-score-mobile-card--winner" : string.Empty)">
                        <header class="happiness-score-mobile-player happiness-score-player--turn-@turnOrder">
                            <img src="@ResolvePlayerAvatarPath(turnOrder)"
                                 alt="@($"{Context.T("common.turn_order")} {turnOrder}")" />
                            <div>
                                <h3>@ResolvePlayerName(item.UserId)</h3>
                                <p>@Context.T("common.turn_order") @turnOrder · @Context.T("common.rank") @(rank > 0 ? rank : "-")</p>
                                <a class="table-link"
                                   asp-controller="Players" asp-action="Details" asp-route-sessionId="@Model.SessionId"
                                   asp-route-playerId="@item.UserId">@Context.T("sessions.view_analytics")</a>
                            </div>
                        </header>
                        <dl>
                            @foreach (var scoreRow in happinessScoreRows)
                            {
                                <div class="happiness-score-mobile-row @(scoreRow.IsDeduction ? "happiness-score-deduction" : string.Empty)">
                                    <dt>
                                        <span class="happiness-score-number">@scoreRow.Number</span>
                                        <span>@scoreRow.Label</span>
                                    </dt>
                                    <dd>
                                        <span class="happiness-score-value @(scoreRow.IsDeduction ? "happiness-score-value--deduction" : string.Empty)">@F(scoreRow.Values[playerIndex])</span>
                                    </dd>
                                </div>
                            }
                            <div class="happiness-score-mobile-total">
                                <dt>@Context.T("sessions.score.total")</dt>
                                <dd>@F(item.HappinessPointsTotal)</dd>
                            </div>
                        </dl>
                    </article>
                }
            </div>
        }
        </section>

    }
    else
    {
        <div class="session-detail-section mt-5">
            <div class="alert alert-info" aria-live="polite">
                @Context.T("sessions.detail.empty_analytics")
            </div>
        </div>
    }

    <div class="session-detail-section mt-5">
        @await Html.PartialAsync("_SessionJourneySection", Model)
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_SessionJourneyScript", Model)
    <script>
        (() => {
            const openBtn = document.getElementById('openRulesetModalBtn');
            const closeBtn = document.getElementById('closeRulesetModalBtn');
            const modal = document.getElementById('rulesetModal');
            const overlay = document.getElementById('rulesetModalOverlay');
            const focusableSelector = 'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
            const previousBodyOverflow = document.body.style.overflow;

            if (!openBtn || !modal) return;
            document.body.appendChild(modal);

            function openModal() {
                modal.classList.add('is-open');
                modal.style.display = 'flex';
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                if (closeBtn) closeBtn.focus();
            }

            function closeModal() {
                modal.classList.remove('is-open');
                modal.style.display = 'none';
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = previousBodyOverflow;
                openBtn.focus();
            }

            openBtn.addEventListener('click', (e) => {
                e.preventDefault();
                openModal();
            });

            if (closeBtn) {
                closeBtn.addEventListener('click', closeModal);
            }

            if (overlay) {
                overlay.addEventListener('click', closeModal);
            }

            document.addEventListener('keydown', (e) => {
                if (!modal.classList.contains('is-open')) return;

                if (e.key === 'Escape') {
                    closeModal();
                    return;
                }

                if (e.key === 'Tab') {
                    const focusable = Array.from(modal.querySelectorAll(focusableSelector));
                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];
                    if (!first || !last) return;

                    if (e.shiftKey && document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    } else if (!e.shiftKey && document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                }
            });
        })();
    </script>
}
