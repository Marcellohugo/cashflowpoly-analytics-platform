@* Fungsi file: Merender tampilan Razor untuk bagian Auth/Register.cshtml beserta interaksi presentasinya. *@
@model Cashflowpoly.Ui.Models.RegisterViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = Context.T("auth.register_title");
    ViewData["MetaDescription"] = Context.T("register.meta_desc");
    ViewData["MetaKeywords"] = Context.T("register.meta_keywords");
    ViewData["HideFooter"] = true;
    ViewData["HideHeader"] = true;
    var activeLanguage = UiText.NormalizeLanguage(Context.Session.GetString(AuthConstants.SessionLanguageKey));
    var isEnglish = string.Equals(activeLanguage, AuthConstants.LanguageEn, StringComparison.OrdinalIgnoreCase);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="auth-split-shell">
    <section class="auth-split-card auth-mode-register" aria-labelledby="auth-register-heading">
        <aside class="auth-split-right">
            <div class="auth-panel-lang-corner">
                <div class="auth-panel-lang" role="group" aria-label="@Context.T("lang.label")">
                    <form method="post" asp-controller="Language" asp-action="Set">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="language" value="@AuthConstants.LanguageId" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="auth-panel-lang-btn @(isEnglish ? string.Empty : "active")" type="submit">@Context.T("lang.code.id")</button>
                    </form>
                    <form method="post" asp-controller="Language" asp-action="Set">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="language" value="@AuthConstants.LanguageEn" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="auth-panel-lang-btn @(isEnglish ? "active" : string.Empty)" type="submit">@Context.T("lang.code.en")</button>
                    </form>
                </div>
            </div>
            <a class="auth-panel-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img class="auth-panel-brand-mark" src="~/images/images.jpg" asp-append-version="true" alt="@Context.T("layout.logo_alt")" />
                <span class="auth-panel-brand-text">@Context.T("layout.brand_name")</span>
            </a>
            <div class="auth-panel-content">
                <h2>@Context.T("auth.login_panel_title")</h2>
                <p>@Context.T("auth.login_panel_desc")</p>
            </div>
            <a class="auth-signup-cta js-auth-switch" data-auth-switch-direction="right" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@Context.T("auth.login_panel_cta")</a>
        </aside>

        <div class="auth-split-left">
            <div class="auth-content-head">
                <p class="auth-kicker">@Context.T("auth.access")</p>
                <h1 class="auth-heading" id="auth-register-heading">@Context.T("auth.register_title")</h1>
                <p class="auth-copy">@Context.T("auth.register_subtitle")</p>
            </div>

            <form class="auth-form" method="post" asp-controller="Auth" asp-action="Register">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="form-field">
                    <label class="auth-label">@Context.T("auth.register_role")</label>
                    <select id="register-role" name="Role" class="sr-only" tabindex="-1" aria-hidden="true">
                        <option value="PLAYER" selected="@(!string.Equals(Model.Role, "INSTRUCTOR", StringComparison.OrdinalIgnoreCase))">@Context.T("auth.role_player")</option>
                        <option value="INSTRUCTOR" selected="@(string.Equals(Model.Role, "INSTRUCTOR", StringComparison.OrdinalIgnoreCase))">@Context.T("auth.role_instructor")</option>
                    </select>
                    <div class="auth-role-picker" role="radiogroup" aria-label="@Context.T("auth.register_role")">
                        <label class="auth-role-card @(string.Equals(Model.Role, "INSTRUCTOR", StringComparison.OrdinalIgnoreCase) ? "is-selected" : "")" for="role-instructor">
                            <input type="radio"
                                   id="role-instructor"
                                   name="RoleOption"
                                   value="INSTRUCTOR"
                                   class="auth-role-radio sr-only"
                                   @(string.Equals(Model.Role, "INSTRUCTOR", StringComparison.OrdinalIgnoreCase) ? "checked" : "") />
                            <svg class="auth-role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="7" r="4.5"></circle>
                                <path d="M20 21a8 8 0 0 0-16 0"></path>
                                <path d="m9.5 12 2.5 2 2.5-2"></path>
                                <path d="m11 14 1 6 1-6"></path>
                            </svg>
                            <span class="auth-role-name">@Context.T("auth.role_instructor")</span>
                        </label>
                        <label class="auth-role-card @(!string.Equals(Model.Role, "INSTRUCTOR", StringComparison.OrdinalIgnoreCase) ? "is-selected" : "")" for="role-player">
                            <input type="radio"
                                   id="role-player"
                                   name="RoleOption"
                                   value="PLAYER"
                                   class="auth-role-radio sr-only"
                                   @(!string.Equals(Model.Role, "INSTRUCTOR", StringComparison.OrdinalIgnoreCase) ? "checked" : "") />
                            <svg class="auth-role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="8" r="5"></circle>
                                <path d="M20 21a8 8 0 0 0-16 0"></path>
                            </svg>
                            <span class="auth-role-name">@Context.T("auth.role_player")</span>
                        </label>
                    </div>
                    <p id="register-role-hint" class="auth-copy">@Context.T("auth.register_role_hint")</p>
                </div>

                <div class="auth-form-grid auth-form-grid-2">
                    <div class="form-field">
                        <label class="auth-label" for="register-display-name">@Context.T("auth.display_name")</label>
                        <input class="auth-input"
                               id="register-display-name"
                               asp-for="DisplayName"
                               autocomplete="name"
                               maxlength="80"
                               aria-describedby="register-display-name-hint"
                               required
                               placeholder="@Context.T("auth.placeholder.full_name")" />
                        <p id="register-display-name-hint" class="subhead">@Context.T("auth.display_name_hint")</p>
                    </div>

                    <div class="form-field">
                        <label class="auth-label" for="register-username">@Context.T("auth.username")</label>
                        <input class="auth-input"
                               id="register-username"
                               asp-for="Username"
                               minlength="3"
                               maxlength="80"
                               aria-describedby="register-username-hint"
                               autocomplete="username"
                               autocapitalize="none"
                               autocorrect="off"
                               spellcheck="false"
                               inputmode="text"
                               enterkeyhint="next"
                               required
                               placeholder="@Context.T("auth.placeholder.new_username")" />
                        <p id="register-username-hint" class="subhead">@Context.T("auth.username_hint")</p>
                    </div>
                </div>

                <div class="auth-form-grid auth-form-grid-2">
                    <div class="form-field">
                        <label class="auth-label" for="register-password">@Context.T("auth.password")</label>
                        <div class="auth-password-control">
                            <input class="auth-input"
                                   id="register-password"
                                   asp-for="Password"
                                   minlength="12"
                                   aria-describedby="register-password-hint register-password-error"
                                   type="password"
                                   autocomplete="new-password"
                                   enterkeyhint="next"
                                   required
                                   placeholder="********" />
                            <button class="auth-password-toggle"
                                    type="button"
                                    aria-controls="register-password"
                                    aria-pressed="false"
                                    aria-label="@Context.T("auth.show_password")"
                                    title="@Context.T("auth.show_password")"
                                    data-password-toggle
                                    data-show-label="@Context.T("auth.show_password")"
                                    data-hide-label="@Context.T("auth.hide_password")">
                                <span class="auth-password-eye" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>

                    <div class="form-field">
                        <label class="auth-label" for="register-confirm-password">@Context.T("auth.confirm_password")</label>
                        <div class="auth-password-control">
                            <input class="auth-input"
                                   id="register-confirm-password"
                                   asp-for="ConfirmPassword"
                                   type="password"
                                   minlength="12"
                                   autocomplete="new-password"
                                   enterkeyhint="done"
                                   required
                                   placeholder="********" />
                            <button class="auth-password-toggle"
                                    type="button"
                                    aria-controls="register-confirm-password"
                                    aria-pressed="false"
                                    aria-label="@Context.T("auth.show_password")"
                                    title="@Context.T("auth.show_password")"
                                    data-password-toggle
                                    data-show-label="@Context.T("auth.show_password")"
                                    data-hide-label="@Context.T("auth.hide_password")">
                                <span class="auth-password-eye" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                </div>

                <p id="register-confirm-error" class="auth-confirm-error" hidden>@Context.T("auth.error.confirm_mismatch")</p>
                <p id="register-password-error" class="auth-confirm-error" aria-live="polite" hidden>@Context.T("auth.error.password_too_long")</p>
                <p id="register-password-hint" class="subhead auth-password-hint">@Context.T("auth.password_hint")</p>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-error" aria-live="polite">
                        @Model.ErrorMessage
                    </div>
                }

                <button class="auth-login-btn" type="submit">@Context.T("auth.submit_register")</button>
                <p class="auth-register-copy">
                    @Context.T("auth.have_account")
                    <a class="js-auth-switch" data-auth-switch-direction="right" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@Context.T("auth.login")</a>
                </p>
            </form>
        </div>
    </section>
</div>
<script>
(() => {
    // Role selection synchronization
    const roleSelect = document.getElementById('register-role');
    const roleRadios = document.querySelectorAll('.auth-role-radio');

    const selectRole = (val) => {
        const upper = (val || '').toUpperCase();
        roleRadios.forEach(r => {
            const isMatch = r.value.toUpperCase() === upper;
            r.checked = isMatch;
            r.closest('.auth-role-card')?.classList.toggle('is-selected', isMatch);
        });
        if (roleSelect && roleSelect.value.toUpperCase() !== upper) {
            roleSelect.value = upper;
        }
    };

    roleRadios.forEach(r => {
        r.addEventListener('change', () => {
            if (r.checked) selectRole(r.value);
        });
    });

    if (roleSelect) {
        roleSelect.addEventListener('change', () => {
            selectRole(roleSelect.value);
        });
    }

    // Password validation
    const pw = document.getElementById('register-password');
    const cpw = document.getElementById('register-confirm-password');
    const err = document.getElementById('register-confirm-error');
    const lengthError = document.getElementById('register-password-error');
    if (!pw || !cpw || !err || !lengthError) return;

    const check = () => {
        const tooLong = new TextEncoder().encode(pw.value).length > 72;
        pw.setCustomValidity(tooLong ? lengthError.textContent.trim() : '');
        pw.setAttribute('aria-invalid', String(tooLong));
        lengthError.hidden = !tooLong;
        if (cpw.value.length > 0 && pw.value !== cpw.value) {
            cpw.setCustomValidity(err.textContent.trim());
            err.hidden = false;
        } else {
            cpw.setCustomValidity('');
            err.hidden = true;
        }
    };
    pw.addEventListener('input', check);
    cpw.addEventListener('input', check);
    check();
})();
</script>
