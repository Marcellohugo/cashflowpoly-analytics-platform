@* Fungsi file: Merender tampilan Razor untuk bagian Components/Index.cshtml beserta katalog komponen default. *@
@model Cashflowpoly.Ui.Models.ComponentCatalogListViewModel

@{
    ViewData["Title"] = Context.T("nav.components");
}

<section class="section-shell w-full">
    <div class="page-intro">
        <div class="page-intro-main">
            <p class="eyebrow">@Context.T("components.management")</p>
            <h1 class="headline">@Context.T("components.title")</h1>
            <p class="subhead">@Context.T("components.subtitle")</p>
        </div>
    </div>

    <div class="mt-6 ruleset-unified ruleset-index-shell">
        <section class="ruleset-index-section">
            <div class="ruleset-section-head ruleset-section-head-row">
                <div>
                    <p class="ruleset-section-title">@Context.T("rulesets.default_components.title")</p>
                    <p class="ruleset-section-subtitle">@Context.T("rulesets.default_components.subtitle") @Context.T("rulesets.index.default_help")</p>
                </div>
                <div class="ruleset-index-count-block">
                    <p class="text-xs uppercase text-slate-500">@Context.T("components.total_components")</p>
                    <p class="ruleset-index-count">@Model.Items.Count</p>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="mt-4 alert alert-error" aria-live="polite">
                @Model.ErrorMessage
            </div>
        }

        <section class="ruleset-index-section mt-4">
            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-info">
                    @Context.T("rulesets.default_components.empty")
                </div>
            }
            else
            {
                <div class="grid gap-3 md:grid-cols-2 ruleset-default-grid">
                    @foreach (var item in Model.Items)
                    {
                        <article class="metric-panel ruleset-default-card">
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-sm font-semibold text-slate-900">@item.Name</p>
                                <span class="version-pill">@($"v{item.Version}")</span>
                            </div>
                            <p class="mt-2 text-xs text-slate-600">
                                @Context.T("common.mode"): @Context.TRulesetMode(item.Mode)
                            </p>
                            <p class="mt-1 text-xs text-slate-600">
                                @Context.T("common.description"): @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                            </p>
                            <p class="mt-1 text-[11px] text-slate-500">
                                @Context.T("common.ruleset_id"): <span class="font-mono">@item.RulesetId</span>
                            </p>
                            <p class="mt-1 text-[11px] text-slate-500">
                                @Context.T("rulesets.components.ruleset_version_id"): <span class="font-mono">@item.RulesetVersionId</span>
                            </p>
                            <div class="mt-3 ruleset-default-card-action">
                                <a class="table-link"
                                   asp-controller="Rulesets"
                                   asp-action="DefaultComponentDetails"
                                   asp-route-rulesetVersionId="@item.RulesetVersionId">@Context.T("rulesets.default_components.open_detail")</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>
