@* Fungsi file: Modal popup terpadu untuk memilih versi dasar set aturan sebelum melakukan pengeditan. *@
<div id="rulesetVersionModal"
     class="ruleset-modal-backdrop"
     role="dialog"
     aria-modal="true"
     aria-labelledby="rulesetVersionModalTitle"
     aria-hidden="true"
     style="display: none; z-index: 10000;">
    <div class="ruleset-modal-overlay" id="rulesetVersionModalOverlay"></div>
    <div class="ruleset-modal-container max-w-lg" role="document">
        <div class="ruleset-modal-header">
            <div>
                <p class="eyebrow">@Context.T("rulesets.management")</p>
                <h2 id="rulesetVersionModalTitle" class="text-xl font-bold text-slate-900 mt-1">@Context.T("rulesets.version_modal_title")</h2>
            </div>
            <button type="button"
                    class="ruleset-modal-close"
                    id="closeRulesetVersionModalBtn"
                    aria-label="@Context.T("common.close")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="ruleset-modal-body p-6">
            <div id="rulesetVersionModalLoading" class="text-center py-6 text-slate-500">
                <span class="inline-block animate-pulse">@Context.T("common.loading")</span>
            </div>
            <div id="rulesetVersionModalContent" style="display: none;">
                <p class="text-sm text-slate-600 mb-3" id="rulesetVersionModalSubtitle">
                    @Context.T("rulesets.version_modal_subtitle")
                </p>
                <div class="ruleset-version-list space-y-2 max-h-64 overflow-y-auto mb-4" id="rulesetVersionListContainer">
                </div>
                <div class="alert alert-info text-xs mt-3">
                    @Context.T("rulesets.locked_by_session_hint")
                </div>
            </div>
        </div>
        <div class="ruleset-modal-footer px-6 py-4 bg-slate-50 flex items-center justify-end gap-3 border-t border-slate-200">
            <button type="button" class="btn-ghost btn-compact" id="cancelRulesetVersionModalBtn">@Context.T("common.cancel")</button>
            <button type="button" class="btn-primary btn-compact" id="confirmRulesetVersionEditBtn" disabled>@Context.T("rulesets.continue_edit")</button>
        </div>
    </div>
</div>

<script>
    (() => {
        let activeRulesetId = null;
        let activeSelectedVersion = null;
        const modal = document.getElementById("rulesetVersionModal");
        const overlay = document.getElementById("rulesetVersionModalOverlay");
        const closeBtn = document.getElementById("closeRulesetVersionModalBtn");
        const cancelBtn = document.getElementById("cancelRulesetVersionModalBtn");
        const confirmBtn = document.getElementById("confirmRulesetVersionEditBtn");
        const loading = document.getElementById("rulesetVersionModalLoading");
        const content = document.getElementById("rulesetVersionModalContent");
        const title = document.getElementById("rulesetVersionModalTitle");
        const listContainer = document.getElementById("rulesetVersionListContainer");

        function closeModal() {
            if (modal) {
                modal.style.display = "none";
                modal.classList.remove("is-open");
                modal.setAttribute("aria-hidden", "true");
            }
            activeRulesetId = null;
            activeSelectedVersion = null;
        }

        if (closeBtn) closeBtn.addEventListener("click", closeModal);
        if (cancelBtn) cancelBtn.addEventListener("click", closeModal);
        if (overlay) overlay.addEventListener("click", closeModal);

        if (confirmBtn) {
            confirmBtn.addEventListener("click", () => {
                if (activeRulesetId && activeSelectedVersion) {
                    window.location.href = `/rulesets/${activeRulesetId}/edit?version=${activeSelectedVersion}`;
                }
            });
        }

        window.openRulesetVersionModal = function(rulesetId, rulesetName) {
            if (!rulesetId) return;
            activeRulesetId = rulesetId;
            activeSelectedVersion = null;
            if (confirmBtn) confirmBtn.disabled = true;
            if (modal) {
                modal.style.display = "flex";
                modal.classList.add("is-open");
                modal.setAttribute("aria-hidden", "false");
            }
            if (loading) {
                loading.style.display = "block";
                loading.innerHTML = `<span class="inline-block animate-pulse">@Context.T("common.loading")</span>`;
            }
            if (content) content.style.display = "none";
            if (title) {
                title.textContent = rulesetName
                    ? `@Context.T("rulesets.version_modal_title"): ${rulesetName}`
                    : `@Context.T("rulesets.version_modal_title")`;
            }

            fetch(`/rulesets/${rulesetId}/version-options`)
                .then(res => {
                    if (!res.ok) throw new Error("Fetch failed");
                    return res.json();
                })
                .then(data => {
                    if (loading) loading.style.display = "none";
                    if (content) content.style.display = "block";
                    renderVersions(data.versions || [], data.latestVersion);
                })
                .catch(() => {
                    if (loading) {
                        loading.innerHTML = `<span class="text-rose-600 font-medium">@Context.T("rulesets.failed_load_versions")</span>`;
                    }
                });
        };

        function renderVersions(versions, latestVersion) {
            if (!listContainer) return;
            listContainer.innerHTML = "";
            if (versions.length === 0) {
                listContainer.innerHTML = `<p class="text-sm text-slate-500">@Context.T("rulesets.no_versions_available")</p>`;
                return;
            }

            activeSelectedVersion = latestVersion || versions[0].version;
            if (confirmBtn) confirmBtn.disabled = false;

            versions.forEach(v => {
                const item = document.createElement("label");
                const isSelected = v.version === activeSelectedVersion;
                item.className = "flex items-center justify-between p-3 border rounded-lg cursor-pointer transition-colors " +
                    (isSelected ? "border-emerald-500 bg-emerald-50" : "border-slate-200 hover:bg-slate-50");

                const isChecked = isSelected ? "checked" : "";
                const lockedBadge = v.isUsed
                    ? `<span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-medium">@Context.T("rulesets.locked_by_session")</span>`
                    : "";
                const statusBadge = v.status === "ACTIVE"
                    ? `<span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-medium">@Context.T("status.ruleset.active")</span>`
                    : `<span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-medium">${v.status}</span>`;

                item.innerHTML = `
                    <div class="flex items-center gap-3">
                        <input type="radio" name="selectedRulesetVersionModalRadio" value="${v.version}" ${isChecked} class="text-emerald-600 focus:ring-emerald-500" />
                        <div>
                            <span class="font-semibold text-slate-900">v${v.version}</span>
                            <span class="text-xs text-slate-500 ml-2">${v.createdAt || ""}</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        ${lockedBadge}
                        ${statusBadge}
                    </div>
                `;

                item.querySelector("input").addEventListener("change", (e) => {
                    activeSelectedVersion = Number.parseInt(e.target.value, 10);
                    if (confirmBtn) confirmBtn.disabled = false;
                    listContainer.querySelectorAll("label").forEach(l => {
                        l.className = "flex items-center justify-between p-3 border rounded-lg cursor-pointer transition-colors border-slate-200 hover:bg-slate-50";
                    });
                    item.className = "flex items-center justify-between p-3 border rounded-lg cursor-pointer transition-colors border-emerald-500 bg-emerald-50";
                });

                listContainer.appendChild(item);
            });
        }
    })();
</script>
