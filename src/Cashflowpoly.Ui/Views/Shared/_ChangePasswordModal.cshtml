@* Fungsi file: Modal popup terpadu untuk mengubah password akun pengguna. *@
<div id="changePasswordModal"
     class="ruleset-modal-backdrop"
     role="dialog"
     aria-modal="true"
     aria-labelledby="changePasswordModalTitle"
     aria-hidden="true"
     style="display: none; z-index: 10000;">
    <div class="ruleset-modal-overlay" id="changePasswordModalOverlay"></div>
    <div class="ruleset-modal-container max-w-md w-full" role="document">
        <div class="ruleset-modal-header">
            <div>
                <p class="eyebrow">@Context.T("auth.account_security")</p>
                <h2 id="changePasswordModalTitle" class="text-xl font-bold text-slate-900 mt-1">@Context.T("auth.change_password_title")</h2>
            </div>
            <button type="button"
                    class="ruleset-modal-close"
                    id="closeChangePasswordModalBtn"
                    aria-label="@Context.T("common.close")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <form id="changePasswordForm" class="js-no-submit-lock" method="post" asp-controller="Auth" asp-action="ChangePassword">
            @Html.AntiForgeryToken()
            <div class="ruleset-modal-body p-6 space-y-4">
                <div id="changePasswordAlert" class="alert" style="display: none;" role="alert"></div>

                <div class="form-field">
                    <label class="auth-label" for="change-pwd-current">@Context.T("auth.current_password")</label>
                    <div class="auth-password-control">
                        <input class="auth-input"
                               id="change-pwd-current"
                               name="currentPassword"
                               type="password"
                               autocomplete="current-password"
                               required
                               placeholder="********" />
                        <button class="auth-password-toggle"
                                type="button"
                                aria-controls="change-pwd-current"
                                aria-pressed="false"
                                aria-label="@Context.T("auth.show_password")"
                                title="@Context.T("auth.show_password")"
                                data-password-toggle
                                data-show-label="@Context.T("auth.show_password")"
                                data-hide-label="@Context.T("auth.hide_password")">
                            <span class="auth-password-eye" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>

                <div class="form-field">
                    <label class="auth-label" for="change-pwd-new">@Context.T("auth.new_password")</label>
                    <div class="auth-password-control">
                        <input class="auth-input"
                               id="change-pwd-new"
                               name="newPassword"
                               type="password"
                               autocomplete="new-password"
                               required
                               minlength="12"
                               placeholder="********" />
                        <button class="auth-password-toggle"
                                type="button"
                                aria-controls="change-pwd-new"
                                aria-pressed="false"
                                aria-label="@Context.T("auth.show_password")"
                                title="@Context.T("auth.show_password")"
                                data-password-toggle
                                data-show-label="@Context.T("auth.show_password")"
                                data-hide-label="@Context.T("auth.hide_password")">
                            <span class="auth-password-eye" aria-hidden="true"></span>
                        </button>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">@Context.T("auth.password_hint")</p>
                </div>

                <div class="form-field">
                    <label class="auth-label" for="change-pwd-confirm">@Context.T("auth.confirm_new_password")</label>
                    <div class="auth-password-control">
                        <input class="auth-input"
                               id="change-pwd-confirm"
                               name="confirmPassword"
                               type="password"
                               autocomplete="new-password"
                               required
                               minlength="12"
                               placeholder="********" />
                        <button class="auth-password-toggle"
                                type="button"
                                aria-controls="change-pwd-confirm"
                                aria-pressed="false"
                                aria-label="@Context.T("auth.show_password")"
                                title="@Context.T("auth.show_password")"
                                data-password-toggle
                                data-show-label="@Context.T("auth.show_password")"
                                data-hide-label="@Context.T("auth.hide_password")">
                            <span class="auth-password-eye" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="ruleset-modal-footer px-6 py-4 bg-slate-50 flex items-center justify-end gap-3 border-t border-slate-200">
                <button type="button" class="btn-ghost btn-compact" id="cancelChangePasswordModalBtn">@Context.T("common.cancel")</button>
                <button type="submit" class="btn-primary btn-compact" id="submitChangePasswordBtn">
                    <span id="submitChangePasswordBtnText">@Context.T("auth.change_password_submit")</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (() => {
        const modal = document.getElementById("changePasswordModal");
        const overlay = document.getElementById("changePasswordModalOverlay");
        const closeBtn = document.getElementById("closeChangePasswordModalBtn");
        const cancelBtn = document.getElementById("cancelChangePasswordModalBtn");
        const openBtn = document.getElementById("openChangePasswordModalBtn");
        const form = document.getElementById("changePasswordForm");
        const alertBox = document.getElementById("changePasswordAlert");
        const submitBtn = document.getElementById("submitChangePasswordBtn");
        const submitBtnText = document.getElementById("submitChangePasswordBtnText");

        function closeModal() {
            if (modal) {
                modal.style.display = "none";
                modal.classList.remove("is-open");
                modal.setAttribute("aria-hidden", "true");
            }
            if (form) {
                form.reset();
            }
            if (alertBox) {
                alertBox.style.display = "none";
                alertBox.className = "alert";
                alertBox.textContent = "";
            }
            if (submitBtn) {
                submitBtn.disabled = false;
            }
            if (submitBtnText) {
                submitBtnText.textContent = "@Context.T("auth.change_password_submit")";
            }
        }

        function openModal() {
            if (modal) {
                modal.style.display = "flex";
                modal.classList.add("is-open");
                modal.setAttribute("aria-hidden", "false");
            }
            if (alertBox) {
                alertBox.style.display = "none";
                alertBox.className = "alert";
                alertBox.textContent = "";
            }
            const currentPwdInput = document.getElementById("change-pwd-current");
            if (currentPwdInput) {
                setTimeout(() => currentPwdInput.focus(), 50);
            }
        }

        window.openChangePasswordModal = openModal;

        if (openBtn) {
            openBtn.addEventListener("click", () => {
                const details = openBtn.closest("details");
                if (details) details.open = false;
                openModal();
            });
        }

        if (closeBtn) closeBtn.addEventListener("click", closeModal);
        if (cancelBtn) cancelBtn.addEventListener("click", closeModal);
        if (overlay) overlay.addEventListener("click", closeModal);

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && modal && modal.classList.contains("is-open")) {
                closeModal();
            }
        });

        modal?.querySelectorAll("[data-password-toggle]").forEach((btn) => {
            const inputId = btn.getAttribute("aria-controls");
            const input = inputId ? document.getElementById(inputId) : null;
            if (!(btn instanceof HTMLButtonElement) || !(input instanceof HTMLInputElement)) return;
            btn.addEventListener("click", () => {
                const isVisible = input.type === "text";
                input.type = isVisible ? "password" : "text";
                const label = isVisible ? btn.dataset.showLabel ?? "Show" : btn.dataset.hideLabel ?? "Hide";
                btn.setAttribute("aria-label", label);
                btn.title = label;
                btn.setAttribute("aria-pressed", isVisible ? "false" : "true");
            });
        });

        if (form) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                const currentPwd = document.getElementById("change-pwd-current")?.value || "";
                const newPwd = document.getElementById("change-pwd-new")?.value || "";
                const confirmPwd = document.getElementById("change-pwd-confirm")?.value || "";

                if (!currentPwd || !newPwd || !confirmPwd) {
                    showAlert("@Context.T("auth.error.change_password_required")", "error");
                    return;
                }
                if (newPwd.length < 12) {
                    showAlert("@Context.T("auth.password_hint")", "error");
                    return;
                }
                if (newPwd !== confirmPwd) {
                    showAlert("@Context.T("auth.error.confirm_mismatch")", "error");
                    return;
                }
                if (currentPwd === newPwd) {
                    showAlert("@Context.T("auth.error.password_same_as_current")", "error");
                    return;
                }

                if (submitBtn) submitBtn.disabled = true;
                if (submitBtnText) submitBtnText.textContent = "@Context.T("auth.changing_password")";
                if (alertBox) alertBox.style.display = "none";

                try {
                    const formData = new FormData(form);
                    const res = await fetch("/auth/change-password", {
                        method: "POST",
                        body: formData
                    });

                    const data = await res.json().catch(() => null);

                    if (res.ok && data?.success) {
                        showAlert(data.message || "@Context.T("auth.success.password_changed")", "success");
                        form.reset();
                        setTimeout(() => {
                            closeModal();
                        }, 1600);
                    } else {
                        const msg = data?.message || "@Context.T("auth.error.api_unavailable")";
                        showAlert(msg, "error");
                        if (submitBtn) submitBtn.disabled = false;
                        if (submitBtnText) submitBtnText.textContent = "@Context.T("auth.change_password_submit")";
                    }
                } catch {
                    showAlert("@Context.T("auth.error.api_unavailable")", "error");
                    if (submitBtn) submitBtn.disabled = false;
                    if (submitBtnText) submitBtnText.textContent = "@Context.T("auth.change_password_submit")";
                }
            });
        }

        function showAlert(msg, type) {
            if (!alertBox) return;
            alertBox.style.display = "block";
            alertBox.className = type === "success" ? "alert alert-success" : "alert alert-error";
            alertBox.textContent = msg;
        }
    })();
</script>
