@using Cashflowpoly.Ui.Models
@using Cashflowpoly.Ui.Infrastructure
@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@inject IConfiguration Configuration
@{
    var activeRole = Context.User.FindFirst(ClaimTypes.Role)?.Value;
    var activeDisplayName = Context.User.FindFirst(AuthConstants.DisplayNameClaim)?.Value;
    var activeUsername = Context.User.FindFirst(ClaimTypes.Name)?.Value;
    var isLoggedIn = Context.User.Identity?.IsAuthenticated == true;
    var isInstructor = Context.IsInstructor();
    var roleThemeClass = isLoggedIn
        ? (isInstructor ? "role-instructor" : "role-player")
        : "role-guest";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var activeLanguage = UiText.NormalizeLanguage(Context.Session.GetString(AuthConstants.SessionLanguageKey));
    var isEnglish = string.Equals(activeLanguage, AuthConstants.LanguageEn, StringComparison.OrdinalIgnoreCase);
    var languageCode = isEnglish ? Context.T("lang.code.en") : Context.T("lang.code.id");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isAuthPage = string.Equals(currentController, "Auth", StringComparison.OrdinalIgnoreCase);
    var isRulebookSection = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Rulebook", StringComparison.OrdinalIgnoreCase);
    var isLegalSection = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(currentAction, "Privacy", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "Terms", StringComparison.OrdinalIgnoreCase));
    var isHomeSection = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && !isRulebookSection
        && !isLegalSection;
    var isSessionsSection = string.Equals(currentController, "Sessions", StringComparison.OrdinalIgnoreCase);
    var isSessionListPage = isSessionsSection && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isSessionDetailPage = isSessionsSection && string.Equals(currentAction, "Details", StringComparison.OrdinalIgnoreCase);
    var isPlayersSection = string.Equals(currentController, "PlayerDirectory", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "Players", StringComparison.OrdinalIgnoreCase);
    var isRulesetsSection = string.Equals(currentController, "Rulesets", StringComparison.OrdinalIgnoreCase);
    Func<bool, string> navClass = isActive => isActive ? "nav-link is-active" : "nav-link";
    var hideFooter = ViewData["HideFooter"] as bool? ?? false;
    var hideHeader = ViewData["HideHeader"] as bool? ?? false;
    var brandName = Context.T("layout.brand_name");
    var activeRoleLabel = string.Equals(activeRole, AuthConstants.InstructorRole, StringComparison.OrdinalIgnoreCase)
        ? Context.T("auth.role_instructor")
        : string.Equals(activeRole, AuthConstants.PlayerRole, StringComparison.OrdinalIgnoreCase)
            ? Context.T("auth.role_player")
            : activeRole;
    var showQuickStartGuide = isLoggedIn && !isAuthPage && !isLegalSection;
    var quickStartTitle = isInstructor
        ? Context.T("layout.quickstart.instructor.title")
        : Context.T("layout.quickstart.player.title");
    var quickStartSubtitle = isInstructor
        ? Context.T("layout.quickstart.instructor.subtitle")
        : Context.T("layout.quickstart.player.subtitle");
    var quickStartSteps = isInstructor
        ? new[]
        {
            new
            {
                Number = 1,
                Title = Context.T("layout.quickstart.instructor.step1.title"),
                Description = Context.T("layout.quickstart.instructor.step1.desc"),
                Controller = "Rulesets",
                Action = "Index",
                IsCurrent = isRulesetsSection
            },
            new
            {
                Number = 2,
                Title = Context.T("layout.quickstart.instructor.step2.title"),
                Description = Context.T("layout.quickstart.instructor.step2.desc"),
                Controller = "Sessions",
                Action = "Index",
                IsCurrent = isSessionsSection
            },
            new
            {
                Number = 3,
                Title = Context.T("layout.quickstart.instructor.step3.title"),
                Description = Context.T("layout.quickstart.instructor.step3.desc"),
                Controller = "PlayerDirectory",
                Action = "Index",
                IsCurrent = isPlayersSection
            },
            new
            {
                Number = 4,
                Title = Context.T("layout.quickstart.instructor.step4.title"),
                Description = Context.T("layout.quickstart.instructor.step4.desc"),
                Controller = "Home",
                Action = "Rulebook",
                IsCurrent = isRulebookSection
            }
        }
        : new[]
        {
            new
            {
                Number = 1,
                Title = Context.T("layout.quickstart.player.step1.title"),
                Description = Context.T("layout.quickstart.player.step1.desc"),
                Controller = "Sessions",
                Action = "Index",
                IsCurrent = isSessionListPage
            },
            new
            {
                Number = 2,
                Title = Context.T("layout.quickstart.player.step2.title"),
                Description = Context.T("layout.quickstart.player.step2.desc"),
                Controller = "Sessions",
                Action = "Index",
                IsCurrent = isSessionDetailPage
            },
            new
            {
                Number = 3,
                Title = Context.T("layout.quickstart.player.step3.title"),
                Description = Context.T("layout.quickstart.player.step3.desc"),
                Controller = "Sessions",
                Action = "Index",
                IsCurrent = isSessionDetailPage
            },
            new
            {
                Number = 4,
                Title = Context.T("layout.quickstart.player.step4.title"),
                Description = Context.T("layout.quickstart.player.step4.desc"),
                Controller = "Home",
                Action = "Rulebook",
                IsCurrent = isRulebookSection
            }
        };
}
<!DOCTYPE html>
<html lang="@activeLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var pageTitle = string.IsNullOrEmpty(ViewData["Title"]?.ToString()) ? "Narafin" : $"Narafin | {ViewData["Title"]}";
        var metaDesc = ViewData["MetaDescription"] ?? Context.T("layout.meta_description");
        var metaKeywords = ViewData["MetaKeywords"] ?? Context.T("layout.meta_keywords");
        var robotsValue = isRulebookSection || isLegalSection
            ? "index, follow"
            : isAuthPage
                ? "noindex, follow"
                : "noindex, nofollow";
        var baseUrl = SiteUrlResolver.ResolveBaseUrl(Configuration, Context.Request);
        var currentUrl = SiteUrlResolver.BuildAbsoluteUrl(baseUrl, Context.Request.Path);
        var ogImageUrl = SiteUrlResolver.BuildAbsoluteUrl(baseUrl, "/images/images.jpg");
        var ogLocale = isEnglish ? "en_US" : "id_ID";
    }
    <title>@pageTitle</title>
    <meta name="description" content="@metaDesc" />
    <meta name="keywords" content="@metaKeywords" />
    <meta name="robots" content="@robotsValue" />
    <link rel="canonical" href="@currentUrl" />
    <meta name="category" content="technology" />
    <meta name="category" content="education" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@ogLocale" />
    <meta property="og:url" content="@currentUrl" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta property="og:site_name" content="Narafin" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="@currentUrl" />
    <meta property="twitter:title" content="@pageTitle" />
    <meta property="twitter:description" content="@metaDesc" />
    <meta property="twitter:image" content="@ogImageUrl" />
    <meta property="twitter:creator" content="@@marcellohugo__" />
    <script type="importmap"></script>
    <link rel="icon" type="image/x-icon" href="~/images/cashflowpoly-favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@roleThemeClass">
    <a class="skip-link" href="#content">@Context.T("layout.skip_to_content")</a>
    @if (!hideHeader)
    {
        <header class="sticky top-0 z-30 border-b border-white/60 bg-white/70 backdrop-blur">
            <nav class="nav-shell @(isLoggedIn ? "nav-shell-auth" : "nav-shell-guest") @(isAuthPage ? "nav-auth-page" : string.Empty)">
                <a class="nav-brand flex items-center gap-3 text-lg font-semibold text-slate-900" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="brand-mark" src="~/images/images.jpg" asp-append-version="true" alt="@Context.T("layout.logo_alt")" />
                    <div class="leading-tight">
                        <span class="brand-title">@brandName</span>
                    </div>
                </a>
                @if (!isAuthPage)
                {
                    <button class="nav-mobile-toggle js-nav-toggle"
                            type="button"
                            aria-expanded="false"
                            aria-controls="primary-nav-links"
                            aria-label="@Context.T("layout.toggle_nav")">
                        <span class="nav-mobile-toggle-line"></span>
                        <span class="nav-mobile-toggle-line"></span>
                        <span class="nav-mobile-toggle-line"></span>
                    </button>
                }
                @if (isLoggedIn)
                {
                    <div id="primary-nav-links" class="nav-pill nav-center">
                        <a class="@navClass(isHomeSection)" aria-current="@(isHomeSection ? "page" : null)" data-nav="home" asp-area="" asp-controller="Home" asp-action="Index">@Context.T("nav.home")</a>
                        <a class="@navClass(isSessionsSection)" aria-current="@(isSessionsSection ? "page" : null)" data-nav="sessions" asp-area="" asp-controller="Sessions" asp-action="Index">@Context.T("nav.sessions")</a>
                        <a class="@navClass(isPlayersSection)" aria-current="@(isPlayersSection ? "page" : null)" data-nav="players" asp-area="" asp-controller="PlayerDirectory" asp-action="Index">@Context.T("nav.players")</a>
                        @if (isInstructor)
                        {
                            <a class="@navClass(isRulesetsSection)" aria-current="@(isRulesetsSection ? "page" : null)" data-nav="rulesets" asp-area="" asp-controller="Rulesets" asp-action="Index">@Context.T("nav.ruleset")</a>
                        }
                        <a class="@navClass(isRulebookSection)" aria-current="@(isRulebookSection ? "page" : null)" data-nav="rulebook" href="/rulebook">@Context.T("nav.privacy")</a>
                    </div>

                    <div class="nav-pill nav-right">
                        <div class="nav-right-cluster">
                            <details class="nav-dropdown nav-dropdown-lang">
                                <summary class="nav-trigger" title="@(Context.T("lang.label"))" aria-label="@(Context.T("lang.label"))">
                                    <span>@languageCode</span>
                                    <span class="nav-caret">&#9662;</span>
                                </summary>
                                <div class="nav-menu lang-menu">
                                    <form method="post" asp-controller="Language" asp-action="Set">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="language" value="@AuthConstants.LanguageId" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button class="nav-menu-item @(isEnglish ? string.Empty : "active")" type="submit">@Context.T("lang.option.id")</button>
                                    </form>
                                    <form method="post" asp-controller="Language" asp-action="Set">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="language" value="@AuthConstants.LanguageEn" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button class="nav-menu-item @(isEnglish ? "active" : string.Empty)" type="submit">@Context.T("lang.option.en")</button>
                                    </form>
                                </div>
                            </details>

                            <details class="nav-dropdown nav-dropdown-profile">
                                <summary class="nav-avatar-trigger" title="@activeUsername" aria-label="@activeUsername">
                                    <img class="nav-avatar" src="~/images/images.jpg" asp-append-version="true" alt="@Context.T("layout.profile_alt")" />
                                </summary>
                                <div class="nav-menu profile-menu">
                                    <div class="profile-meta">
                                        <div class="profile-name">@(string.IsNullOrWhiteSpace(activeDisplayName) ? activeUsername : activeDisplayName)</div>
                                        <div class="profile-role">@Context.T("auth.username"): @activeUsername</div>
                                        <div class="profile-role">@Context.T("profile.role"): @activeRoleLabel</div>
                                    </div>
                                    <form method="post" asp-controller="Auth" asp-action="Logout">
                                        @Html.AntiForgeryToken()
                                        <button class="nav-menu-item nav-danger" type="submit">@Context.T("auth.logout")</button>
                                    </form>
                                </div>
                            </details>
                        </div>
                    </div>
                }
                else
                {
                    <div id="primary-nav-links" class="nav-pill nav-right">
                        <div class="nav-right-cluster">
                            <details class="nav-dropdown nav-dropdown-lang">
                                <summary class="nav-trigger" title="@(Context.T("lang.label"))" aria-label="@(Context.T("lang.label"))">
                                    <span>@languageCode</span>
                                    <span class="nav-caret">&#9662;</span>
                                </summary>
                                <div class="nav-menu lang-menu">
                                    <form method="post" asp-controller="Language" asp-action="Set">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="language" value="@AuthConstants.LanguageId" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button class="nav-menu-item @(isEnglish ? string.Empty : "active")" type="submit">@Context.T("lang.option.id")</button>
                                    </form>
                                    <form method="post" asp-controller="Language" asp-action="Set">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="language" value="@AuthConstants.LanguageEn" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button class="nav-menu-item @(isEnglish ? "active" : string.Empty)" type="submit">@Context.T("lang.option.en")</button>
                                    </form>
                                </div>
                            </details>
                        </div>
                    </div>
                }
            </nav>
        </header>
    }
    <div class="page-shell">
        @if (showQuickStartGuide)
        {
            <aside class="section-shell quickstart-shell is-collapsed"
                   data-quickstart
                   aria-label="@Context.T("layout.quickstart.aria")">
                <div class="quickstart-head">
                    <div>
                        <p class="eyebrow">@Context.T("layout.quickstart.kicker")</p>
                        <h2 class="quickstart-title">@quickStartTitle</h2>
                        <p class="subhead">@quickStartSubtitle</p>
                    </div>
                    <button class="btn-ghost btn-compact quickstart-toggle"
                            type="button"
                            data-quickstart-toggle
                            aria-expanded="false"
                            aria-controls="quickstart-guide-body"
                            data-expanded-label="@Context.T("layout.quickstart.hide")"
                            data-collapsed-label="@Context.T("layout.quickstart.show")">
                        @Context.T("layout.quickstart.show")
                    </button>
                </div>
                <div id="quickstart-guide-body" class="quickstart-body" data-quickstart-body hidden>
                    <ol class="quickstart-steps">
                        @foreach (var step in quickStartSteps)
                        {
                            <li class="quickstart-step @(step.IsCurrent ? "is-current" : string.Empty)">
                                <span class="quickstart-step-index">@step.Number</span>
                                <div class="quickstart-step-content">
                                    <p class="quickstart-step-title">@step.Title</p>
                                    <p class="quickstart-step-desc">@step.Description</p>
                                    @if (step.IsCurrent)
                                    {
                                        <span class="quickstart-step-flag">@Context.T("layout.quickstart.current")</span>
                                    }
                                    else
                                    {
                                        <a class="quickstart-step-link"
                                           asp-controller="@step.Controller"
                                           asp-action="@step.Action">@Context.T("layout.quickstart.open_menu")</a>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                </div>
            </aside>
        }
        <main id="content" role="main" class="space-y-6">
            @RenderBody()
        </main>
    </div>

    @if (!hideFooter)
    {
        <footer class="border-t border-white/70">
            <div class="footer-shell">
                <span>&copy; @DateTime.Now.Year - @brandName</span>
                <nav class="footer-links" aria-label="@Context.T("footer.legal_navigation")">
                    <a class="hover:text-slate-700" href="/privacy">@Context.T("footer.privacy")</a>
                    <a class="hover:text-slate-700" href="/terms">@Context.T("footer.terms")</a>
                    <a class="hover:text-slate-700" href="/rulebook#rulebook-copyright">@Context.T("footer.rulebook_copyright")</a>
                </nav>
            </div>
        </footer>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
