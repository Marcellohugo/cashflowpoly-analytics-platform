@* Fungsi file: Menampilkan halaman galat dengan status HTTP dan navigasi pemulihan. *@
@model ErrorViewModel
@{
    ViewData["Title"] = Context.T("error.title");
    var statusKey = Model.StatusCode is 403 or 404 or 503 ? Model.StatusCode.ToString() : "500";
}
<section class="section-shell">
    <header class="page-intro">
        <div class="page-intro-main">
            <p class="eyebrow">@Model.StatusCode</p>
            <h1 class="headline">@Context.T($"error.{statusKey}.title")</h1>
            <p class="subhead">@Context.T($"error.{statusKey}.description")</p>
        </div>
    </header>
    <div class="action-toolbar mt-4">
        <a class="btn-primary" asp-controller="Sessions" asp-action="Index">@Context.T("nav.sessions")</a>
        <a class="btn-ghost" asp-controller="Home" asp-action="Index">@Context.T("nav.home")</a>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="subhead mt-4">@Context.T("error.request_id"): <code>@Model.RequestId</code></p>
    }
</section>
