@* Fungsi file: Menampilkan halaman rincian set aturan dengan isi yang sama seperti popup sesi. *@
@model Cashflowpoly.Ui.Models.RulesetDetailViewModel

@{
    ViewData["Title"] = Context.T("rulesets.detail_title");
}

<section class="section-shell">
    <div class="page-intro">
        <div class="page-intro-main">
            <p class="eyebrow">@Context.T("rulesets.management")</p>
            <h1 class="headline">@Context.T("rulesets.detail_title")</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mt-4 alert alert-error" aria-live="polite">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
    {
        <div class="mt-4 alert alert-info" aria-live="polite">@Model.InfoMessage</div>
    }

    <div class="mt-4">
        @await Html.PartialAsync("_RulesetDetailContent", Model)
    </div>
</section>
