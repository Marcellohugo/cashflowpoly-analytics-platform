@* Fungsi file: Merender tampilan Razor untuk bagian Rulesets/Create.cshtml beserta interaksi presentasinya. *@
@model Cashflowpoly.Ui.Models.CreateRulesetViewModel

@{
    var isEditMode = Model.IsEditMode && Model.RulesetId.HasValue;
    var formActionUrl = isEditMode
        ? Url.Action("Edit", "Rulesets", new { rulesetId = Model.RulesetId })
        : Url.Action("Create", "Rulesets");
    ViewData["Title"] = isEditMode ? Context.T("rulesets.edit_title") : Context.T("rulesets.create");
}

<section class="section-shell">
    <div class="action-toolbar mb-4">
        @if (isEditMode)
        {
            <a class="btn-ghost"
               asp-controller="Rulesets"
               asp-action="Details"
               asp-route-rulesetId="@Model.RulesetId">@("<- " + Context.T("rulesets.back_to_list"))</a>
        }
        else
        {
            <a class="btn-ghost" asp-controller="Rulesets" asp-action="Index">@("<- " + Context.T("rulesets.back_to_list"))</a>
        }
    </div>

    <div class="page-intro">
        <div class="page-intro-main">
            <p class="eyebrow">@Context.T("rulesets.management")</p>
            <h1 class="headline">@(isEditMode ? Context.T("rulesets.edit_title") : Context.T("rulesets.create_title"))</h1>
            <p class="subhead">@(isEditMode ? Context.T("rulesets.edit_subtitle") : Context.T("rulesets.create_subtitle"))</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mt-4 alert alert-error" aria-live="polite">
            @Model.ErrorMessage
        </div>
    }

    <div class="mt-6 ruleset-unified">
        <section class="ruleset-form-section">
            <details class="mt-3 data-toggle">
                <summary>@Context.T("rulesets.tips.form_title")</summary>
                <div class="mt-3 metric-panel">
                    <div class="metric-list">
                        <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 1</span><span class="metric-value">@Context.T("rulesets.tip.versioning_draft")</span></div>
                        <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 2</span><span class="metric-value">@Context.T("rulesets.tip.consistency")</span></div>
                        <div class="metric-row"><span class="metric-key">@Context.T("sessions.step") 3</span><span class="metric-value">@Context.T("rulesets.tip.safety_before_start")</span></div>
                    </div>
                </div>
            </details>
        </section>

        <form class="mt-4 form-grid ruleset-create-form" method="post" action="@formActionUrl" data-ruleset-create-form data-ruleset-mode="pemula">
            @Html.AntiForgeryToken()
            <div class="form-field">
                <label class="form-label" for="ruleset-name">@Context.T("common.name")</label>
                <input class="form-input"
                       id="ruleset-name"
                       asp-for="Name"
                       required />
            </div>
            <div class="form-field">
                <label class="form-label" for="ruleset-description">@Context.T("common.description")</label>
                <input class="form-input"
                       id="ruleset-description"
                       asp-for="Description"
                       placeholder="@Context.T("rulesets.form.description_placeholder")" />
                <p class="mt-1 text-xs text-slate-500">@Context.T("rulesets.form.description_hint")</p>
            </div>

            <div class="ruleset-form-section">
                <div class="ruleset-section-head">
                    <p class="ruleset-section-title">@Context.T("rulesets.form.core_setup")</p>
                    <p class="ruleset-section-subtitle">@Context.T("rulesets.form.help.core_setup")</p>
                </div>
                <div class="grid gap-3 md:grid-cols-2 mt-3">
                    <fieldset class="md:col-span-2">
                        <legend class="sr-only">@Context.T("rulesets.form.mode")</legend>
                        <div class="ruleset-section-head">
                            <p class="ruleset-section-title">@Context.T("rulesets.form.mode")</p>
                            <p class="ruleset-section-subtitle ruleset-mode-picker-hint">@Context.T("rulesets.form.mode_choice_hint")</p>
                        </div>
                        <div class="ruleset-mode-picker mt-2">
                            <label class="ruleset-mode-option ruleset-mode-option--beginner">
                                <input class="ruleset-mode-radio" type="radio" name="cfg-mode" value="PEMULA" checked />
                                <span class="ruleset-mode-option-content">
                                    <span class="ruleset-mode-badge ruleset-mode-badge--beginner">@Context.T("rulesets.form.mode_beginner")</span>
                                    <span class="ruleset-mode-option-copy">@Context.T("rulesets.quick_guide_beginner")</span>
                                </span>
                            </label>
                            <label class="ruleset-mode-option ruleset-mode-option--advanced">
                                <input class="ruleset-mode-radio" type="radio" name="cfg-mode" value="MAHIR" />
                                <span class="ruleset-mode-option-content">
                                    <span class="ruleset-mode-badge ruleset-mode-badge--advanced">@Context.T("rulesets.form.mode_advanced")</span>
                                    <span class="ruleset-mode-option-copy">@Context.T("rulesets.quick_guide_advanced")</span>
                                </span>
                            </label>
                        </div>
                    </fieldset>
                    <div>
                        <label class="form-label" for="cfg-actions">@Context.T("rulesets.form.actions_per_turn")</label>
                        <input id="cfg-actions" type="number" min="1" class="form-input" value="2" />
                    </div>
                    <div>
                        <label class="form-label" for="cfg-cash">@Context.T("rulesets.form.starting_cash")</label>
                        <input id="cfg-cash" type="number" min="0" class="form-input" value="20" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="form-label" for="cfg-player-ordering-display">@Context.T("rulesets.form.player_ordering")</label>
                        <input id="cfg-player-ordering-display"
                               type="text"
                               readonly
                               class="form-input"
                               value="@Context.T("rulesets.form.player_ordering_player_order")" />
                        <input id="cfg-player-ordering" type="hidden" value="PLAYER_ORDER" />
                        <p class="mt-1 text-xs text-slate-500">@Context.T("rulesets.form.player_ordering_fixed_hint")</p>
                    </div>
                    <div>
                        <label class="form-label" for="cfg-freelance-income">@Context.T("rulesets.form.freelance_income")</label>
                        <input id="cfg-freelance-income" type="number" min="0" class="form-input" value="1" />
                    </div>
                </div>
            </div>

            <div class="ruleset-form-section">
                <div class="ruleset-section-head">
                    <p class="ruleset-section-title">@Context.T("rulesets.form.weekday_features")</p>
                    <p class="ruleset-section-subtitle">@Context.T("rulesets.form.help.weekday_features")</p>
                </div>
                <div class="grid gap-3 md:grid-cols-3 mt-3">
                    <label class="metric-row"><span class="metric-key">@Context.T("rulesets.form.friday_donation")</span><input id="cfg-friday" type="checkbox" checked /></label>
                    <label class="metric-row"><span class="metric-key">@Context.T("rulesets.form.saturday_gold_trade")</span><input id="cfg-saturday" type="checkbox" checked /></label>
                    <label class="metric-row"><span class="metric-key">@Context.T("rulesets.form.sunday_rest")</span><input id="cfg-sunday" type="checkbox" checked /></label>
                </div>
            </div>

            <div class="ruleset-form-section">
                <div class="ruleset-section-head">
                    <p class="ruleset-section-title">@Context.T("rulesets.form.constraints")</p>
                    <p class="ruleset-section-subtitle">@Context.T("rulesets.form.help.constraints")</p>
                </div>
                <div class="grid gap-3 md:grid-cols-2 mt-3">
                    <div>
                        <label class="form-label" for="cfg-cash-min">@Context.T("rulesets.form.cash_min")</label>
                        <input id="cfg-cash-min" type="number" class="form-input" value="0" />
                    </div>
                    <div>
                        <label class="form-label" for="cfg-max-ing-total">@Context.T("rulesets.form.max_ingredient_total")</label>
                        <input id="cfg-max-ing-total" type="number" min="1" class="form-input" value="6" />
                    </div>
                    <div>
                        <label class="form-label" for="cfg-max-same-ing">@Context.T("rulesets.form.max_same_ingredient")</label>
                        <input id="cfg-max-same-ing" type="number" min="1" class="form-input" value="3" />
                    </div>
                </div>
            </div>

            <div class="ruleset-form-section">
                <div class="ruleset-section-head">
                    <p class="ruleset-section-title">@Context.T("rulesets.form.economy_and_donation")</p>
                    <p class="ruleset-section-subtitle">@Context.T("rulesets.form.help.economy_and_donation")</p>
                </div>
                <div class="grid gap-3 md:grid-cols-2 mt-3">
                    <div>
                        <label class="form-label" for="cfg-donation-min">@Context.T("rulesets.form.donation_min")</label>
                        <input id="cfg-donation-min" type="number" min="1" class="form-input" value="1" />
                    </div>
                    <div>
                        <label class="form-label" for="cfg-donation-max">@Context.T("rulesets.form.donation_max")</label>
                        <input id="cfg-donation-max" type="number" min="1" class="form-input" value="999999" />
                    </div>
                    <label class="metric-row"><span class="metric-key">@Context.T("rulesets.form.gold_buy")</span><input id="cfg-gold-buy" type="checkbox" checked /></label>
                    <label class="metric-row"><span class="metric-key">@Context.T("rulesets.form.gold_sell")</span><input id="cfg-gold-sell" type="checkbox" checked /></label>
                    <div class="ruleset-advanced-feature-grid md:col-span-2" data-ruleset-advanced-features hidden>
                        <div class="ruleset-advanced-feature-head">
                            <span class="ruleset-mode-badge ruleset-mode-badge--advanced">@Context.T("rulesets.form.mode_advanced")</span>
                            <p>@Context.T("rulesets.form.advanced_features_hint")</p>
                        </div>
                        <div class="grid gap-3 md:grid-cols-3 mt-3">
                            <label class="metric-row"><span class="metric-key">@Context.T("rulesets.form.loan_enabled")</span><input id="cfg-adv-loan" type="checkbox" disabled /></label>
                            <label class="metric-row"><span class="metric-key">@Context.T("rulesets.form.insurance_enabled")</span><input id="cfg-adv-insurance" type="checkbox" disabled /></label>
                            <label class="metric-row"><span class="metric-key">@Context.T("rulesets.form.saving_goal_enabled")</span><input id="cfg-adv-saving-goal" type="checkbox" disabled /></label>
                        </div>
                    </div>
                </div>
            </div>

            <textarea asp-for="DefinitionJson" class="hidden"></textarea>
            <div class="form-actions">
                <button class="btn-primary"
                        type="submit">@(isEditMode ? Context.T("rulesets.update") : Context.T("rulesets.save"))</button>
                @if (isEditMode)
                {
                    <a class="text-link"
                       asp-controller="Rulesets"
                       asp-action="Details"
                       asp-route-rulesetId="@Model.RulesetId">@Context.T("common.cancel")</a>
                }
                else
                {
                    <a class="text-link" asp-controller="Rulesets" asp-action="Index">@Context.T("common.cancel")</a>
                }
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const getEl = (id) => document.getElementById(id);
            const toInt = (id, fallback = 0) => {
                const v = parseInt(getEl(id)?.value ?? "", 10);
                return Number.isFinite(v) ? v : fallback;
            };
            const toBool = (id) => !!getEl(id)?.checked;
            const configTextArea = getEl("DefinitionJson");
            const formEl = document.querySelector("[data-ruleset-create-form]");
            const modeInputs = Array.from(document.querySelectorAll('input[name="cfg-mode"]'));
            const getMode = () => modeInputs.find((input) => input.checked)?.value ?? "PEMULA";
            const advancedFeaturePanel = document.querySelector("[data-ruleset-advanced-features]");
            const advancedFeatureInputs = [getEl("cfg-adv-loan"), getEl("cfg-adv-insurance"), getEl("cfg-adv-saving-goal")];
            const modePresets = {
                PEMULA: {
                    starting_cash: 20,
                    loan_enabled: false,
                    insurance_enabled: false,
                    saving_goal_enabled: false
                },
                MAHIR: {
                    starting_cash: 10,
                    loan_enabled: true,
                    insurance_enabled: true,
                    saving_goal_enabled: true
                }
            };

            const scoreDefaults = {
                donation_rank_points: [{ rank: 1, points: 7 }, { rank: 2, points: 5 }, { rank: 3, points: 2 }],
                gold_points_by_qty: [{ qty: 1, points: 3 }, { qty: 2, points: 5 }, { qty: 3, points: 8 }, { qty: 4, points: 12 }],
                pension_rank_points: [{ rank: 1, points: 5 }, { rank: 2, points: 3 }, { rank: 3, points: 1 }]
            };

            const readForm = () => ({
                mode: getMode(),
                actions_per_turn: toInt("cfg-actions", 2),
                starting_cash: toInt("cfg-cash", 20),
                player_ordering: "PLAYER_ORDER",
                weekday_rules: {
                    friday: { feature: "DONATION", enabled: toBool("cfg-friday") },
                    saturday: { feature: "GOLD_TRADE", enabled: toBool("cfg-saturday") },
                    sunday: { feature: "REST", enabled: toBool("cfg-sunday") }
                },
                constraints: {
                    cash_min: toInt("cfg-cash-min", 0),
                    max_ingredient_total: toInt("cfg-max-ing-total", 6),
                    max_same_ingredient: toInt("cfg-max-same-ing", 3),
                    primary_need_max_per_day: null,
                    require_primary_before_others: true
                },
                donation: {
                    min_amount: toInt("cfg-donation-min", 1),
                    max_amount: toInt("cfg-donation-max", 999999)
                },
                gold_trade: {
                    allow_buy: toBool("cfg-gold-buy"),
                    allow_sell: toBool("cfg-gold-sell")
                },
                advanced: {
                    loan: { enabled: getMode() === "MAHIR" && toBool("cfg-adv-loan") },
                    insurance: { enabled: getMode() === "MAHIR" && toBool("cfg-adv-insurance") },
                    saving_goal: { enabled: getMode() === "MAHIR" && toBool("cfg-adv-saving-goal") }
                },
                freelance: { income: toInt("cfg-freelance-income", 1) },
                scoring: scoreDefaults
            });

            const writeFormFromConfig = (cfg) => {
                if (!cfg || typeof cfg !== "object") return;
                const resolvedMode = `${cfg.mode ?? "PEMULA"}`.toUpperCase();
                modeInputs.forEach((input) => {
                    input.checked = input.value === resolvedMode;
                });
                getEl("cfg-actions").value = cfg.actions_per_turn ?? 2;
                getEl("cfg-cash").value = cfg.starting_cash ?? 20;
                getEl("cfg-freelance-income").value = cfg.freelance?.income ?? 1;
                getEl("cfg-friday").checked = !!cfg.weekday_rules?.friday?.enabled;
                getEl("cfg-saturday").checked = !!cfg.weekday_rules?.saturday?.enabled;
                getEl("cfg-sunday").checked = !!cfg.weekday_rules?.sunday?.enabled;
                getEl("cfg-cash-min").value = cfg.constraints?.cash_min ?? 0;
                getEl("cfg-max-ing-total").value = cfg.constraints?.max_ingredient_total ?? 6;
                getEl("cfg-max-same-ing").value = cfg.constraints?.max_same_ingredient ?? 3;
                getEl("cfg-donation-min").value = cfg.donation?.min_amount ?? 1;
                getEl("cfg-donation-max").value = cfg.donation?.max_amount ?? 999999;
                getEl("cfg-gold-buy").checked = cfg.gold_trade?.allow_buy ?? true;
                getEl("cfg-gold-sell").checked = cfg.gold_trade?.allow_sell ?? true;
                getEl("cfg-adv-loan").checked = !!cfg.advanced?.loan?.enabled;
                getEl("cfg-adv-insurance").checked = !!cfg.advanced?.insurance?.enabled;
                getEl("cfg-adv-saving-goal").checked = !!cfg.advanced?.saving_goal?.enabled;
                setAdvancedFeatureAvailability(resolvedMode);
            };

            const setAdvancedFeatureAvailability = (mode) => {
                const isAdvanced = `${mode ?? ""}`.toUpperCase() === "MAHIR";
                if (advancedFeaturePanel) {
                    advancedFeaturePanel.hidden = !isAdvanced;
                    advancedFeaturePanel.setAttribute("aria-hidden", `${!isAdvanced}`);
                }
                advancedFeatureInputs.forEach((input) => {
                    if (!input) return;
                    input.disabled = !isAdvanced;
                    if (!isAdvanced) input.checked = false;
                });
            };

            const applyModePreset = (mode) => {
                const preset = modePresets[`${mode ?? ""}`.toUpperCase()];
                if (!preset) return;
                getEl("cfg-cash").value = preset.starting_cash;
                getEl("cfg-adv-loan").checked = preset.loan_enabled;
                getEl("cfg-adv-insurance").checked = preset.insurance_enabled;
                getEl("cfg-adv-saving-goal").checked = preset.saving_goal_enabled;
                setAdvancedFeatureAvailability(mode);
            };

            const refreshConfig = () => {
                const cfg = readForm();
                if (formEl) formEl.dataset.rulesetMode = cfg.mode.toLowerCase();
                const json = JSON.stringify(cfg, null, 2);
                configTextArea.value = json;
            };

            try {
                if (configTextArea?.value?.trim()) {
                    writeFormFromConfig(JSON.parse(configTextArea.value));
                }
            } catch (_) {}

            setAdvancedFeatureAvailability(getMode());

            document.querySelectorAll("input, select").forEach((el) => {
                el.addEventListener("input", refreshConfig);
                el.addEventListener("change", refreshConfig);
            });

            modeInputs.forEach((input) => {
                input.addEventListener("change", () => {
                    if (!input.checked) return;
                    applyModePreset(input.value);
                    refreshConfig();
                });
            });

            refreshConfig();
        })();
    </script>
}
