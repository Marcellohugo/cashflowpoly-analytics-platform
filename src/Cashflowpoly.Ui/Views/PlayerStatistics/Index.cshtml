@* Fungsi file: Menampilkan grafik, arti nilai, dan rincian statistik pemain dari analitika sesi. *@
@using System.Text.Json
@model PlayerStatisticsViewModel
@{
    ViewData["Title"] = Context.T("statistics.title");
    var available = Model.Sessions.Count(s => s.Gameplay is not null);
    var groupKeys = new[] { "overview", "money", "play", "future", "happiness" };
    var sessionsLoaded = Model.TotalSessions.HasValue || Model.Sessions.Count > 0;
}
@section Head {
    <link rel="stylesheet" href="~/css/player-statistics.css" asp-append-version="true" />
}
<section class="section-shell player-statistics" aria-labelledby="statistics-title">
    @if (Model.Sessions.Any(s => s.Gameplay?.HasSealedDonations == true))
    {
        <p class="alert alert-info" role="status">@Context.T("analytics.sealed_donations")</p>
    }

    <header class="page-intro">
        <div class="page-intro-main">
            <p class="eyebrow">@Context.T("statistics.kicker")</p>
            <h1 class="headline" id="statistics-title">@Context.T("statistics.title")</h1>
            <p class="subhead">@Context.T(Context.IsInstructor() ? "statistics.subtitle.instructor" : "statistics.subtitle")</p>
        </div>
    </header>

    <section class="statistics-tips-section mt-4">
        <details class="mt-3 data-toggle">
            <summary>@Context.T("statistics.reading_title")</summary>
            <div class="mt-3 metric-panel">
                <div class="metric-list">
                    @for (var step = 1; step <= 3; step++)
                    {
                        <div class="metric-row">
                            <span class="metric-key">@Context.T("sessions.step") @step</span>
                            <span class="metric-value">@Context.T("statistics.tips.step" + step)</span>
                        </div>
                    }
                </div>
            </div>
        </details>
    </section>
    <form class="ruleset-quick-tools statistics-filters" method="get" asp-controller="PlayerStatistics" asp-action="Index">
        <div class="ruleset-section-head">
            <h2 class="ruleset-section-title">@Context.T("statistics.filters")</h2>
            <p class="ruleset-section-subtitle">@Context.T("statistics.mode_hint")</p>
        </div>
        <div class="ruleset-quick-tools-controls statistics-filter-controls">
        @if (Context.IsInstructor())
        {
            <div class="form-field">
                <label class="form-label" for="statistics-player">@Context.T("statistics.player")</label>
                <div class="statistics-search-wrap">
                    <svg class="statistics-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input class="form-input statistics-search-input" id="statistics-player" type="search" list="statistics-players" autocomplete="off"
                           value="@Model.PlayerName" required disabled="@(Model.AvailablePlayers.Count == 0)"
                           placeholder="@Context.T("statistics.search_player")" data-invalid-player="@Context.T("statistics.choose_player")" />
                    <input type="hidden" name="playerId" value="@(Model.PlayerId == Guid.Empty ? "" : Model.PlayerId.ToString())" />
                </div>
                <datalist id="statistics-players">
                    @foreach (var player in Model.AvailablePlayers)
                    {
                        var sameName = Model.AvailablePlayers.Count(p => string.Equals(p.DisplayName.Trim(), player.DisplayName.Trim(), StringComparison.OrdinalIgnoreCase)) > 1;
                        <option value="@(sameName ? player.DisplayName + " (" + player.UserId + ")" : player.DisplayName)" data-player-id="@player.UserId"></option>
                    }
                </datalist>
            </div>
        }
        <div class="form-field">
            <label class="form-label" for="statistics-mode">@Context.T("statistics.mode")</label>
            <select class="form-input" id="statistics-mode" name="mode">
                <option value="PEMULA" selected="@(Model.Mode == "PEMULA")">@Context.T("statistics.mode.pemula")</option>
                <option value="MAHIR" selected="@(Model.Mode == "MAHIR")">@Context.T("statistics.mode.mahir")</option>
            </select>
        </div>
        <button class="btn-primary" type="submit">@Context.T("statistics.apply")</button>
        </div>
    </form>
    @if (Model.ErrorMessage is not null)
    {
        <p class="alert alert-error" role="alert">@Model.ErrorMessage</p>
    }
    @if (Context.IsInstructor() && Model.PlayerId == Guid.Empty)
    {
        <div class="statistics-empty">
            <h2>@Context.T("statistics.choose_player_title")</h2>
            <p>@Context.T("statistics.choose_player_hint")</p>
        </div>
    }
    else if (sessionsLoaded && Model.Sessions.Count == 0)
    {
        <div class="statistics-empty">
            <h2>@Context.T(Model.TotalSessions == 0 ? "statistics.empty_title" : "statistics.no_match")</h2>
            <p>@Context.T(Model.TotalSessions == 0 ? (Context.IsInstructor() ? "statistics.empty_hint.instructor" : "statistics.empty_hint") : "statistics.filter_hint")</p>
        </div>
    }
    else if (Model.Sessions.Count > 0)
    {
        @if (Context.IsInstructor() && !string.IsNullOrWhiteSpace(Model.PlayerName))
        {
            <div class="statistics-selected-player">
                <div class="statistics-selected-player-name">
                    <span class="eyebrow">@Context.T("statistics.selected_player")</span>
                    <strong>@Model.PlayerName</strong>
                </div>
                <span class="hint-chip">@Context.T("statistics.mode"): <strong>@Context.T("statistics.mode." + Model.Mode.ToLowerInvariant())</strong></span>
            </div>
        }
        <nav class="statistics-jump" aria-label="@Context.T("statistics.sections")">
            @foreach (var key in groupKeys.Where(key => Model.Charts.Any(c => c.Group == key)))
            {
                <button type="button" class="btn-ghost" data-statistics-panel="statistics-@key" aria-controls="statistics-@key" aria-expanded="@(key == "overview" ? "true" : "false")">@Context.T("statistics.group." + key)</button>
            }
        </nav>
        @foreach (var key in groupKeys)
        {
            var charts = Model.Charts.Where(c => c.Group == key).ToList();
            if (charts.Count == 0) { continue; }
            <section class="statistics-chapter" data-statistics-section hidden="@(key != "overview")" id="statistics-@key" aria-labelledby="statistics-heading-@key">
                <div class="ruleset-section-head statistics-chapter-heading">
                    <h2 class="ruleset-section-title" id="statistics-heading-@key">@Context.T("statistics.group." + key)</h2>
                    <p class="ruleset-section-subtitle">@Context.T("statistics.group_hint." + key)</p>
                </div>
                <div class="statistics-chart-grid">
                    @foreach (var chart in charts)
                    {
                        var last = chart.Points.LastOrDefault(p => p.Value.HasValue);
                        <article class="chart-card statistics-chart" data-statistics-metric="@chart.Key">
                            <h3 id="chart-@chart.Key">@chart.Title</h3>
                            <div class="statistics-chart-frame">
                                <div class="statistics-chart-plot" role="region" aria-labelledby="chart-@chart.Key">
                                    <svg class="js-metric-line-chart" viewBox="0 0 840 340" data-chart-responsive data-chart="@chart.Json" role="img" aria-labelledby="chart-@chart.Key"></svg>
                                </div>
                                <div class="statistics-chart-axis" aria-hidden="true"></div>
                                <p class="statistics-chart-scroll-hint">@Context.T("statistics.scroll_hint")</p>
                            </div>
                            <div class="chart-bar-insight js-chart-bar-insight statistics-point-detail" hidden aria-live="polite" aria-atomic="true">
                                <div class="statistics-point-heading">
                                    <div class="statistics-point-session">
                                        <span class="eyebrow js-chart-bar-insight-metric"></span>
                                        <p class="statistics-point-session-name js-chart-bar-insight-session"></p>
                                    </div>
                                    <div class="statistics-point-result">
                                        <span class="statistics-point-label">@chart.Title</span>
                                        <p class="statistics-point-amount"><strong class="js-chart-bar-insight-points"></strong><span class="js-chart-bar-insight-unit"></span></p>
                                    </div>
                                </div>
                                <div class="statistics-point-explanation">
                                    <p class="statistics-point-label">@Context.T("statistics.read_value")</p>
                                    <p class="js-chart-bar-insight-formula"></p>
                                </div>
                            </div>
                            <details class="statistics-chart-detail">
                                <summary>@Context.T("statistics.values_and_source")</summary>
                                <p>@chart.Source</p>
                                @if (last is not null && !string.IsNullOrWhiteSpace(last.Presentation.Formula))
                                {
                                    <p>@last.Presentation.Formula</p>
                                }
                                <div class="statistics-table-wrap">
                                    <table id="statistics-table-@chart.Key">
                                        <caption>@chart.Title — @Context.T("statistics.values_per_session")</caption>
                                        <thead><tr><th scope="col">@Context.T("statistics.session")</th><th scope="col">@Context.T("common.value")</th><th scope="col">@Context.T("statistics.meaning")</th></tr></thead>
                                        <tbody>
                                            @for (var row = 0; row < chart.Points.Count; row++)
                                            {
                                                var point = chart.Points[row];
                                                <tr hidden="@(row >= 5)"><th scope="row">@point.Label</th><td>@point.Presentation.DisplayValue @point.Presentation.Unit</td><td>@point.Presentation.Guidance</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <nav class="statistics-pagination" aria-label="@chart.Title — @Context.T("statistics.table_pages")" data-statistics-pagination data-page-status="@Context.T("statistics.page_status")">
                                    <span role="status" aria-live="polite" data-page-status-text></span>
                                    <button type="button" class="btn-ghost" data-page-back aria-controls="statistics-table-@chart.Key" disabled>@Context.T("statistics.page_back")</button>
                                    <button type="button" class="btn-ghost" data-page-next aria-controls="statistics-table-@chart.Key" disabled="@(chart.Points.Count <= 5)">@Context.T("rulesets.pagination_next")</button>
                                </nav>
                            </details>
                        </article>
                    }
                </div>
            </section>
        }
    }
</section>
@section Scripts {
    <script>
        window.cashflowpolyPlayerDetailCharts = @Html.Raw(JsonSerializer.Serialize(new {
            tooltipText = new { metric = Context.T("statistics.session_ordinal_prefix"), series = Context.T("statistics.session_ordinal_prefix"), points = Context.T("common.value"), formula = Context.T("statistics.meaning"), defaultFormula = Context.T("statistics.source"), selectedDetail = Context.T("statistics.selected_point"), tapHint = Context.T("statistics.tap_hint"), itemPrefix = Context.T("statistics.session_ordinal_prefix") },
            chartStatusText = new { noSeries = Context.T("statistics.no_numeric"), noPoints = Context.T("statistics.no_numeric"), invalidPayload = Context.T("statistics.error.partial") }
        }));
    </script>
    <script src="~/js/player-statistics.js" asp-append-version="true"></script>
    <script src="~/js/player-detail-charts.js" asp-append-version="true"></script>
}
