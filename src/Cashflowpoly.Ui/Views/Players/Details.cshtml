@* Fungsi file: Merender tampilan Razor untuk bagian Players/Details.cshtml beserta interaksi presentasinya. *@
@using System.Globalization
@using System.Text.Json
@using Cashflowpoly.Ui.Infrastructure
@model Cashflowpoly.Ui.Models.PlayerDetailViewModel

@{
    ViewData["Title"] = Context.T("players.detail_title");

    string LocalizeTransactionDetail(string rawDetail)
    {
        return PlayerMetricLabelFormatter.LocalizeTransactionDetail(rawDetail, Context.T);
    }

    static List<(string Path, string Value)> MergeUniqueRows(params IEnumerable<(string Path, string Value)>[] rowSets)
    {
        return PlayerMetricCollectionHelper.MergeUniqueRows(rowSets);
    }

    static List<(string Path, string Value)> GetGroupRows(
        Dictionary<string, List<(string Path, string Value)>> source,
        params string[] keys)
    {
        return PlayerMetricCollectionHelper.GetGroupRows(source, keys);
    }

    static List<(string Path, string Value)> FilterRowsByKeywords(
        IEnumerable<(string Path, string Value)> rows,
        params string[] keywords)
    {
        return PlayerMetricCollectionHelper.FilterRowsByKeywords(rows, keywords);
    }

    static int ResolvePlayerAvatarIndex(int turnOrder)
    {
        if (turnOrder <= 0)
        {
            return 1;
        }

        return ((turnOrder - 1) % 4) + 1;
    }

    var trueText = Context.T("state.true");
    var falseText = Context.T("state.false");
    var nullText = Context.T("state.null");
    var rawGroups = PlayerMetricJsonMapper.BuildMetricGroups(Model.GameplayRaw, trueText, falseText, nullText);
    var derivedGroups = PlayerMetricJsonMapper.BuildMetricGroups(Model.GameplayDerived, trueText, falseText, nullText);
    var rawGroupMap = rawGroups.ToDictionary(item => item.GroupKey, item => item.Rows, StringComparer.OrdinalIgnoreCase);
    var derivedGroupMap = derivedGroups.ToDictionary(item => item.GroupKey, item => item.Rows, StringComparer.OrdinalIgnoreCase);
    var mappedRawKeys = new HashSet<string>(
        new[] { "coins", "ingredients", "meal_orders", "needs", "donations", "gold", "pension", "life_risk", "financial_goals", "actions", "turns" },
        StringComparer.OrdinalIgnoreCase);
    var rawFallbackKeys = rawGroupMap.Keys.Where(key => !mappedRawKeys.Contains(key)).ToArray();

    var part11Rows = MergeUniqueRows(
        GetGroupRows(rawGroupMap, "turns"),
        GetGroupRows(rawGroupMap, rawFallbackKeys));

    var rawSections = new List<(string Title, string Description, List<(string Path, string Value)> Rows)>
    {
        (
            Context.T("players.details.raw.coin_finance.title"),
            Context.T("players.details.raw.coin_finance.desc"),
            GetGroupRows(rawGroupMap, "coins")),
        (
            Context.T("players.details.raw.ingredients.title"),
            Context.T("players.details.raw.ingredients.desc"),
            GetGroupRows(rawGroupMap, "ingredients")),
        (
            Context.T("players.details.raw.meal_orders.title"),
            Context.T("players.details.raw.meal_orders.desc"),
            GetGroupRows(rawGroupMap, "meal_orders")),
        (
            Context.T("players.details.raw.needs.title"),
            Context.T("players.details.raw.needs.desc"),
            GetGroupRows(rawGroupMap, "needs")),
        (
            Context.T("players.details.raw.donations.title"),
            Context.T("players.details.raw.donations.desc"),
            GetGroupRows(rawGroupMap, "donations")),
        (
            Context.T("players.details.raw.gold.title"),
            Context.T("players.details.raw.gold.desc"),
            GetGroupRows(rawGroupMap, "gold")),
        (
            Context.T("players.details.raw.pension.title"),
            Context.T("players.details.raw.pension.desc"),
            GetGroupRows(rawGroupMap, "pension")),
        (
            Context.T("players.details.raw.life_risk.title"),
            Context.T("players.details.raw.life_risk.desc"),
            GetGroupRows(rawGroupMap, "life_risk")),
        (
            Context.T("players.details.raw.financial_goals.title"),
            Context.T("players.details.raw.financial_goals.desc"),
            GetGroupRows(rawGroupMap, "financial_goals")),
        (
            Context.T("players.details.raw.actions.title"),
            Context.T("players.details.raw.actions.desc"),
            GetGroupRows(rawGroupMap, "actions")),
        (
            Context.T("players.details.raw.turns.title"),
            Context.T("players.details.raw.turns.desc"),
            part11Rows)
    };

    var derivedSummaryRows = GetGroupRows(derivedGroupMap, "summary");

    var financialDerivedRows = MergeUniqueRows(
        FilterRowsByKeywords(
            derivedSummaryRows,
            "net_worth",
            "income_diversification",
            "expense_management",
            "business_profit",
            "business_efficiency",
            "gold_roi",
            "growth_pattern"),
        GetGroupRows(derivedGroupMap, "income_diversification_components"),
        GetGroupRows(derivedGroupMap, "expense_management_components"));

    var strategicDerivedRows = MergeUniqueRows(
        FilterRowsByKeywords(
            derivedSummaryRows,
            "risk_appetite",
            "debt_leverage",
            "debt_ratio",
            "loan_repayment",
            "goal_setting_ambition",
            "risk_exposure",
            "risk_mitigation"),
        GetGroupRows(derivedGroupMap, "risk_appetite_components"),
        GetGroupRows(derivedGroupMap, "goal_setting_components"));

    var behaviorDerivedRows = FilterRowsByKeywords(
        derivedSummaryRows,
        "action_efficiency",
        "meal_order_success",
        "planning_horizon",
        "donation_aggressiveness",
        "donation_stability");

    var flourishingDerivedRows = MergeUniqueRows(
        FilterRowsByKeywords(
            derivedSummaryRows,
            "fulfillment_diversity",
            "donation_commitment",
            "mission_achievement"),
        GetGroupRows(derivedGroupMap, "fulfillment_diversity_components"),
        GetGroupRows(derivedGroupMap, "donation_commitment_components"),
        GetGroupRows(derivedGroupMap, "happiness_portfolio"));

    var mappedDerivedPaths = new HashSet<string>(
        financialDerivedRows
            .Concat(strategicDerivedRows)
            .Concat(behaviorDerivedRows)
            .Concat(flourishingDerivedRows)
            .Select(row => row.Path),
        StringComparer.OrdinalIgnoreCase);
    var fallbackDerivedRows = derivedSummaryRows.Where(row => !mappedDerivedPaths.Contains(row.Path)).ToList();
    if (fallbackDerivedRows.Count > 0)
    {
        behaviorDerivedRows = MergeUniqueRows(behaviorDerivedRows, fallbackDerivedRows);
    }

    var derivedSections = new List<(string Title, string Description, List<(string Path, string Value)> Rows)>
    {
        (
            Context.T("players.details.derived.financial.title"),
            Context.T("players.details.derived.financial.desc"),
            financialDerivedRows),
        (
            Context.T("players.details.derived.strategy.title"),
            Context.T("players.details.derived.strategy.desc"),
            strategicDerivedRows),
        (
            Context.T("players.details.derived.behavior.title"),
            Context.T("players.details.derived.behavior.desc"),
            behaviorDerivedRows),
        (
            Context.T("players.details.derived.flourishing.title"),
            Context.T("players.details.derived.flourishing.desc"),
            flourishingDerivedRows)
    };

    var cashflowJourney = Model.CashflowJourney;
    var hasCashflowJourney = cashflowJourney is not null && cashflowJourney.TransactionCount > 0;
    var localizedTimelineLabels = hasCashflowJourney
        ? cashflowJourney!.TimelineLabels
            .Select(label => string.Equals(label, "START", StringComparison.OrdinalIgnoreCase)
                ? Context.T("common.start")
                : label)
            .ToList()
        : new List<string>();
    var localizedTransactionDetails = hasCashflowJourney
        ? cashflowJourney!.TransactionDetails.Select(LocalizeTransactionDetail).ToList()
        : new List<string>();
    var cashflowJourneyChartPayload = hasCashflowJourney
        ? JsonSerializer.Serialize(new
        {
            chartType = "line",
            labels = localizedTimelineLabels,
            keys = new[] { "cashflow_running_net" },
            formulas = localizedTransactionDetails,
            detailLabel = Context.T("players.details.transaction_label"),
            series = new[]
            {
                new
                {
                    name = Context.T("players.cashflow_journey.series_name"),
                    values = cashflowJourney!.RunningNetSeries
                }
            }
        })
        : "{}";

    var statSummary = Model.StatSummary ?? new PlayerStatSummaryViewModel();
    var cashflowSummaryValues = new double?[]
    {
        cashflowJourney?.TotalCashIn ?? Model.Summary?.CashInTotal ?? 0d,
        cashflowJourney?.TotalCashOut ?? Model.Summary?.CashOutTotal ?? 0d,
        cashflowJourney?.NetCashflow ?? ((Model.Summary?.CashInTotal ?? 0d) - (Model.Summary?.CashOutTotal ?? 0d)),
        cashflowJourney?.EndingCash ?? 0d
    };
    var cashflowSummaryChartPayload = JsonSerializer.Serialize(new
    {
        chartType = "bar",
        labels = new[]
        {
            Context.T("metric.cash_in"),
            Context.T("metric.cash_out"),
            Context.T("metric.net_cashflow"),
            Context.T("players.cashflow_journey.ending_cash")
        },
        keys = new[] { "cash_in_total", "cash_out_total", "net_cashflow", "ending_cash" },
        formulas = new[]
        {
            Context.T("players.details.formula.raw.cash_in_sum"),
            Context.T("players.details.formula.raw.cash_out_sum"),
            Context.T("players.details.formula.derived.net_cashflow"),
            Context.T("players.cashflow_journey.quick_check")
        },
        detailLabel = Context.T("players.details.source_calc_label"),
        series = new[]
        {
            new
            {
                name = Context.T("common.value"),
                values = cashflowSummaryValues
            }
        }
    });
    var happinessCompositionChartPayload = Model.Summary is null
        ? "{}"
        : JsonSerializer.Serialize(new
        {
            chartType = "bar",
            labels = new[]
            {
                Context.T("metric.need_points"),
                Context.T("metric.need_bonus"),
                Context.T("metric.donation_points"),
                Context.T("metric.gold_points"),
                Context.T("metric.pension_points"),
                Context.T("metric.saving_goal"),
                Context.T("metric.mission_penalty"),
                Context.T("metric.loan_penalty")
            },
            keys = new[]
            {
                "need_points_total",
                "need_set_bonus_points",
                "donation_points_total",
                "gold_points_total",
                "pension_points_total",
                "saving_goal_points_total",
                "mission_penalty_total",
                "loan_penalty_total"
            },
            formulas = new[]
            {
                Context.T("players.details.formula.derived.need_points"),
                Context.T("players.details.formula.derived.points_weight"),
                Context.T("players.details.formula.derived.donation_points"),
                Context.T("players.details.formula.derived.points_weight"),
                Context.T("players.details.formula.derived.pension_points"),
                Context.T("players.details.formula.derived.saving_goal_points"),
                Context.T("players.details.formula.derived.penalty"),
                Context.T("players.details.formula.derived.penalty")
            },
            detailLabel = Context.T("players.details.source_calc_label"),
            series = new[]
            {
                new
                {
                    name = Context.T("common.value"),
                    values = new double?[]
                    {
                        Model.Summary.NeedPointsTotal,
                        Model.Summary.NeedSetBonusPoints,
                        Model.Summary.DonationPointsTotal,
                        Model.Summary.GoldPointsTotal,
                        Model.Summary.PensionPointsTotal,
                        Model.Summary.SavingGoalPointsTotal,
                        -Model.Summary.MissionPenaltyTotal,
                        -Model.Summary.LoanPenaltyTotal
                    }
                }
            }
        });
    var behaviorSnapshotChartPayload = Model.Summary is null
        ? "{}"
        : JsonSerializer.Serialize(new
        {
            chartType = "bar",
            labels = new[]
            {
                Context.T("metric.orders_completed"),
                Context.T("metric.inventory_ingredient"),
                Context.T("metric.actions_used"),
                Context.T("metric.primary_need_compliance"),
                Context.T("metric.violations")
            },
            keys = new[]
            {
                "orders_completed_count",
                "inventory_ingredient_total",
                "actions_used_total",
                "compliance_primary_need_rate",
                "rules_violations_count"
            },
            formulas = new[]
            {
                Context.T("players.details.formula.raw.per_turn_aggregate"),
                Context.T("players.details.source_raw_summary"),
                Context.T("players.details.formula.raw.per_turn_aggregate"),
                Context.T("players.details.formula.derived.default"),
                Context.T("players.details.formula.derived.penalty")
            },
            detailLabel = Context.T("players.details.source_calc_label"),
            series = new[]
            {
                new
                {
                    name = Context.T("common.value"),
                    values = new double?[]
                    {
                        Model.Summary.OrdersCompletedCount,
                        Model.Summary.InventoryIngredientTotal,
                        Model.Summary.ActionsUsedTotal,
                        Model.Summary.CompliancePrimaryNeedRate * 100,
                        Model.Summary.RulesViolationsCount
                    }
                }
            }
        });

    var hasGameplayData = Model.GameplayDerived.HasValue || Model.GameplayRaw.HasValue;
    var playerTurnOrder = Model.Summary?.PlayerOrder ?? 1;
    var playerAvatarPath = $"/images/players/{ResolvePlayerAvatarIndex(playerTurnOrder)}.png";
}

<section class="section-shell player-detail-overhaul">
    <div class="player-detail-hero">
        <p class="eyebrow text-emerald-700">@Context.T("players.analytics_title")</p>
        <h1 class="headline">@Context.T("players.detail_title")</h1>
        @if (!string.IsNullOrWhiteSpace(Model.PlayerDisplayName))
        {
            <div class="mt-2 flex items-center gap-3">
                <img class="h-8 w-8 rounded-full border border-slate-200 object-cover"
                     src="@playerAvatarPath"
                     alt="@($"{Context.T("common.turn_order")} {playerTurnOrder}")" />
                <p class="player-detail-name" style="margin-top: 0;">@Model.PlayerDisplayName</p>
            </div>
        }
        <div class="player-detail-meta">
            <span class="player-detail-meta__item player-detail-meta__item--mono">@Model.PlayerId</span>
            @if (Model.GameplayComputedAt.HasValue)
            {
                <span class="player-detail-meta__item">@Context.T("common.computed"): @Model.GameplayComputedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
            }
        </div>
    </div>

    <div class="action-toolbar mt-4 player-detail-toolbar">
        <a class="btn-ghost"
           asp-controller="PlayerDirectory"
           asp-action="Index">@Context.T("players.detail.nav_back_players")</a>
        <a class="btn-ghost"
           asp-controller="Sessions"
           asp-action="Details"
           asp-route-sessionId="@Model.SessionId">@Context.T("players.detail.nav_back_session")</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mt-4 alert alert-error" aria-live="polite">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.GameplayErrorMessage))
    {
        <div class="mt-4 alert alert-warning" aria-live="polite">
            @Model.GameplayErrorMessage
        </div>
    }

    <div id="player-statistics-dashboard" class="players-fusion-metrics player-detail-section player-stats-dashboard">
        <div class="players-fusion-head ruleset-section-head">
            <p class="eyebrow">@Context.T("players.stats.badge")</p>
            <h2 class="ruleset-section-title">@Context.T("players.stats.title")</h2>
            <p class="ruleset-section-subtitle">@Context.T("players.stats.subtitle")</p>
        </div>

        <div class="player-stats-key-grid mt-6">
            @foreach (var metric in statSummary.KeyMetrics)
            {
                <article class="player-stat-kpi player-stat-tone-@metric.Tone">
                    <p class="player-stat-kpi__label">@metric.Label</p>
                    <p class="player-stat-kpi__value">@metric.Value</p>
                </article>
            }
        </div>

        <div class="player-stats-insights mt-4" aria-label="@Context.T("players.stats.insights_title")">
            @foreach (var insight in statSummary.Insights)
            {
                <article class="player-stat-insight player-stat-tone-@insight.Tone">
                    <p class="player-stat-insight__title">@insight.Title</p>
                    <p class="player-stat-insight__body">@insight.Description</p>
                </article>
            }
        </div>

        <div id="player-stats-tablist"
             class="player-stats-tablist mt-5"
             role="tablist"
             aria-label="@Context.T("players.stats.tabs.label")">
            <button type="button"
                    class="player-stats-tab is-active"
                    id="player-stats-tab-summary"
                    role="tab"
                    aria-selected="true"
                    aria-controls="player-stats-panel-summary"
                    data-player-stat-tab="summary">@Context.T("players.stats.tab.summary")</button>
            <button type="button"
                    class="player-stats-tab"
                    id="player-stats-tab-finance"
                    role="tab"
                    aria-selected="false"
                    aria-controls="player-stats-panel-finance"
                    data-player-stat-tab="finance">@Context.T("players.stats.tab.finance")</button>
            <button type="button"
                    class="player-stats-tab"
                    id="player-stats-tab-behavior"
                    role="tab"
                    aria-selected="false"
                    aria-controls="player-stats-panel-behavior"
                    data-player-stat-tab="behavior">@Context.T("players.stats.tab.behavior")</button>
            <button type="button"
                    class="player-stats-tab"
                    id="player-stats-tab-happiness"
                    role="tab"
                    aria-selected="false"
                    aria-controls="player-stats-panel-happiness"
                    data-player-stat-tab="happiness">@Context.T("players.stats.tab.happiness")</button>
            <button type="button"
                    class="player-stats-tab"
                    id="player-stats-tab-technical"
                    role="tab"
                    aria-selected="false"
                    aria-controls="player-stats-panel-technical"
                    data-player-stat-tab="technical">@Context.T("players.stats.tab.technical")</button>
        </div>

        <div class="player-stats-panels mt-5">
            <section id="player-stats-panel-summary"
                     class="player-stats-tab-panel is-active"
                     role="tabpanel"
                     aria-labelledby="player-stats-tab-summary">
                <p class="tab-panel-intro">@Context.T("players.stats.tab.summary.desc")</p>
                <div class="chart-grid chart-grid-feature">
                    <article class="chart-card chart-card-feature">
                        <h3 class="chart-title">@Context.T("players.stats.chart.cashflow_snapshot")</h3>
                        <svg class="metric-line-chart js-metric-line-chart"
                             viewBox="0 0 840 360"
                             data-chart="@cashflowSummaryChartPayload"
                             role="img"
                             aria-label="@Context.T("players.stats.chart.cashflow_snapshot")"></svg>
                    </article>
                </div>
            </section>

            <section id="player-stats-panel-finance"
                     class="player-stats-tab-panel"
                     role="tabpanel"
                     aria-labelledby="player-stats-tab-finance"
                     hidden>
                <p class="tab-panel-intro">@Context.T("players.stats.tab.finance.desc")</p>
                @if (!hasCashflowJourney)
                {
                    <div class="alert alert-info">
                        @Context.T("players.cashflow_journey.empty")
                    </div>
                }
                else
                {
                    <div class="player-stats-mini-grid">
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("players.cashflow_journey.starting_cash")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@cashflowJourney!.StartingCash.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("players.cashflow_journey.total_transactions")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@cashflowJourney.TransactionCount</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("players.cashflow_journey.total_in")</p>
                            <p class="mt-2 text-2xl font-semibold text-emerald-700">@cashflowJourney.TotalCashIn.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("players.cashflow_journey.total_out")</p>
                            <p class="mt-2 text-2xl font-semibold text-rose-700">@cashflowJourney.TotalCashOut.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("players.cashflow_journey.running_peak")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@cashflowJourney.PeakRunningNet.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("players.cashflow_journey.running_lowest")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@cashflowJourney.LowestRunningNet.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                    </div>

                    <div class="mt-3 alert alert-info text-sm">
                        @(string.Format(
                            CultureInfo.CurrentCulture,
                            Context.T("players.cashflow_journey.quick_check"),
                            cashflowJourney.StartingCash.ToString("N0", CultureInfo.CurrentCulture),
                            cashflowJourney.TotalCashIn.ToString("N0", CultureInfo.CurrentCulture),
                            cashflowJourney.TotalCashOut.ToString("N0", CultureInfo.CurrentCulture),
                            cashflowJourney.EndingCash.ToString("N0", CultureInfo.CurrentCulture)))
                    </div>

                    <div class="chart-grid chart-grid-feature mt-4">
                        <article class="chart-card chart-card-feature">
                            <h3 class="chart-title">@Context.T("players.cashflow_journey.chart_title")</h3>
                            <svg class="metric-line-chart js-metric-line-chart"
                                 viewBox="0 0 840 360"
                                 data-chart="@cashflowJourneyChartPayload"
                                 role="img"
                                 aria-label="@Context.T("players.cashflow_journey.chart_title")"></svg>
                        </article>
                    </div>

                    <div class="mt-4 metric-panel">
                        <div class="metric-list">
                            <div class="metric-row">
                                <span class="metric-key">@Context.T("players.cashflow_journey.period_start")</span>
                                <span class="metric-value">@(cashflowJourney.FirstTransactionAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                            </div>
                            <div class="metric-row">
                                <span class="metric-key">@Context.T("players.cashflow_journey.period_end")</span>
                                <span class="metric-value">@(cashflowJourney.LastTransactionAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                            </div>
                            <div class="metric-row">
                                <span class="metric-key">@Context.T("players.cashflow_journey.in_count")</span>
                                <span class="metric-value">@cashflowJourney.CashInCount</span>
                            </div>
                            <div class="metric-row">
                                <span class="metric-key">@Context.T("players.cashflow_journey.out_count")</span>
                                <span class="metric-value">@cashflowJourney.CashOutCount</span>
                            </div>
                        </div>
                    </div>
                }
            </section>

            <section id="player-stats-panel-behavior"
                     class="player-stats-tab-panel"
                     role="tabpanel"
                     aria-labelledby="player-stats-tab-behavior"
                     hidden>
                <p class="tab-panel-intro">@Context.T("players.stats.tab.behavior.desc")</p>
                @if (Model.Summary is null)
                {
                    <div class="alert alert-info">@Context.T("players.detail.empty_analytics")</div>
                }
                else
                {
                    <div class="player-stats-mini-grid">
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("metric.orders_completed")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Summary.OrdersCompletedCount</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("metric.actions_used")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Summary.ActionsUsedTotal</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("metric.primary_need_compliance")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Summary.CompliancePrimaryNeedRate.ToString("P0", CultureInfo.CurrentCulture)</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("metric.violations")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Summary.RulesViolationsCount</p>
                        </article>
                    </div>
                    <div class="chart-grid chart-grid-feature mt-4">
                        <article class="chart-card chart-card-feature">
                            <h3 class="chart-title">@Context.T("players.stats.chart.behavior_snapshot")</h3>
                            <svg class="metric-line-chart js-metric-line-chart"
                                 viewBox="0 0 840 360"
                                 data-chart="@behaviorSnapshotChartPayload"
                                 role="img"
                                 aria-label="@Context.T("players.stats.chart.behavior_snapshot")"></svg>
                        </article>
                    </div>
                }
            </section>

            <section id="player-stats-panel-happiness"
                     class="player-stats-tab-panel"
                     role="tabpanel"
                     aria-labelledby="player-stats-tab-happiness"
                     hidden>
                <p class="tab-panel-intro">@Context.T("players.stats.tab.happiness.desc")</p>
                @if (Model.Summary is null)
                {
                    <div class="alert alert-info">@Context.T("players.detail.empty_analytics")</div>
                }
                else
                {
                    <div class="player-stats-mini-grid">
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("metric.happiness")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Summary.HappinessPointsTotal.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("metric.need_points")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Summary.NeedPointsTotal.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("metric.donation_points")</p>
                            <p class="mt-2 text-2xl font-semibold text-slate-900">@Model.Summary.DonationPointsTotal.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                        <article class="stat-card">
                            <p class="text-sm font-medium text-slate-600">@Context.T("metric.loan_penalty")</p>
                            <p class="mt-2 text-2xl font-semibold text-rose-700">@Model.Summary.LoanPenaltyTotal.ToString("N0", CultureInfo.CurrentCulture)</p>
                        </article>
                    </div>
                    <div class="chart-grid chart-grid-feature mt-4">
                        <article class="chart-card chart-card-feature">
                            <h3 class="chart-title">@Context.T("players.stats.chart.happiness_composition")</h3>
                            <svg class="metric-line-chart js-metric-line-chart"
                                 viewBox="0 0 840 360"
                                 data-chart="@happinessCompositionChartPayload"
                                 role="img"
                                 aria-label="@Context.T("players.stats.chart.happiness_composition")"></svg>
                        </article>
                    </div>
                }
            </section>

            <section id="player-stats-panel-technical"
                     class="player-stats-tab-panel"
                     role="tabpanel"
                     aria-labelledby="player-stats-tab-technical"
                     hidden>
                <p class="tab-panel-intro">@Context.T("players.stats.tab.technical.desc")</p>
                @if (!hasGameplayData)
                {
                    <div class="alert alert-info" aria-live="polite">
                        @Context.T("players.detail.empty_analytics")
                    </div>
                }
                else
                {
                    <div id="technical-drilldown" class="technical-drilldown">
                        <div id="player-stat-technical-raw" class="technical-drilldown-section">
                            <div class="players-fusion-head ruleset-section-head">
                                <p class="eyebrow">@Context.T("gameplay.raw")</p>
                                <h3 class="ruleset-section-title">@Context.T("players.details.raw_title")</h3>
                                <p class="ruleset-section-subtitle">@Context.T("players.details.raw_subtitle")</p>
                            </div>
                            <div class="metric-domain-layout mt-6">
                                @foreach (var domain in rawSections)
                                {
                                    <article class="metric-domain-card metric-domain-card-flat">
                                        <div class="metric-domain-heading">
                                            <h3>@domain.Title</h3>
                                            <span class="metric-domain-count">@domain.Rows.Count @Context.T("players.metric_items_suffix")</span>
                                        </div>
                                        <p class="metric-domain-intro">@domain.Description</p>
                                        @if (domain.Rows.Count == 0)
                                        {
                                            <p class="metric-domain-empty">@Context.T("players.details.chart_domain_empty")</p>
                                        }
                                        else
                                        {
                                            <div class="mt-3 metric-panel">
                                                <div class="metric-list">
                                                    @foreach (var row in domain.Rows)
                                                    {
                                                        <div class="metric-row">
                                                            <span class="metric-key">@PlayerMetricLabelFormatter.FormatMetricPathLabel(row.Path, Context.T)</span>
                                                            <span class="metric-value font-mono">@row.Value</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        </div>

                        <div id="player-stat-technical-derived" class="technical-drilldown-section">
                            <div class="players-fusion-head ruleset-section-head">
                                <p class="eyebrow">@Context.T("gameplay.derived")</p>
                                <h3 class="ruleset-section-title">@Context.T("players.details.derived_title")</h3>
                                <p class="ruleset-section-subtitle">@Context.T("players.details.derived_subtitle")</p>
                            </div>
                            <div class="metric-domain-layout mt-6">
                                @foreach (var domain in derivedSections)
                                {
                                    <article class="metric-domain-card metric-domain-card-flat">
                                        <div class="metric-domain-heading">
                                            <h3>@domain.Title</h3>
                                            <span class="metric-domain-count">@domain.Rows.Count @Context.T("players.metric_items_suffix")</span>
                                        </div>
                                        <p class="metric-domain-intro">@domain.Description</p>
                                        @if (domain.Rows.Count == 0)
                                        {
                                            <p class="metric-domain-empty">@Context.T("players.details.chart_domain_empty")</p>
                                        }
                                        else
                                        {
                                            <div class="mt-3 metric-panel">
                                                <div class="metric-list">
                                                    @foreach (var row in domain.Rows)
                                                    {
                                                        <div class="metric-row">
                                                            <span class="metric-key">@PlayerMetricLabelFormatter.FormatMetricPathLabel(row.Path, Context.T)</span>
                                                            <span class="metric-value font-mono">@row.Value</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>
        </div>
    </div>

    <div id="player-transaction-history" class="players-fusion-metrics player-detail-section mt-6 player-transactions-section">
        <div class="players-fusion-head ruleset-section-head">
            <p class="eyebrow">@Context.T("players.cashflow_journey.badge")</p>
            <h2 class="ruleset-section-title">@Context.T("players.transaction_history")</h2>
            <p class="ruleset-section-subtitle">@Context.T("players.cashflow_journey.subtitle")</p>
        </div>

        <div class="mt-4 table-wrap">
            <table class="w-full text-left text-sm mobile-card-table">
                <thead class="table-head">
                    <tr>
                        <th class="px-4 py-3">@Context.T("common.time")</th>
                        <th class="px-4 py-3">@Context.T("common.category")</th>
                        <th class="px-4 py-3 text-center">@Context.T("common.direction")</th>
                        <th class="px-4 py-3 text-right">@Context.T("common.transaction_amount")</th>
                        <th class="px-4 py-3 text-right">@Context.T("common.running_balance")</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Transactions == null || Model.Transactions.Count == 0)
                {
                    <tr>
                        <td class="px-4 py-4 text-slate-500 mobile-card-empty" colspan="5">@Context.T("players.no_transactions")</td>
                    </tr>
                }
                else
                {
                    var runningBal = Model.CashflowJourney?.StartingCash ?? 20.0;
                    foreach (var tx in Model.Transactions.OrderBy(t => t.Timestamp))
                    {
                        var isIncoming = string.Equals(tx.Direction, "IN", StringComparison.OrdinalIgnoreCase);
                        if (isIncoming)
                        {
                            runningBal += tx.Amount;
                        }
                        else if (string.Equals(tx.Direction, "OUT", StringComparison.OrdinalIgnoreCase))
                        {
                            runningBal -= tx.Amount;
                        }
                        var directionPillClass = isIncoming ? "status-active" : "status-retired";
                        var amountClass = isIncoming ? "text-emerald-700 font-semibold" : "text-rose-700 font-semibold";
                        var sign = isIncoming ? "+" : "-";

                        <tr class="border-t border-slate-200">
                            <td class="px-4 py-3 text-slate-700 font-mono text-xs" data-label="@Context.T("common.time")">
                                @tx.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td class="px-4 py-3 font-medium text-slate-900" data-label="@Context.T("common.category")">
                                @LocalizeTransactionDetail($"{tx.Direction} - {tx.Category} ({tx.Amount})")
                            </td>
                            <td class="px-4 py-3 text-center" data-label="@Context.T("common.direction")">
                                <span class="status-pill @directionPillClass">@tx.Direction</span>
                            </td>
                            <td class="px-4 py-3 text-right @amountClass" data-label="@Context.T("common.transaction_amount")">
                                @sign@tx.Amount.ToString("N0", CultureInfo.CurrentCulture)
                            </td>
                            <td class="px-4 py-3 text-right font-mono text-slate-900" data-label="@Context.T("common.running_balance")">
                                @runningBal.ToString("N0", CultureInfo.CurrentCulture)
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        window.cashflowpolyPlayerDetailCharts = {
            tooltipText: {
                metric: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.metric"))),
                series: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.series"))),
                points: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.points_value"))),
                formula: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.source_calc_label"))),
                defaultFormula: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.source_calc_default"))),
                selectedDetail: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.selected_detail"))),
                tapHint: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.tap_hint"))),
                itemPrefix: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.item")))
            },
            chartStatusText: {
                noSeries: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.no_series"))),
                noPoints: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.no_points"))),
                invalidPayload: @Html.Raw(JsonSerializer.Serialize(Context.T("players.details.invalid_payload")))
            }
        };
    </script>
    <script>
        (() => {
            const tabs = Array.from(document.querySelectorAll("[data-player-stat-tab]"));
            if (!tabs.length) {
                return;
            }

            const panels = Array.from(document.querySelectorAll(".player-stats-tab-panel"));
            const activateTab = (tab) => {
                tabs.forEach((item) => {
                    const isActive = item === tab;
                    item.classList.toggle("is-active", isActive);
                    item.setAttribute("aria-selected", isActive ? "true" : "false");
                });

                panels.forEach((panel) => {
                    const isActive = panel.id === tab.getAttribute("aria-controls");
                    panel.classList.toggle("is-active", isActive);
                    panel.hidden = !isActive;
                });
            };

            tabs.forEach((tab) => {
                tab.addEventListener("click", () => activateTab(tab));
                tab.addEventListener("keydown", (event) => {
                    if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") {
                        return;
                    }

                    event.preventDefault();
                    const direction = event.key === "ArrowRight" ? 1 : -1;
                    const currentIndex = tabs.indexOf(tab);
                    const nextIndex = (currentIndex + direction + tabs.length) % tabs.length;
                    tabs[nextIndex].focus();
                    activateTab(tabs[nextIndex]);
                });
            });
        })();
    </script>
    <script src="~/js/player-detail-charts.js" asp-append-version="true"></script>
}

