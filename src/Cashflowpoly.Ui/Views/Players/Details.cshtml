*@
@using System.Globalization
@using System.Text.Json
@using Cashflowpoly.Ui.Infrastructure
@model Cashflowpoly.Ui.Models.PlayerDetailViewModel

@{
    ViewData["Title"] = Context.T("players.detail_title");
    var isInstructor = Context.IsInstructor();

    static int ResolvePlayerAvatarIndex(int turnOrder)
    {
        if (turnOrder <= 0)
        {
            return 1;
        }

        return ((turnOrder - 1) % 4) + 1;
    }

    string FormatNumber(double value) => value.ToString("N0", CultureInfo.CurrentCulture);
    string FormatSignedNumber(double value) => value > 0 ? $"+{FormatNumber(value)}" : FormatNumber(value);
    static int ResolveCardColumns(int count) => count switch
    {
        1 => 1,
        2 or 4 or 8 => 2,
        _ => 3
    };
    static bool IsCollectionValue(string value) =>
        value.TrimStart().StartsWith("[", StringComparison.Ordinal)
        || value.TrimStart().StartsWith("{", StringComparison.Ordinal);
    string FormatActionSlot(int slot) => slot switch
    {
        0 => Context.T("players.details.action_slot.free"),
        1 => Context.T("players.details.action_slot.first"),
        2 => Context.T("players.details.action_slot.second"),
        _ => string.Format(CultureInfo.CurrentCulture, Context.T("players.details.action_slot.numbered"), slot)
    };

    string FormatCollectionCell(string metricPath, string column, string value, bool advancedMode, string unavailableText, bool isSetup)
    {
        if (column.Equals("action_pattern", StringComparison.OrdinalIgnoreCase))
        {
            return value is "none" or "single" or "repeated" or "different"
                ? Context.T($"players.action_pattern.{value}")
                : unavailableText;
        }
        if (column.Equals("action_slot", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var actionSlot))
        {
            return isSetup && actionSlot == 0 ? Context.T("players.details.action_slot.setup") : FormatActionSlot(actionSlot);
        }

        if (column.Equals("day_index", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var dayIndex))
        {
            return dayIndex == 0
                ? Context.T("players.details.day.setup")
                : dayIndex.ToString(CultureInfo.CurrentCulture);
        }

        if (column.Equals("series", StringComparison.OrdinalIgnoreCase)
            || column.Equals("action_type", StringComparison.OrdinalIgnoreCase))
        {
            return PlayerMetricLabelFormatter.HumanizeMetricKey(value, Context.T);
        }

        if (column.Equals("actions", StringComparison.OrdinalIgnoreCase))
        {
            return string.Join(", ", value
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(action => PlayerMetricLabelFormatter.HumanizeMetricKey(action, Context.T)));
        }

        if (column.Equals("cashflow_category", StringComparison.OrdinalIgnoreCase))
        {
            return string.Join(", ", value
                .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(category => PlayerMetricLabelFormatter.HumanizeTransactionCategory(category, Context.T)));
        }

        return PlayerMetricLabelFormatter.DescribeMetric(
            $"{metricPath}.{column}",
            value,
            false,
            advancedMode,
            unavailableText,
            Context.T).DisplayValue;
    }

    static bool IsCollectionContextColumn(string column) =>
        column is "item_index" or "action_slot" or "day_index" or "sequence_number" or "action_index"
            or "action_type" or "actions" or "action_pattern" or "series" or "rank" or "cashflow_category";

    var cashflowJourney = Model.CashflowJourney;
    var statSummary = Model.StatSummary ?? new PlayerStatSummaryViewModel();
    var nullText = Context.T("players.support.value.unavailable");
    double? totalCashIn = Model.Summary?.CashInTotal ?? cashflowJourney?.TotalCashIn;
    double? totalCashOut = Model.Summary?.CashOutTotal ?? cashflowJourney?.TotalCashOut;
    double? netCashflow = totalCashIn.HasValue && totalCashOut.HasValue
        ? totalCashIn.Value - totalCashOut.Value
        : null;
    double? endingCash = cashflowJourney?.StartingCash + netCashflow;
    double? fulfillmentDiversity = Model.Summary?.FulfillmentDiversity;
    var needCardsOwned = Model.GameplayRaw.HasValue
        && Model.GameplayRaw.Value.ValueKind == JsonValueKind.Object
        && Model.GameplayRaw.Value.TryGetProperty("needs", out var gameplayNeeds)
        && gameplayNeeds.ValueKind == JsonValueKind.Object
        && gameplayNeeds.TryGetProperty("need_cards_owned_current", out var ownedNeedCards)
        && ownedNeedCards.TryGetInt32(out var ownedNeedCardCount)
            ? ownedNeedCardCount
            : (int?)null;
    double? happinessPoints = Model.Summary?.HappinessPointsTotal;
    bool? hasUnpaidLoan = Model.Summary?.HasUnpaidLoan;
    var hasCompleteEvaluationData = endingCash.HasValue && netCashflow.HasValue && fulfillmentDiversity.HasValue
        && happinessPoints.HasValue && hasUnpaidLoan.HasValue;
    var overallTone = hasUnpaidLoan == true
        ? "danger"
        : netCashflow is < 0 || fulfillmentDiversity is < 0.4 || happinessPoints is < 20
            ? "warning"
            : hasCompleteEvaluationData && netCashflow is > 0 && fulfillmentDiversity is >= 0.7 && happinessPoints is >= 60
                ? "positive"
                : hasCompleteEvaluationData ? "neutral" : "unavailable";
    var overallStatusKey = $"players.stats.status.{overallTone}";
    var overallDescriptionKey = $"players.stats.status.{overallTone}.desc";

    var trueText = Context.T("players.support.value.yes");
    var falseText = Context.T("players.support.value.no");
    var rawGroupMap = PlayerMetricJsonMapper
        .BuildMetricVariableGroups(Model.GameplayRaw, trueText, falseText, nullText)
        .ToDictionary(group => group.GroupKey, group => group.Rows, StringComparer.OrdinalIgnoreCase);
    var derivedGroupMap = PlayerMetricJsonMapper
        .BuildMetricGroups(Model.GameplayDerived, trueText, falseText, nullText)
        .ToDictionary(group => group.GroupKey, group => group.Rows, StringComparer.OrdinalIgnoreCase);
    var derivedSummaryRows = PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "summary");
    var isAdvancedMode = Model.GameplayRaw.HasValue
        && Model.GameplayRaw.Value.ValueKind == JsonValueKind.Object
        && Model.GameplayRaw.Value.TryGetProperty("metadata", out var gameplayMetadata)
        && gameplayMetadata.ValueKind == JsonValueKind.Object
        && gameplayMetadata.TryGetProperty("game_mode", out var gameplayMode)
        && string.Equals(gameplayMode.GetString(), "advanced", StringComparison.OrdinalIgnoreCase);

    List<(string Path, string Value)> SelectDerived(params string[] keys)
    {
        return derivedSummaryRows
            .Where(row => keys.Contains(row.Path, StringComparer.OrdinalIgnoreCase))
            .ToList();
    }

    List<(string Path, string Value)> ExcludeRows(
        IEnumerable<(string Path, string Value)> rows,
        params string[] keys) =>
        rows.Where(row => !keys.Contains(row.Path, StringComparer.OrdinalIgnoreCase)).ToList();

    List<(string Path, string Value)> ExcludeAdvancedRowsInBeginner(
        IEnumerable<(string Path, string Value)> rows,
        params string[] keys) =>
        isAdvancedMode ? rows.ToList() : ExcludeRows(rows, keys);

    List<(string Path, string Value)> BuildCoinRows()
    {
        var coinRows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "coins");
        var turnRows = ExcludeAdvancedRowsInBeginner(
            PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "turns"),
            "action_slot_when_debt_introduced",
            "action_slot_when_first_risk_hit",
            "day_when_debt_introduced",
            "day_when_first_risk_hit");
        // Waktu risiko pertama sudah dapat ditelusuri dari kelompok Risiko Kehidupan.
        // Jangan tampilkan kartu ringkasan yang mengulang informasi tersebut.
        turnRows = ExcludeRows(turnRows, "day_when_first_risk_hit", "action_slot_when_first_risk_hit");
        var outgoing = coinRows.FirstOrDefault(row => row.Path == "coins_spent_per_turn").Value;
        var incoming = coinRows.FirstOrDefault(row => row.Path == "coins_earned_per_turn").Value;
        var netChange = turnRows.FirstOrDefault(row => row.Path == "net_income_per_turn").Value;
        var balance = turnRows.FirstOrDefault(row => row.Path == "coins_per_turn_progression").Value;
        var transactionHistory = PlayerMetricJsonMapper.BuildTransactionHistoryJson(
            outgoing ?? "[]",
            incoming ?? "[]",
            netChange ?? "[]",
            balance ?? "[]");
        var result = ExcludeRows(
            coinRows,
            "coins_donated",
            "coins_saved",
            "coins_net_end_game",
            "coins_spent_per_turn",
            "coins_earned_per_turn");

        if (!string.IsNullOrWhiteSpace(transactionHistory))
        {
            result.Add(("transaction_history", transactionHistory));
        }

        result.AddRange(ExcludeRows(
            turnRows,
            "coins_per_turn_progression",
            "net_income_per_turn").OrderBy(row => row.Path switch
        {
            "day_when_debt_introduced" => 0,
            "day_game_completion" => 1,
            _ => 2
        }));

        return result;
    }

    List<(string Path, string Value)> BuildDonationRows()
    {
        var rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "donations");
        if (rows.Count == 0)
        {
            return rows;
        }

        var amounts = rows.FirstOrDefault(row => row.Path == "donation_amount_per_friday").Value;
        var ranks = rows.FirstOrDefault(row => row.Path == "donation_rank_per_friday").Value;
        var result = ExcludeRows(rows, "donation_amount_per_friday", "donation_rank_per_friday");
        result.Insert(0, ("donation_history", PlayerMetricJsonMapper.BuildDonationHistoryJson(
            amounts ?? "[]", ranks ?? "[]")));
        return result;
    }

    List<(string Path, string Value)> BuildActionRows()
    {
        var rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "actions");
        var sequence = rows.FirstOrDefault(row => row.Path == "action_sequence").Value;
        var repetitions = rows.FirstOrDefault(row => row.Path == "action_repetitions_per_turn").Value;
        var result = ExcludeRows(rows, "actions_per_turn", "action_sequence", "action_repetitions_per_turn");
        var history = PlayerMetricJsonMapper.BuildActionUsageHistoryJson(
            sequence ?? "[]",
            repetitions ?? "[]");
        if (!string.IsNullOrWhiteSpace(history))
        {
            result.Insert(0, ("action_usage_history", history));
        }

        return result;
    }

    var ingredientRows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "ingredients");
    var discardedIngredients = ingredientRows.FirstOrDefault(row => row.Path == "ingredients_wasted").Value;
    var financialGoalRows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "financial_goals");
    var attemptedFinancialGoals = financialGoalRows.FirstOrDefault(row => row.Path == "financial_goals_attempted").Value;
    var financialGoalSources = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "financial_goals", "coins");
    var financialGoalSummaryRows = new[] { "financial_goals_completed", "coins_saved", "sharia_loans_outstanding_coins" }
        .Select(path => (Path: path, Value: financialGoalSources.FirstOrDefault(row => row.Path == path).Value ?? nullText))
        .ToList();
    var rawSections = new[]
    {
        new { Key = "coin-finance", TitleKey = "players.details.raw.coin_finance.title", DescriptionKey = isAdvancedMode ? "players.details.raw.coin_finance.desc" : "players.details.raw.coin_finance.beginner.desc", AdvancedOnly = false, Rows = BuildCoinRows() },
        new { Key = "ingredients", TitleKey = "players.details.raw.ingredients.title", DescriptionKey = "players.details.raw.ingredients.desc", AdvancedOnly = false, Rows = ingredientRows.Where(row => row.Path != "ingredients_wasted" && row.Path.Split('.')[0] != "ingredient_types_held").ToList() },
        new { Key = "meal-orders", TitleKey = "players.details.raw.meal_orders.title", DescriptionKey = "players.details.raw.meal_orders.desc", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "meal_orders") },
        new { Key = "needs", TitleKey = "players.details.raw.needs.title", DescriptionKey = "players.details.raw.needs.desc", AdvancedOnly = false, Rows = ExcludeRows(PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "needs"), "need_profile.basic_profile", "need_profile.collector_profile", "need_profile.specialist_profile") },
        new { Key = "donations", TitleKey = "players.details.raw.donations.title", DescriptionKey = "players.details.raw.donations.desc", AdvancedOnly = false, Rows = BuildDonationRows() },
        new { Key = "gold", TitleKey = "players.details.raw.gold.title", DescriptionKey = "players.details.raw.gold.desc", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "gold") },
        new { Key = "pension", TitleKey = "players.details.raw.pension.title", DescriptionKey = "players.details.raw.pension.desc", AdvancedOnly = false, Rows = ExcludeRows(PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "pension"), "leftover_coins_end_game") },
        new { Key = "life-risk", TitleKey = "players.details.raw.life_risk.title", DescriptionKey = "players.details.raw.life_risk.desc", AdvancedOnly = true, Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "life_risk") },
        new { Key = "financial-goals", TitleKey = "players.details.raw.financial_goals.title", DescriptionKey = "players.details.raw.financial_goals.desc", AdvancedOnly = true, Rows = financialGoalSummaryRows },
        new { Key = "actions", TitleKey = "players.details.raw.actions.title", DescriptionKey = "players.details.raw.actions.desc", AdvancedOnly = false, Rows = BuildActionRows() }
    }.Where(item => isAdvancedMode || !item.AdvancedOnly).ToList();

    var analysisSections = new[]
    {
        new { Chapter = "money", Key = "net-worth", PrimaryKey = "cash_growth_percent", TitleKey = "players.analysis.net_worth.title", DescriptionKey = "players.analysis.net_worth.desc", FormulaKey = "players.support.formula.net_worth", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("cash_growth_percent"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "cash_growth_components")) },
        new { Chapter = "money", Key = "income-diversification", PrimaryKey = "income_diversification_index", TitleKey = "players.analysis.income_diversification.title", DescriptionKey = "players.analysis.income_diversification.desc", FormulaKey = "players.support.formula.income_diversification_index", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("income_diversification_index"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "income_diversification_components")) },
        new { Chapter = "money", Key = "expense-efficiency", PrimaryKey = "business_expense_share_percent", TitleKey = "players.analysis.expense_efficiency.title", DescriptionKey = "players.analysis.expense_efficiency.desc", FormulaKey = "players.support.formula.expense_efficiency", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("business_expense_share_percent"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "business_expense_share_components")) },
        new { Chapter = "money", Key = "business-margin", PrimaryKey = "meal_order_profit_margin_percent", TitleKey = "players.analysis.business_margin.title", DescriptionKey = "players.analysis.business_margin.desc", FormulaKey = "players.support.formula.business_margin", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("meal_order_profit_margin_percent"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "meal_order_profit_margin_components")) },
        new { Chapter = "future", Key = "risk-appetite", PrimaryKey = "risk_readiness_percent", TitleKey = "players.analysis.risk_appetite.title", DescriptionKey = "players.analysis.risk_appetite.desc", FormulaKey = "players.support.formula.risk_appetite", AdvancedOnly = true, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("risk_readiness_percent"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "risk_readiness_components")) },
        new { Chapter = "future", Key = "debt-discipline", PrimaryKey = "loan_burden_percent", TitleKey = "players.analysis.debt_discipline.title", DescriptionKey = "players.analysis.debt_discipline.desc", FormulaKey = "players.support.formula.debt_leverage", AdvancedOnly = true, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("loan_burden_percent"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "loan_burden_components")) },
        new { Chapter = "future", Key = "goal-ambition", PrimaryKey = "financial_goals_completed", TitleKey = "players.analysis.goal_ambition.title", DescriptionKey = "players.analysis.goal_ambition.desc", FormulaKey = "players.support.formula.goal_purchases", AdvancedOnly = true, Rows = financialGoalRows.Where(row => row.Path is "financial_goals_completed" or "financial_goals_purchase_cost_total" or "financial_goals_incomplete_coins_wasted").ToList() },
        new { Chapter = "play", Key = "action-efficiency", PrimaryKey = "income_action_focus_percent", TitleKey = "players.analysis.action_efficiency.title", DescriptionKey = "players.analysis.action_efficiency.desc", FormulaKey = "players.support.formula.action_efficiency", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("income_action_focus_percent"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "income_action_focus_components")) },
        new { Chapter = "play", Key = "meal-success", PrimaryKey = "ingredient_utilization_percent", TitleKey = "players.analysis.meal_success.title", DescriptionKey = "players.analysis.meal_success.desc", FormulaKey = "players.support.formula.order_success", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("ingredient_utilization_percent"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "ingredient_utilization_components")) },
        new { Chapter = "play", Key = "planning-horizon", PrimaryKey = "long_term_action_share_percent", TitleKey = "players.analysis.planning_horizon.title", DescriptionKey = "players.analysis.planning_horizon.desc", FormulaKey = "players.support.formula.planning", AdvancedOnly = true, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("long_term_action_share_percent"), ExcludeRows(PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "long_term_action_share_components"), "saving_actions", "financial_goal_actions")) },
        new { Chapter = "wellbeing", Key = "fulfillment-diversity", PrimaryKey = "need_fulfillment_diversity_percent", TitleKey = "players.analysis.fulfillment_diversity.title", DescriptionKey = "players.analysis.fulfillment_diversity.desc", FormulaKey = "players.support.formula.fulfillment", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("need_fulfillment_diversity_percent"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "need_fulfillment_diversity_components")) },
        new { Chapter = "wellbeing", Key = "donation-commitment", PrimaryKey = "donation_commitment_score", TitleKey = "players.analysis.donation_commitment.title", DescriptionKey = "players.analysis.donation_commitment.desc", FormulaKey = "players.support.formula.donation_commitment", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("donation_commitment_score"), PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "donation_commitment_components")) },
        new { Chapter = "wellbeing", Key = "happiness-portfolio", PrimaryKey = "happiness_source_diversity_percent", TitleKey = "players.analysis.happiness_portfolio.title", DescriptionKey = isAdvancedMode ? "players.analysis.happiness_portfolio.desc" : "players.analysis.happiness_portfolio.beginner.desc", FormulaKey = isAdvancedMode ? "players.support.formula.happiness_portfolio" : "players.support.formula.happiness_portfolio.beginner", AdvancedOnly = false, Rows = PlayerMetricCollectionHelper.MergeUniqueRows(SelectDerived("happiness_source_diversity_percent"), ExcludeAdvancedRowsInBeginner(PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "happiness_points_composition"), "financial_goal_points", "loan_penalty_points")) }
    }.Where(item => isAdvancedMode || !item.AdvancedOnly).ToList();
    var analysisChapters = new[]
    {
        new { Key = "money", TitleKey = "players.analysis.chapter.money.title", DescriptionKey = "players.analysis.chapter.money.desc", AdvancedOnly = false, Items = analysisSections.Where(item => item.Chapter == "money").ToList() },
        new { Key = "future", TitleKey = "players.analysis.chapter.future.title", DescriptionKey = "players.analysis.chapter.future.desc", AdvancedOnly = true, Items = analysisSections.Where(item => item.Chapter == "future").ToList() },
        new { Key = "play", TitleKey = "players.analysis.chapter.play.title", DescriptionKey = "players.analysis.chapter.play.desc", AdvancedOnly = false, Items = analysisSections.Where(item => item.Chapter == "play").ToList() },
        new { Key = "wellbeing", TitleKey = "players.analysis.chapter.wellbeing.title", DescriptionKey = "players.analysis.chapter.wellbeing.desc", AdvancedOnly = false, Items = analysisSections.Where(item => item.Chapter == "wellbeing").ToList() }
    }.Where(chapter => chapter.Items.Count > 0).ToList();

    var hasRawMetrics = rawSections.Any(section => section.Rows.Count > 0);
    string ReadDerivedValue(string key) =>
        derivedSummaryRows.FirstOrDefault(row => string.Equals(row.Path, key, StringComparison.OrdinalIgnoreCase)).Value
        ?? nullText;
    var netWorthMetric = PlayerMetricLabelFormatter.DescribeMetric("cash_growth_percent", ReadDerivedValue("cash_growth_percent"), true, isAdvancedMode, nullText, Context.T);

    var playerTurnOrder = Model.Summary?.PlayerOrder ?? 1;
    var playerAvatarPath = $"/images/players/{ResolvePlayerAvatarIndex(playerTurnOrder)}.png";
}

<section class="section-shell player-detail-overhaul">
    <div class="action-toolbar mb-4 player-detail-toolbar">
        @if (isInstructor)
        {
            <a class="btn-ghost"
               asp-controller="PlayerDirectory"
               asp-action="Index">@("<- " + Context.T("players.detail.nav_back_players"))</a>
        }
        <a class="btn-ghost"
           asp-controller="Sessions"
           asp-action="Details"
           asp-route-sessionId="@Model.SessionId">@("<- " + Context.T("players.detail.nav_back_session"))</a>
    </div>

    <div class="player-detail-hero">
        <div class="player-detail-hero-copy">
            <h1 class="headline">@Context.T("players.detail_title")</h1>
            <p class="player-detail-hero-subtitle">@Context.T("players.detail.subtitle")</p>
        </div>
        <div class="player-profile-identity">
            <span class="player-profile-avatar-shell">
                <img class="player-profile-avatar"
                     src="@playerAvatarPath"
                     alt="@($"{Context.T("common.turn_order")} {playerTurnOrder}")" />
            </span>
            <div class="player-profile-copy">
                <span class="player-profile-turn">@Context.T("common.turn_order") @playerTurnOrder</span>
                <p class="player-detail-name">@(string.IsNullOrWhiteSpace(Model.PlayerDisplayName) ? Context.T("common.player") : Model.PlayerDisplayName)</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mt-4 alert alert-error" aria-live="polite">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.GameplayErrorMessage))
    {
        <div class="mt-4 alert alert-warning" aria-live="polite">
            @Model.GameplayErrorMessage
        </div>
    }

    <div id="player-statistics-dashboard" class="players-fusion-metrics player-detail-section player-stats-dashboard">
        <details id="player-statistics-summary" class="player-dashboard-accordion player-dashboard-accordion--summary" data-player-section-accordion data-accordion-key="summary" open aria-labelledby="player-statistics-summary-title">
            <summary class="players-fusion-head ruleset-section-head player-stats-hero" data-player-stats-reveal>
                <div>
                    <p class="eyebrow">@Context.T("players.stats.badge")</p>
                    <h2 id="player-statistics-summary-title" class="ruleset-section-title">@Context.T("players.stats.title")</h2>
                    <p class="ruleset-section-subtitle">@Context.T("players.stats.subtitle")</p>
                </div>
            </summary>

            <div class="player-dashboard-accordion__body">
                <section class="player-analysis-overview player-stat-tone-@overallTone" data-player-stats-reveal aria-labelledby="player-analysis-overview-title">
                    <div class="player-analysis-overview__verdict">
                        <p class="player-stats-verdict__eyebrow">@Context.T("players.stats.verdict.title")</p>
                        <h3 id="player-analysis-overview-title">@Context.T(overallStatusKey)</h3>
                        <p>@Context.T(overallDescriptionKey)</p>
                    </div>
                    <dl class="player-analysis-scorecard" aria-label="@Context.T("players.analysis.scorecard.title")">
                        <div><dt>@Context.T("players.cashflow_journey.ending_cash")</dt><dd>@(endingCash.HasValue ? FormatNumber(endingCash.Value) : nullText)</dd></div>
                        <div><dt>@Context.T("metric.cash_net")</dt><dd>@(netCashflow.HasValue ? FormatSignedNumber(netCashflow.Value) : nullText)</dd></div>
                        <div><dt>@netWorthMetric.Label</dt><dd>@netWorthMetric.DisplayValue@netWorthMetric.Unit</dd></div>
                        <div><dt>@Context.T("metric.happiness")</dt><dd>@(happinessPoints.HasValue ? FormatNumber(happinessPoints.Value) : nullText)</dd></div>
                        <div><dt>@Context.T("metric.fulfillment_diversity")</dt><dd>@(needCardsOwned == 0 ? Context.T("players.stats.need_balance.none") : fulfillmentDiversity.HasValue ? fulfillmentDiversity.Value.ToString("P0", CultureInfo.CurrentCulture) : nullText)</dd></div>
                        <div class="player-analysis-scorecard__mission">
                            <dt>@Context.T("players.stats.mission.title")</dt>
                            <dd>@Context.T(statSummary.CollectionMissionComplete switch
                                {
                                    true => "players.stats.mission.complete",
                                    false => "players.stats.mission.incomplete",
                                    _ => "players.stats.mission.unavailable"
                                })</dd>
                        </div>
                    </dl>
                </section>

                <section class="player-stats-actions-section" data-player-stats-reveal aria-labelledby="player-stats-insights-title">
                    <div class="player-stats-section-heading ruleset-section-head">
                        <h3 id="player-stats-insights-title" class="ruleset-section-title">@Context.T("players.stats.insights_title")</h3>
                        <p class="ruleset-section-subtitle">@Context.T("players.stats.insights_desc")</p>
                    </div>
                    <ul class="player-stats-actions">
                        @foreach (var insight in statSummary.Insights.Take(3))
                        {
                            <li class="player-stat-action player-stat-tone-@insight.Tone">
                                <span class="player-stat-action__signal" aria-hidden="true"></span>
                                <div>
                                    <h4>@insight.Title</h4>
                                    <p>@insight.Description</p>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            </div>
        </details>

        <details id="player-analysis-atlas" class="player-analysis-atlas player-dashboard-accordion" data-player-section-accordion data-accordion-key="analysis" aria-labelledby="player-analysis-atlas-title">
            <summary class="player-analysis-section-head" data-player-stats-reveal>
                <div>
                    <p class="eyebrow">@Context.T("players.analysis.badge")</p>
                    <h3 id="player-analysis-atlas-title">@Context.T("players.analysis.title")</h3>
                    <p>@Context.T("players.analysis.desc")</p>
                </div>
            </summary>

            <div class="player-analysis-chapters">
                @foreach (var chapter in analysisChapters)
                {
                    <section class="player-analysis-chapter player-analysis-chapter--@chapter.Key" data-player-stats-reveal aria-labelledby="player-analysis-chapter-@chapter.Key">
                        <header class="player-analysis-chapter__head">
                            <div>
                                <h4 id="player-analysis-chapter-@chapter.Key">@Context.T(chapter.TitleKey)</h4>
                                <p>@Context.T(chapter.DescriptionKey)</p>
                            </div>
                            @if (chapter.AdvancedOnly)
                            {
                                <span class="player-analysis-card__mode">@Context.T("players.support.mode.advanced")</span>
                            }
                        </header>
                        <div class="player-analysis-grid">
                            @foreach (var analysis in chapter.Items)
                            {
                                <article class="player-analysis-card player-analysis-card--@analysis.Key">
                                    <div class="player-analysis-card__body">
                                        <header class="player-analysis-card__heading">
                                            <h5>@Context.T(analysis.TitleKey)</h5>
                                            @if (analysis.AdvancedOnly && !chapter.AdvancedOnly)
                                            {
                                                <span class="player-analysis-card__mode">@Context.T("players.support.mode.advanced")</span>
                                            }
                                        </header>
                                        <p class="player-analysis-card__description">@Context.T(analysis.DescriptionKey)</p>

                                        @{
                                            var primaryRow = analysis.Rows.FirstOrDefault(row =>
                                                row.Path.Equals(analysis.PrimaryKey, StringComparison.OrdinalIgnoreCase));
                                            var supportingRows = analysis.Rows
                                                .Where(row => !row.Path.Equals(analysis.PrimaryKey, StringComparison.OrdinalIgnoreCase))
                                                .ToList();
                                            var supportingGridColumns = ResolveCardColumns(supportingRows.Count);
                                        }
                                        @if (string.IsNullOrWhiteSpace(primaryRow.Path))
                                        {
                                            <p class="player-analysis-card__empty">@nullText</p>
                                        }
                                        else
                                        {
                                            var primaryMetric = PlayerMetricLabelFormatter.DescribeMetric(
                                                primaryRow.Path,
                                                primaryRow.Value,
                                                true,
                                                isAdvancedMode,
                                                nullText,
                                                Context.T);
                                            var calculationKey = analysis.Key == "happiness-portfolio" && !isAdvancedMode
                                                ? "happiness-portfolio-beginner"
                                                : analysis.Key;
                                            var sourceKey = analysis.Key == "happiness-portfolio" && !isAdvancedMode
                                                ? "players.analysis.source.happiness-portfolio.beginner"
                                                : $"players.analysis.source.{analysis.Key}";
                                            var actualCalculation = PlayerMetricCollectionHelper.BuildActualCalculation(
                                                calculationKey,
                                                analysis.Rows,
                                                primaryMetric.DisplayValue,
                                                primaryMetric.Unit,
                                                nullText,
                                                CultureInfo.CurrentCulture);
                                            <div class="player-analysis-card__takeaway">
                                                <div>
                                                    <span>@primaryMetric.Label</span>
                                                    <strong>@primaryMetric.DisplayValue<small>@primaryMetric.Unit</small></strong>
                                                </div>
                                                <p>
                                                    <strong>@Context.T("players.analysis.reading")</strong>
                                                    @if (analysis.Key == "goal-ambition" && primaryMetric.State is "recorded" or "zero")
                                                    {
                                                        var purchaseCost = PlayerMetricLabelFormatter.DescribeMetric(
                                                            "financial_goals_purchase_cost_total",
                                                            analysis.Rows.FirstOrDefault(row => row.Path == "financial_goals_purchase_cost_total").Value ?? nullText,
                                                            false, isAdvancedMode, nullText, Context.T);
                                                        @string.Format(CultureInfo.CurrentCulture, Context.T("players.analysis.goal_purchases.result"), purchaseCost.DisplayValue)
                                                    }
                                                    else
                                                    {
                                                        @primaryMetric.Guidance
                                                    }
                                                </p>
                                            </div>

                                            @if (analysis.Key == "goal-ambition"
                                                && PlayerMetricLabelFormatter.TryParseMetricNumber(primaryRow.Value, out var purchasedGoalCount) && purchasedGoalCount > 0
                                                && PlayerMetricLabelFormatter.TryParseMetricNumber(financialGoalRows.FirstOrDefault(row => row.Path == "sharia_loans_outstanding_coins").Value, out var outstandingGoalLoan) && outstandingGoalLoan > 0)
                                            {
                                                <p class="player-analysis-card__description">@Context.T("players.analysis.goal_purchases.unpaid_loan")</p>
                                            }

                                            <details class="player-analysis-card__method">
                                                <summary>@Context.T("players.analysis.details")</summary>
                                                @if (supportingRows.Count > 0)
                                                {
                                                    <dl class="player-analysis-card__metrics player-analysis-card__metrics--columns-@supportingGridColumns">
                                                        @foreach (var row in supportingRows)
                                                        {
                                                            var metric = PlayerMetricLabelFormatter.DescribeMetric(
                                                                row.Path,
                                                                row.Value,
                                                                true,
                                                                isAdvancedMode,
                                                                nullText,
                                                                Context.T);
                                                            <div class="player-analysis-card__metric player-analysis-card__metric--@metric.State">
                                                                <dt>@metric.Label</dt>
                                                                <dd>
                                                                    <strong>@metric.DisplayValue</strong>
                                                                    @if (!string.IsNullOrWhiteSpace(metric.Unit))
                                                                    {
                                                                        <small>@metric.Unit</small>
                                                                    }
                                                                </dd>
                                                            </div>
                                                        }
                                                    </dl>
                                                }
                                                <dl class="player-analysis-card__method-notes">
                                                    <div>
                                                        <dt>@Context.T("players.support.field.source")</dt>
                                                        <dd>@Context.T(sourceKey)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>@Context.T("players.support.field.formula")</dt>
                                                        <dd>@Context.T(analysis.FormulaKey)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>@Context.T("players.support.field.actual_calculation")</dt>
                                                        <dd>@actualCalculation</dd>
                                                    </div>
                                                    <div>
                                                        <dt>@Context.T("players.support.field.recommendation")</dt>
                                                        <dd>@primaryMetric.Recommendation</dd>
                                                    </div>
                                                </dl>
                                            </details>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        </details>

        <details id="player-evidence-library" class="player-evidence-library player-dashboard-accordion" data-player-section-accordion data-accordion-key="evidence" data-player-stats-reveal aria-labelledby="player-evidence-library-title">
            <summary class="player-analysis-section-head">
                <div>
                    <p class="eyebrow">@Context.T("players.evidence.badge")</p>
                    <h3 id="player-evidence-library-title">@Context.T("players.evidence.title")</h3>
                    <p>@Context.T("players.evidence.desc")</p>
                </div>
            </summary>

            @if (!hasRawMetrics)
            {
                <div class="alert alert-info" aria-live="polite">@Context.T("players.detail.empty_analytics")</div>
            }
            else
            {
                <div class="player-evidence-domain-list">
                    @for (var domainIndex = 0; domainIndex < rawSections.Count; domainIndex++)
                    {
                        var domain = rawSections[domainIndex];
                        var orderedDomainRows = domain.Key switch
                        {
                            "meal-orders" => domain.Rows.OrderBy(row => row.Path switch
                            {
                                "meal_orders_claimed" => 0,
                                "meal_order_income_per_order" => 1,
                                "meal_order_income_total" => 2,
                                "meal_orders_per_turn_average" => 3,
                                _ => 4
                            }).ToList(),
                            "donations" => domain.Rows.OrderBy(row => row.Path switch
                            {
                                "donation_history" => 0,
                                "donation_total_coins" => 1,
                                "donation_champion_cards_earned" => 2,
                                "donation_happiness_points" => 3,
                                _ => 4
                            }).ToList(),
                            "life-risk" => domain.Rows.OrderBy(row => row.Path switch
                            {
                                "life_risk_cards_drawn" => 0,
                                "life_risk_costs_per_card" => 1,
                                "life_risk_costs_total" => 2,
                                _ => 3
                            }).ToList(),
                            "gold" => domain.Rows.OrderBy(row => row.Path switch
                            {
                                "gold_cards_initial" => 0,
                                "gold_cards_purchased" => 1,
                                "gold_cards_sold" => 2,
                                "gold_cards_held_end" => 3,
                                "gold_prices_per_purchase" => 4,
                                "gold_price_per_sale" => 5,
                                "gold_investment_coins_spent" => 6,
                                "gold_investment_coins_earned" => 7,
                                "gold_investment_net" => 8,
                                _ => 9
                            }).ToList(),
                            _ => domain.Rows
                        };
                        var domainGuides = orderedDomainRows
                            .Select(row => PlayerMetricLabelFormatter.DescribeMetric(
                                row.Path,
                                row.Value,
                                false,
                                isAdvancedMode,
                                nullText,
                                Context.T))
                            .GroupBy(metric => (metric.Guidance, metric.Recommendation))
                            .Select(group => new
                            {
                                Labels = string.Join(", ", group.Select(metric => metric.Label).Distinct(StringComparer.CurrentCultureIgnoreCase)),
                                group.Key.Guidance,
                                group.Key.Recommendation
                            })
                            .ToList();
                        var scalarMetricCount = orderedDomainRows.Count(row => !IsCollectionValue(row.Value));
                        var scalarGridColumns = ResolveCardColumns(scalarMetricCount);
                        var scalarGridClass = $"player-metric-card-grid--columns-{scalarGridColumns}";
                        var domainGridClass = domain.Key switch
                        {
                            "coin-finance" => "player-metric-card-grid--coin-finance",
                            "meal-orders" => "player-metric-card-grid--meal-orders",
                            "donations" => "player-metric-card-grid--donations",
                            "gold" => "player-metric-card-grid--gold",
                            _ => string.Empty
                        };
                        <details class="player-evidence-domain" @(domainIndex == 0 ? "open" : null)>
                            <summary>
                                <span class="player-evidence-domain__copy">
                                    <strong>@Context.T(domain.TitleKey)</strong>
                                    <small>@Context.T(domain.DescriptionKey)</small>
                                </span>
                                @if (domain.AdvancedOnly)
                                {
                                    <span class="player-evidence-domain__mode">@Context.T("players.support.mode.advanced")</span>
                                }
                            </summary>

                            @if (domainGuides.Count > 0 && domain.Key != "financial-goals")
                            {
                                <details class="player-evidence-domain__guide">
                                    <summary>@Context.T("players.stats.library.read_metric")</summary>
                                    <dl>
                                        @foreach (var guide in domainGuides)
                                        {
                                            <div>
                                                <dt>@guide.Labels</dt>
                                                <dd>@guide.Guidance</dd>
                                                <dd class="player-evidence-domain__recommendation"><strong>@Context.T("players.support.field.recommendation"):</strong> @guide.Recommendation</dd>
                                            </div>
                                        }
                                    </dl>
                                </details>
                            }

                            <div class="player-metric-card-grid @scalarGridClass @domainGridClass">
                                @foreach (var row in orderedDomainRows)
                                {
                                    var metric = PlayerMetricLabelFormatter.DescribeMetric(
                                        row.Path,
                                        row.Value,
                                        false,
                                        isAdvancedMode,
                                        nullText,
                                        Context.T);
                                    var isCollectionValue = IsCollectionValue(row.Value);
                                    var isIngredientOrderSeries = domain.Key == "ingredients" && row.Path == "ingredients_used_per_meal";
                                    var isLifeRiskFeatured = domain.Key == "life-risk"
                                        && row.Path is "life_risk_cards_drawn" or "life_risk_costs_total";
                                    var isMealOrderPrimary = domain.Key == "meal-orders" && row.Path == "meal_orders_claimed";
                                    var isMealOrderSummary = domain.Key == "meal-orders"
                                        && row.Path is "meal_order_income_total" or "meal_orders_per_turn_average";
                                    var isGoldOverview = domain.Key == "gold"
                                        && row.Path is "gold_cards_initial" or "gold_cards_purchased" or "gold_cards_sold" or "gold_cards_held_end";
                                    var isCoinOverview = domain.Key == "coin-finance"
                                        && row.Path is "starting_coins" or "coins_held_current";
                                    var collectionTable = isCollectionValue
                                        ? PlayerMetricJsonMapper.BuildCollectionTable(row.Value, trueText, falseText, nullText)
                                        : null;
                                    <article class="player-metric-card player-metric-card--@metric.State @(isCollectionValue ? "player-metric-card--series" : null) @(isLifeRiskFeatured ? "player-metric-card--featured" : null) @(isMealOrderPrimary ? "player-metric-card--meal-orders-primary" : null) @(isMealOrderSummary ? "player-metric-card--meal-orders-summary" : null) @(isGoldOverview ? "player-metric-card--gold-overview" : null) @(isCoinOverview ? "player-metric-card--coin-overview" : null)">
                                        <div class="player-metric-card__heading">
                                            <h5>@metric.Label</h5>
                                            @if (metric.State != "recorded" && !(domain.Key == "financial-goals" && metric.State == "zero"))
                                            {
                                                <span>@Context.T($"players.support.state.{metric.State}")</span>
                                            }
                                        </div>
                                        @if (collectionTable is not null)
                                        {
                                            var collectionUnits = collectionTable.Columns.ToDictionary(
                                                column => column,
                                                column => IsCollectionContextColumn(column)
                                                    ? string.Empty
                                                    : PlayerMetricLabelFormatter.DescribeMetric(
                                                        $"{row.Path}.{column}",
                                                        "0",
                                                        false,
                                                        isAdvancedMode,
                                                        nullText,
                                                        Context.T).Unit,
                                                StringComparer.OrdinalIgnoreCase);
                                            var seriesRows = collectionTable.Rows.ToList();
                                            <div class="player-metric-series" role="region" aria-label="@metric.Label" tabindex="0">
                                                @if (seriesRows.Count > 0)
                                                {
                                                <table>
                                                    <thead>
                                                        <tr>
                                                            @foreach (var column in collectionTable.Columns)
                                                            {
                                                                var columnLabel = (row.Path, column) switch
                                                                {
                                                                    ("ingredients_used_per_meal" or "meal_order_income_per_order", "item_index") => Context.T("players.details.order_number"),
                                                                    ("ingredients_used_per_meal", "value") => Context.T("players.details.ingredients.cards_used"),
                                                                    ("meal_order_income_per_order", "value") => Context.T("players.details.meal_orders.income"),
                                                                    ("donation_history", "amount") => Context.T("players.details.donations.amount"),
                                                                    _ => PlayerMetricLabelFormatter.HumanizeMetricKey(column, Context.T)
                                                                };
                                                                <th scope="col">
                                                                    @columnLabel
                                                                    @if (!isIngredientOrderSeries && !string.IsNullOrWhiteSpace(collectionUnits[column]))
                                                                    {
                                                                        <small>(@collectionUnits[column])</small>
                                                                    }
                                                                </th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var seriesRow in seriesRows)
                                                        {
                                                            var isSetup = collectionTable.Columns.Zip(seriesRow)
                                                                .Any(cell => cell.First == "day_index" && cell.Second == "0");
                                                            <tr>
                                                                @for (var cellIndex = 0; cellIndex < seriesRow.Count; cellIndex++)
                                                                {
                                                                    <td>@FormatCollectionCell(row.Path, collectionTable.Columns[cellIndex], seriesRow[cellIndex], isAdvancedMode, nullText, isSetup)</td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="player-metric-card__value">
                                                <strong>@metric.DisplayValue</strong>
                                                @if (!string.IsNullOrWhiteSpace(metric.Unit))
                                                {
                                                    <small>@metric.Unit</small>
                                                }
                                            </p>
                                        }
                                        <p class="player-metric-card__explanation">
                                            @if (domain.Key == "financial-goals" && row.Path == "financial_goals_completed"
                                                && PlayerMetricLabelFormatter.TryParseMetricNumber(attemptedFinancialGoals, out var attemptedCount)
                                                && attemptedCount >= 0)
                                            {
                                                @string.Format(CultureInfo.CurrentCulture, Context.T("players.details.financial_goals.attempted_note"), FormatNumber(attemptedCount))
                                            }
                                            else
                                            {
                                                @metric.Explanation
                                            }
                                            @if (domain.Key == "ingredients" && row.Path == "ingredients_held_current"
                                                && PlayerMetricLabelFormatter.TryParseMetricNumber(discardedIngredients, out var discardedCount)
                                                && discardedCount > 0)
                                            {
                                                @string.Format(CultureInfo.CurrentCulture, Context.T("players.details.ingredients.discarded_note"), FormatNumber(discardedCount))
                                            }
                                        </p>
                                    </article>
                                }
                            </div>
                        </details>
                    }
                </div>
            }
        </details>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const storageKey = "cashflowpoly.player-section-accordions";
            const accordions = Array.from(document.querySelectorAll("[data-player-section-accordion]"));
            let savedState = {};

            try {
                savedState = JSON.parse(localStorage.getItem(storageKey) ?? "{}") ?? {};
            } catch {
                savedState = {};
            }

            accordions.forEach((accordion) => {
                const key = accordion.dataset.accordionKey;
                if (key && Object.prototype.hasOwnProperty.call(savedState, key)) {
                    accordion.open = savedState[key] === true;
                }

                accordion.addEventListener("toggle", () => {
                    if (!key) return;
                    savedState[key] = accordion.open;
                    try {
                        localStorage.setItem(storageKey, JSON.stringify(savedState));
                    } catch {
                        // The accordion still works when browser storage is unavailable.
                    }
                });
            });
        })();
    </script>
}
