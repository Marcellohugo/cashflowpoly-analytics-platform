@* Fungsi file: Merender tampilan Razor untuk bagian Players/Details.cshtml beserta interaksi presentasinya. *@
@using System.Globalization
@using System.Text.Json
@using Cashflowpoly.Ui.Infrastructure
@model Cashflowpoly.Ui.Models.PlayerDetailViewModel

@{
    ViewData["Title"] = Context.T("players.detail_title");
    var isInstructor = Context.Session.IsInstructor();

    string LocalizeTransactionDetail(string rawDetail)
    {
        return PlayerMetricLabelFormatter.LocalizeTransactionDetail(rawDetail, Context.T);
    }

    static int ResolvePlayerAvatarIndex(int turnOrder)
    {
        if (turnOrder <= 0)
        {
            return 1;
        }

        return ((turnOrder - 1) % 4) + 1;
    }

    string FormatNumber(double value) => value.ToString("N0", CultureInfo.CurrentCulture);
    string FormatSignedNumber(double value) => value > 0 ? $"+{FormatNumber(value)}" : FormatNumber(value);

    var cashflowJourney = Model.CashflowJourney;
    var statSummary = Model.StatSummary ?? new PlayerStatSummaryViewModel();
    var totalCashIn = Model.Summary?.CashInTotal ?? cashflowJourney?.TotalCashIn ?? 0d;
    var totalCashOut = Model.Summary?.CashOutTotal ?? cashflowJourney?.TotalCashOut ?? 0d;
    var netCashflow = totalCashIn - totalCashOut;
    var endingCash = (cashflowJourney?.StartingCash ?? 0d) + netCashflow;
    var primaryNeedRate = Model.Summary?.CompliancePrimaryNeedRate ?? 0d;
    var ruleViolations = Model.Summary?.RulesViolationsCount ?? 0;
    var happinessPointsAdded = Model.Summary is null
        ? 0d
        : Model.Summary.NeedPointsTotal
          + Model.Summary.NeedSetBonusPoints
          + Model.Summary.DonationPointsTotal
          + Model.Summary.GoldPointsTotal
          + Model.Summary.PensionPointsTotal
          + Model.Summary.SavingGoalPointsTotal;
    var happinessPointsDeducted = Model.Summary is null
        ? 0d
        : Model.Summary.MissionPenaltyTotal + Model.Summary.LoanPenaltyTotal;
    var financeMeaningKey = netCashflow > 0
        ? "players.stats.focus.money.positive"
        : netCashflow < 0
            ? "players.stats.focus.money.negative"
            : "players.stats.focus.money.balanced";
    var behaviorMeaningKey = primaryNeedRate < 0.75 || ruleViolations > 0
        ? "players.stats.focus.behavior.review"
        : "players.stats.focus.behavior.good";
    var happinessMeaningKey = happinessPointsDeducted > 0
        ? "players.stats.focus.happiness.with_deduction"
        : "players.stats.focus.happiness.no_deduction";
    var financeRecommendationKey = $"{financeMeaningKey}.recommendation";
    var behaviorRecommendationKey = $"{behaviorMeaningKey}.recommendation";
    var happinessRecommendationKey = $"{happinessMeaningKey}.recommendation";
    var happinessPoints = Model.Summary?.HappinessPointsTotal ?? 0d;
    var hasUnpaidLoan = Model.Summary?.HasUnpaidLoan ?? false;
    var financeTone = netCashflow < 0 ? "warning" : netCashflow > 0 ? "positive" : "neutral";
    var behaviorTone = primaryNeedRate < 0.75 || ruleViolations > 0 ? "warning" : "positive";
    var happinessTone = happinessPoints >= 60 ? "positive" : happinessPoints < 20 ? "warning" : "neutral";
    var overallTone = hasUnpaidLoan
        ? "danger"
        : netCashflow < 0 || primaryNeedRate < 0.75 || ruleViolations > 0 || happinessPoints < 20
            ? "warning"
            : netCashflow > 0 && primaryNeedRate >= 0.9 && happinessPoints >= 60
                ? "positive"
                : "neutral";
    var overallStatusKey = $"players.stats.status.{overallTone}";
    var overallDescriptionKey = $"players.stats.status.{overallTone}.desc";

    var trueText = Context.T("players.support.value.yes");
    var falseText = Context.T("players.support.value.no");
    var nullText = Context.T("players.support.value.unavailable");
    var rawGroupMap = PlayerMetricJsonMapper
        .BuildMetricGroups(Model.GameplayRaw, trueText, falseText, nullText)
        .ToDictionary(group => group.GroupKey, group => group.Rows, StringComparer.OrdinalIgnoreCase);
    var derivedGroupMap = PlayerMetricJsonMapper
        .BuildMetricGroups(Model.GameplayDerived, trueText, falseText, nullText)
        .ToDictionary(group => group.GroupKey, group => group.Rows, StringComparer.OrdinalIgnoreCase);
    // Curate this section explicitly so new backend fields do not automatically
    // turn the player page into a duplicate data dump.
    var rawMetricKeysToShow = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "starting_coins",
        "ingredients_collected",
        "ingredients_held_current",
        "ingredients_used_total",
        "ingredients_wasted",
        "ingredient_investment_coins_total",
        "meal_orders_available_passed",
        "meal_order_income_total",
        "need_cards_purchased",
        "primary_needs_owned",
        "secondary_needs_owned",
        "tertiary_needs_owned",
        "collection_mission_complete",
        "need_cards_coins_spent",
        "donation_total_coins",
        "donation_champion_cards_earned",
        "gold_cards_purchased",
        "gold_cards_sold",
        "gold_cards_held_end",
        "gold_investment_coins_spent",
        "gold_investment_coins_earned",
        "pension_fund_total",
        "life_risks_accepted",
        "life_risk_costs_total",
        "life_risk_mitigated_with_insurance",
        "insurance_payments_made",
        "emergency_options_used",
        "financial_goals_available_total",
        "financial_goals_attempted",
        "financial_goals_completed",
        "financial_goals_coins_total_invested",
        "financial_goals_incomplete_coins_wasted",
        "sharia_loans_taken",
        "sharia_loans_repaid",
        "sharia_loans_unpaid_end"
    };
    foreach (var rows in rawGroupMap.Values)
    {
        rows.RemoveAll(row =>
        {
            var separatorIndex = row.Path.IndexOfAny(['.', '[']);
            var rootKey = separatorIndex < 0 ? row.Path : row.Path[..separatorIndex];
            return !rawMetricKeysToShow.Contains(rootKey);
        });
    }
    var derivedSummaryRows = PlayerMetricCollectionHelper.GetGroupRows(derivedGroupMap, "summary");
    var redundantDerivedMetricKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "income_diversification_ratio",
        "goal_ambition",
        "action_efficiency",
        "planning_horizon",
        "risk_appetite_score_normalized",
        "donation_ratio",
        "donation_stability",
        "mission_achievement",
        "p_primary",
        "p_secondary",
        "p_tertiary",
        "total_income",
        "total_expenses",
        "transaction_count",
        "insurance_activation_rate",
        "growth_pattern_ratio",
        "debt_ratio",
        "sharia_loans_outstanding_coins"
    };
    foreach (var rows in derivedGroupMap.Values)
    {
        rows.RemoveAll(row => redundantDerivedMetricKeys.Contains(row.Path));
    }
    derivedSummaryRows.RemoveAll(row => redundantDerivedMetricKeys.Contains(row.Path));

    var rawSections = new[]
    {
        new { Key = "coin-finance", TitleKey = "players.details.raw.coin_finance.title", DescriptionKey = "players.details.raw.coin_finance.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "coins") },
        new { Key = "ingredients", TitleKey = "players.details.raw.ingredients.title", DescriptionKey = "players.details.raw.ingredients.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "ingredients") },
        new { Key = "meal-orders", TitleKey = "players.details.raw.meal_orders.title", DescriptionKey = "players.details.raw.meal_orders.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "meal_orders") },
        new { Key = "needs", TitleKey = "players.details.raw.needs.title", DescriptionKey = "players.details.raw.needs.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "needs") },
        new { Key = "donations", TitleKey = "players.details.raw.donations.title", DescriptionKey = "players.details.raw.donations.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "donations") },
        new { Key = "gold", TitleKey = "players.details.raw.gold.title", DescriptionKey = "players.details.raw.gold.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "gold") },
        new { Key = "pension", TitleKey = "players.details.raw.pension.title", DescriptionKey = "players.details.raw.pension.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "pension") },
        new { Key = "life-risk", TitleKey = "players.details.raw.life_risk.title", DescriptionKey = "players.details.raw.life_risk.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "life_risk") },
        new { Key = "financial-goals", TitleKey = "players.details.raw.financial_goals.title", DescriptionKey = "players.details.raw.financial_goals.desc", Rows = PlayerMetricCollectionHelper.GetGroupRows(rawGroupMap, "financial_goals") }
    }.Where(section => section.Rows.Count > 0).ToList();

    var derivedSections = new[]
    {
        new { Key = "financial", TitleKey = "players.details.derived.financial.title", DescriptionKey = "players.details.derived.financial.desc", Rows = PlayerMetricCollectionHelper.FilterRowsByKeywords(derivedSummaryRows, "net_worth", "income_diversification", "expense_management", "business_profit", "business_efficiency", "gold_roi") },
        new { Key = "strategy", TitleKey = "players.details.derived.strategy.title", DescriptionKey = "players.details.derived.strategy.desc", Rows = PlayerMetricCollectionHelper.FilterRowsByKeywords(derivedSummaryRows, "risk_", "debt_", "loan_", "goal_", "sharia_") },
        new { Key = "behavior", TitleKey = "players.details.derived.behavior.title", DescriptionKey = "players.details.derived.behavior.desc", Rows = PlayerMetricCollectionHelper.FilterRowsByKeywords(derivedSummaryRows, "action_", "meal_order_", "planning_") },
        new { Key = "flourishing", TitleKey = "players.details.derived.flourishing.title", DescriptionKey = "players.details.derived.flourishing.desc", Rows = PlayerMetricCollectionHelper.FilterRowsByKeywords(derivedSummaryRows, "fulfillment_", "mission_", "donation_", "friday_", "happiness_") }
    }.Where(section => section.Rows.Count > 0).ToList();

    var rawMetricCount = rawSections.Sum(section => section.Rows.Count);
    var derivedMetricCount = derivedSections.Sum(section => section.Rows.Count);
    var isAdvancedMode = Model.GameplayRaw.HasValue
        && Model.GameplayRaw.Value.ValueKind == JsonValueKind.Object
        && Model.GameplayRaw.Value.TryGetProperty("metadata", out var gameplayMetadata)
        && gameplayMetadata.ValueKind == JsonValueKind.Object
        && gameplayMetadata.TryGetProperty("game_mode", out var gameplayMode)
        && string.Equals(gameplayMode.GetString(), "advanced", StringComparison.OrdinalIgnoreCase);
    var metricCollections = new[]
    {
        new { Key = "derived", TitleKey = "players.details.derived_title", DescriptionKey = "players.metrics_derived_desc", Count = derivedMetricCount, IsDerived = true, Sections = derivedSections },
        new { Key = "raw", TitleKey = "players.details.raw_title", DescriptionKey = "players.metrics_raw_desc", Count = rawMetricCount, IsDerived = false, Sections = rawSections }
    };

    var playerTurnOrder = Model.Summary?.PlayerOrder ?? 1;
    var playerAvatarPath = $"/images/players/{ResolvePlayerAvatarIndex(playerTurnOrder)}.png";
}

<section class="section-shell player-detail-overhaul">
    <div class="player-detail-hero">
        <div class="player-detail-hero-copy">
            <p class="eyebrow">@Context.T("players.analytics_title")</p>
            <h1 class="headline">@Context.T("players.detail_title")</h1>
            <p class="player-detail-hero-subtitle">@Context.T("players.detail.subtitle")</p>
        </div>
        <div class="player-profile-identity">
            <span class="player-profile-avatar-shell">
                <img class="player-profile-avatar"
                     src="@playerAvatarPath"
                     alt="@($"{Context.T("common.turn_order")} {playerTurnOrder}")" />
            </span>
            <div class="player-profile-copy">
                <span class="player-profile-turn">@Context.T("common.turn_order") @playerTurnOrder</span>
                <p class="player-detail-name">@(string.IsNullOrWhiteSpace(Model.PlayerDisplayName) ? Context.T("common.player") : Model.PlayerDisplayName)</p>
                @if (Model.GameplayComputedAt.HasValue)
                {
                    <span class="player-detail-meta__item">@Context.T("common.computed"): @Model.GameplayComputedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                }
            </div>
        </div>
    </div>

    <div class="action-toolbar mt-4 player-detail-toolbar">
        @if (isInstructor)
        {
            <a class="btn-ghost"
               asp-controller="PlayerDirectory"
               asp-action="Index">@("<- " + Context.T("players.detail.nav_back_players"))</a>
        }
        <a class="btn-ghost"
           asp-controller="Sessions"
           asp-action="Details"
           asp-route-sessionId="@Model.SessionId">@("<- " + Context.T("players.detail.nav_back_session"))</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mt-4 alert alert-error" aria-live="polite">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.GameplayErrorMessage))
    {
        <div class="mt-4 alert alert-warning" aria-live="polite">
            @Model.GameplayErrorMessage
        </div>
    }

    <details id="player-transaction-history" class="players-fusion-metrics player-detail-section mt-6 player-transactions-section data-toggle">
        <summary class="players-fusion-head ruleset-section-head">
            <p class="eyebrow">@Context.T("players.cashflow_journey.badge")</p>
            <h2 class="ruleset-section-title">@Context.T("players.transaction_history")</h2>
            <p class="ruleset-section-subtitle">@Context.T("players.cashflow_journey.subtitle")</p>
        </summary>

        <div class="mt-4 table-wrap">
            <table class="w-full text-left text-sm mobile-card-table">
                <thead class="table-head">
                    <tr>
                        <th class="px-4 py-3">@Context.T("common.time")</th>
                        <th class="px-4 py-3">@Context.T("common.category")</th>
                        <th class="px-4 py-3 text-center">@Context.T("common.direction")</th>
                        <th class="px-4 py-3 text-right">@Context.T("common.transaction_amount")</th>
                        <th class="px-4 py-3 text-right">@Context.T("common.running_balance")</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Transactions == null || Model.Transactions.Count == 0)
                {
                    <tr>
                        <td class="px-4 py-4 text-slate-500 mobile-card-empty" colspan="5">@Context.T("players.no_transactions")</td>
                    </tr>
                }
                else
                {
                    var runningBal = Model.CashflowJourney?.StartingCash ?? 20.0;
                    foreach (var tx in Model.Transactions.OrderBy(t => t.Timestamp))
                    {
                        var isIncoming = string.Equals(tx.Direction, "IN", StringComparison.OrdinalIgnoreCase);
                        if (isIncoming)
                        {
                            runningBal += tx.Amount;
                        }
                        else if (string.Equals(tx.Direction, "OUT", StringComparison.OrdinalIgnoreCase))
                        {
                            runningBal -= tx.Amount;
                        }
                        var directionPillClass = isIncoming ? "status-active" : "status-retired";
                        var amountClass = isIncoming ? "text-emerald-700 font-semibold" : "text-rose-700 font-semibold";
                        var sign = isIncoming ? "+" : "-";

                        <tr class="border-t border-slate-200">
                            <td class="px-4 py-3 text-slate-700 font-mono text-xs" data-label="@Context.T("common.time")">
                                @tx.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td class="px-4 py-3 font-medium text-slate-900" data-label="@Context.T("common.category")">
                                @LocalizeTransactionDetail($"{tx.Direction} - {tx.Category} ({tx.Amount})")
                            </td>
                            <td class="px-4 py-3 text-center" data-label="@Context.T("common.direction")">
                                <span class="status-pill @directionPillClass">@tx.Direction</span>
                            </td>
                            <td class="px-4 py-3 text-right @amountClass" data-label="@Context.T("common.transaction_amount")">
                                @sign@tx.Amount.ToString("N0", CultureInfo.CurrentCulture)
                            </td>
                            <td class="px-4 py-3 text-right font-mono text-slate-900" data-label="@Context.T("common.running_balance")">
                                @runningBal.ToString("N0", CultureInfo.CurrentCulture)
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </details>

    <div id="player-statistics-dashboard" class="players-fusion-metrics player-detail-section player-stats-dashboard">
        <div class="players-fusion-head ruleset-section-head player-stats-hero">
            <div>
                <p class="eyebrow">@Context.T("players.stats.badge")</p>
                <h2 class="ruleset-section-title">@Context.T("players.stats.title")</h2>
                <p class="ruleset-section-subtitle">@Context.T("players.stats.subtitle")</p>
            </div>
            <span class="player-stats-read-pill">@Context.T("players.stats.read_time")</span>
        </div>

        <section class="player-stats-verdict player-stat-tone-@overallTone" aria-labelledby="player-stats-verdict-title">
            <div>
                <p class="player-stats-verdict__eyebrow">@Context.T("players.stats.verdict.title")</p>
                <h3 id="player-stats-verdict-title">@Context.T(overallStatusKey)</h3>
                <p>@Context.T(overallDescriptionKey)</p>
            </div>
            <div class="player-stats-verdict__signals" aria-label="@Context.T("players.stats.verdict.title")">
                <div><span>@Context.T("players.cashflow_journey.ending_cash")</span><strong>@FormatNumber(endingCash)</strong></div>
                <div><span>@Context.T("metric.happiness")</span><strong>@FormatNumber(happinessPoints)</strong></div>
                <div><span>@Context.T("metric.primary_need_compliance")</span><strong>@primaryNeedRate.ToString("P0", CultureInfo.CurrentCulture)</strong></div>
            </div>
        </section>

        <section class="player-stats-pillars" aria-labelledby="player-stats-pillars-title">
            <div class="player-stats-section-heading ruleset-section-head">
                <h3 id="player-stats-pillars-title" class="ruleset-section-title">@Context.T("players.stats.pillars.title")</h3>
                <p class="ruleset-section-subtitle">@Context.T("players.stats.pillars.desc")</p>
            </div>

            <div class="player-stats-pillar-grid">
                <article class="player-stat-pillar player-stat-pillar--money player-stat-pillar--@financeTone">
                    <div class="player-stat-pillar__heading">
                        <h4>@Context.T("players.stats.focus.money.title")</h4>
                        <p>@Context.T("players.stats.focus.money.question")</p>
                    </div>
                    <div class="player-stat-pillar__score">
                        <span>@Context.T("players.stats.pillar.main_result")</span>
                        <strong>@FormatSignedNumber(netCashflow)</strong>
                    </div>
                    <p class="player-stat-pillar__summary">@Context.T(financeMeaningKey)</p>
                    <p class="player-stat-pillar__recommendation"><strong>@Context.T("players.stats.pillar.recommendation")</strong> @Context.T(financeRecommendationKey)</p>
                    <dl class="player-stat-pillar__metrics">
                        <div><dt>@Context.T("metric.cash_in")</dt><dd>@FormatNumber(totalCashIn)</dd></div>
                        <div><dt>@Context.T("metric.cash_out")</dt><dd>@FormatNumber(totalCashOut)</dd></div>
                        <div><dt>@Context.T("players.cashflow_journey.ending_cash")</dt><dd>@FormatNumber(endingCash)</dd></div>
                    </dl>
                </article>

                <article class="player-stat-pillar player-stat-pillar--behavior player-stat-pillar--@behaviorTone">
                    <div class="player-stat-pillar__heading">
                        <h4>@Context.T("players.stats.focus.behavior.title")</h4>
                        <p>@Context.T("players.stats.focus.behavior.question")</p>
                    </div>
                    <div class="player-stat-pillar__score">
                        <span>@Context.T("players.stats.pillar.main_result")</span>
                        <strong>@primaryNeedRate.ToString("P0", CultureInfo.CurrentCulture)</strong>
                    </div>
                    <p class="player-stat-pillar__summary">@Context.T(behaviorMeaningKey)</p>
                    <p class="player-stat-pillar__recommendation"><strong>@Context.T("players.stats.pillar.recommendation")</strong> @Context.T(behaviorRecommendationKey)</p>
                    <dl class="player-stat-pillar__metrics">
                        <div><dt>@Context.T("metric.violations")</dt><dd>@ruleViolations</dd></div>
                        <div><dt>@Context.T("metric.orders_completed")</dt><dd>@(Model.Summary?.OrdersCompletedCount ?? 0)</dd></div>
                    </dl>
                </article>

                <article class="player-stat-pillar player-stat-pillar--happiness player-stat-pillar--@happinessTone">
                    <div class="player-stat-pillar__heading">
                        <h4>@Context.T("players.stats.focus.happiness.title")</h4>
                        <p>@Context.T("players.stats.focus.happiness.question")</p>
                    </div>
                    <div class="player-stat-pillar__score">
                        <span>@Context.T("players.stats.pillar.main_result")</span>
                        <strong>@FormatNumber(happinessPoints)</strong>
                    </div>
                    <p class="player-stat-pillar__summary">@Context.T(happinessMeaningKey)</p>
                    <p class="player-stat-pillar__recommendation"><strong>@Context.T("players.stats.pillar.recommendation")</strong> @Context.T(happinessRecommendationKey)</p>
                    <dl class="player-stat-pillar__metrics">
                        <div><dt>@Context.T("players.stats.points_added")</dt><dd>@FormatNumber(happinessPointsAdded)</dd></div>
                        <div class="player-stat-pillar__metric--deduction"><dt>@Context.T("players.stats.points_deducted")</dt><dd>@FormatNumber(-happinessPointsDeducted)</dd></div>
                    </dl>
                </article>
            </div>
        </section>

        <section class="player-stats-actions-section" aria-labelledby="player-stats-insights-title">
            <div class="player-stats-section-heading ruleset-section-head">
                <h3 id="player-stats-insights-title" class="ruleset-section-title">@Context.T("players.stats.insights_title")</h3>
                <p class="ruleset-section-subtitle">@Context.T("players.stats.insights_desc")</p>
            </div>
            <ol class="player-stats-actions">
                @for (var insightIndex = 0; insightIndex < Math.Min(3, statSummary.Insights.Count); insightIndex++)
                {
                    var insight = statSummary.Insights[insightIndex];
                    <li class="player-stat-action player-stat-tone-@insight.Tone">
                        <span class="player-stat-action__number">@(insightIndex + 1)</span>
                        <div>
                            <h4>@insight.Title</h4>
                            <p>@insight.Description</p>
                        </div>
                    </li>
                }
            </ol>
        </section>

        <section class="player-metric-library" aria-labelledby="player-metric-library-title">
            <div class="player-metric-library__hero">
                <div>
                    <p class="eyebrow">@Context.T("players.stats.library.badge")</p>
                    <h3 id="player-metric-library-title">@Context.T("players.stats.library.title")</h3>
                    <p>@Context.T("players.stats.library.desc")</p>
                </div>
                <div class="player-metric-library__totals" aria-label="@Context.T("players.stats.library.title")">
                    <div><strong>@rawMetricCount</strong><span>@Context.T("players.stats.library.raw_count")</span></div>
                    <div><strong>@derivedMetricCount</strong><span>@Context.T("players.stats.library.derived_count")</span></div>
                    <div><strong>@Context.T(isAdvancedMode ? "rulesets.form.mode_advanced" : "rulesets.form.mode_beginner")</strong><span>@Context.T("players.stats.library.session_mode")</span></div>
                </div>
            </div>

            @if (rawMetricCount + derivedMetricCount == 0)
            {
                <div class="alert alert-info" aria-live="polite">@Context.T("players.detail.empty_analytics")</div>
            }
            else
            {
                <div class="player-metric-library__collections">
                    @foreach (var collection in metricCollections)
                    {
                        <section class="player-metric-collection player-metric-collection--@collection.Key" aria-labelledby="player-metric-collection-@collection.Key">
                            <div class="player-metric-collection__heading">
                                <div>
                                    <span>@collection.Count @Context.T("players.metric_items_suffix")</span>
                                    <h4 id="player-metric-collection-@collection.Key">@Context.T(collection.TitleKey)</h4>
                                    <p>@Context.T(collection.DescriptionKey)</p>
                                </div>
                            </div>

                            <div class="player-metric-domain-list">
                                @for (var domainIndex = 0; domainIndex < collection.Sections.Count; domainIndex++)
                                {
                                    var domain = collection.Sections[domainIndex];
                                    <details class="player-metric-domain" @(domainIndex == 0 ? "open" : null)>
                                        <summary>
                                            <span>
                                                <strong>@Context.T(domain.TitleKey)</strong>
                                                <small>@Context.T(domain.DescriptionKey)</small>
                                            </span>
                                            <em>@domain.Rows.Count @Context.T("players.metric_items_suffix")</em>
                                        </summary>
                                        <div class="player-metric-card-grid">
                                            @foreach (var row in domain.Rows)
                                            {
                                                var metric = PlayerMetricLabelFormatter.DescribeMetric(
                                                    row.Path,
                                                    row.Value,
                                                    collection.IsDerived,
                                                    isAdvancedMode,
                                                    nullText,
                                                    Context.T);
                                                <article class="player-metric-card player-metric-card--@metric.State">
                                                    <div class="player-metric-card__heading">
                                                        <h5>@metric.Label</h5>
                                                        <span>@Context.T($"players.support.state.{metric.State}")</span>
                                                    </div>
                                                    <p class="player-metric-card__value">
                                                        <strong>@metric.DisplayValue</strong>
                                                        @if (!string.IsNullOrWhiteSpace(metric.Unit))
                                                        {
                                                            <small>@metric.Unit</small>
                                                        }
                                                    </p>
                                                    @if (metric.IsAdvancedOnly)
                                                    {
                                                        <span class="player-metric-card__advanced">@Context.T("players.support.mode.advanced")</span>
                                                    }
                                                    <p class="player-metric-card__explanation">@metric.Explanation</p>
                                                    <details class="player-metric-card__guide">
                                                        <summary>@Context.T("players.stats.library.read_metric")</summary>
                                                        <dl>
                                                            <div>
                                                                <dt>@Context.T("players.support.field.guide")</dt>
                                                                <dd>@metric.Guidance</dd>
                                                            </div>
                                                            <div class="player-metric-card__recommendation">
                                                                <dt>@Context.T("players.support.field.recommendation")</dt>
                                                                <dd>@metric.Recommendation</dd>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(metric.Formula))
                                                            {
                                                                <div>
                                                                    <dt>@Context.T("players.support.field.formula")</dt>
                                                                    <dd>@metric.Formula</dd>
                                                                </div>
                                                            }
                                                        </dl>
                                                    </details>
                                                </article>
                                            }
                                        </div>
                                    </details>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
        </section>
    </div>
</section>

