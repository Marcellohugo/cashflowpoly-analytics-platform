*@
@model Cashflowpoly.Ui.Models.PlayerDirectoryViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = Context.T("nav.players");

    int ResolvePlayerAvatarIndex(int playerOrder)
    {
        if (playerOrder <= 0)
        {
            return 1;
        }

        return ((playerOrder - 1) % 4) + 1;
    }

    string ResolvePlayerAvatarPath(int playerOrder) => $"/images/players/{ResolvePlayerAvatarIndex(playerOrder)}.png";

    var isInstructor = Context.IsInstructor();
    var hasCurrentPlayerId = Guid.TryParse(
        Context.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
        out var currentPlayerId);
    var sessionGroupCount = Model.SessionGroups.Count;
    var sessionPlayerIds = Model.SessionGroups
        .SelectMany(session => session.Players)
        .Select(player => player.PlayerId)
        .ToHashSet();
    var ungroupedPlayers = Model.Players
        .Where(player => !sessionPlayerIds.Contains(player.UserId))
        .ToList();
    var hasGroupingError = !string.IsNullOrWhiteSpace(Model.ErrorMessage);
}

<section class="section-shell w-full">
    <div class="page-intro">
        <div class="page-intro-main">
            <p class="eyebrow">@Context.T("players.management")</p>
            <h1 class="headline">@Context.T("players.title")</h1>
            <p class="subhead">@Context.T(isInstructor ? "players.subtitle" : "players.player_directory_subtitle")</p>
        </div>
        <div class="page-intro-actions">
            <span class="hint-chip">@Context.T("players.index.source_hint")</span>
        </div>
    </div>

    <div class="mt-6 ruleset-unified players-index-shell">
        <section class="players-index-section">
            <div class="ruleset-section-head ruleset-section-head-row">
                <div>
                    <p class="ruleset-section-title">@Context.T("players.index.summary_title")</p>
                    <p class="ruleset-section-subtitle">@Context.T(isInstructor ? "players.index.monitored_subtitle" : "players.index.summary_subtitle")</p>
                </div>
                <div class="ruleset-index-count-block">
                    <p class="text-xs uppercase text-slate-500">@Context.T(isInstructor ? "players.monitored_players" : "players.total_players")</p>
                    <p class="ruleset-index-count">@(isInstructor ? (hasGroupingError ? "—" : sessionPlayerIds.Count.ToString()) : Model.Players.Count.ToString())</p>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="mt-4 alert alert-error" aria-live="polite">
                @Model.ErrorMessage
            </div>
        }

        <section class="players-index-section mt-4">
            <details class="mt-3 data-toggle">
                <summary>@Context.T("players.tips.title")</summary>
                <div class="mt-3 metric-panel">
                    <div class="metric-list">
                        <div class="metric-row"><span class="metric-key">@Context.T("players.tip_key.validate")</span><span class="metric-value">@Context.T("players.tip.validate")</span></div>
                        <div class="metric-row"><span class="metric-key">@Context.T("players.tip_key.tracking")</span><span class="metric-value">@Context.T("players.tip.tracking")</span></div>
                        <div class="metric-row"><span class="metric-key">@Context.T("players.tip_key.analysis")</span><span class="metric-value">@Context.T("players.tip.analysis")</span></div>
                    </div>
                </div>
            </details>

        </section>



        @{
        <section class="players-index-section mt-5">
            @if (sessionGroupCount == 0 || ungroupedPlayers.Count > 0)
            {
                <div class="ruleset-section-head">
                    <p class="ruleset-section-title">@Context.T(hasGroupingError ? "players.index.ungrouped_title" : isInstructor ? "players.index.outside_my_sessions_title" : "players.index.without_session_title")</p>
                    <p class="ruleset-section-subtitle">@Context.T(hasGroupingError ? "players.index.ungrouped_subtitle" : isInstructor ? "players.index.outside_my_sessions_subtitle" : "players.index.without_session_subtitle")</p>
                </div>

                <div class="mt-3 alert alert-info">
                    @Context.T("players.index.ungrouped_hint")
                </div>

                <div class="mt-3 table-wrap">
                    <table class="w-full text-left text-sm mobile-card-table">
                        <thead class="table-head">
                            <tr>
                                <th class="px-4 py-3">@Context.T("common.name")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (ungroupedPlayers.Count == 0)
                        {
                            <tr>
                                <td class="px-4 py-4 text-slate-500 mobile-card-empty">@Context.T("state.no_players")</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var player in ungroupedPlayers)
                            {
                                <tr class="border-t border-slate-200">
                                    <td class="px-4 py-3" data-label="@Context.T("common.name")">
                                        <span class="font-medium text-slate-900">@player.DisplayName</span>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            }
            @if (sessionGroupCount > 0)
            {
                <div class="ruleset-section-head mt-5">
                    <p class="ruleset-section-title">@Context.T("players.index.grouped_title")</p>
                    <p class="ruleset-section-subtitle">@Context.T(isInstructor ? "players.index.grouped_subtitle" : "players.index.grouped_subtitle.player")</p>
                </div>

                <div class="mt-3 players-session-stack">
                    @foreach (var session in Model.SessionGroups)
                    {
                        var statusClass = string.Equals(session.Status, "STARTED", StringComparison.OrdinalIgnoreCase)
                            ? "status-active"
                            : string.Equals(session.Status, "CREATED", StringComparison.OrdinalIgnoreCase)
                                ? "status-draft"
                                : "status-retired";
                        var isSessionEnded = string.Equals(session.Status, "ENDED", StringComparison.OrdinalIgnoreCase);
                        <details class="data-toggle players-session-card" open>
                            <summary class="players-session-summary">
                                <span class="players-session-summary-main">
                                    <span class="font-semibold text-slate-900">@session.SessionName</span>
                                    <span class="text-xs text-slate-500">(@session.Players.Count @Context.T("players.count_suffix"))</span>
                                    <span class="status-pill @statusClass">@Context.TSessionStatus(session.Status)</span>
                                </span>
                            </summary>

                            @if (session.StartedAt.HasValue || session.EndedAt.HasValue)
                            {
                                <div class="players-session-meta mt-3">
                                @if (session.StartedAt.HasValue)
                                {
                                    <span class="hint-chip">
                                        <span class="font-semibold">@Context.T("common.start"):</span>
                                        @session.StartedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                }
                                @if (session.EndedAt.HasValue)
                                {
                                    <span class="hint-chip">
                                        <span class="font-semibold">@Context.T("common.finish"):</span>
                                        @session.EndedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                }
                                </div>
                            }

                            <div class="mt-3 table-wrap">
                                <table class="w-full text-left text-sm mobile-card-table players-session-table">
                                    <colgroup>
                                        <col class="players-session-col-order" />
                                        <col class="players-session-col-rank" />
                                        <col class="players-session-col-name" />
                                        <col class="players-session-col-score" />
                                        <col class="players-session-col-action" />
                                    </colgroup>
                                    <thead class="table-head">
                                        <tr>
                                            <th class="px-4 py-3">@Context.T("common.turn_order")</th>
                                            <th class="px-4 py-3">@Context.T("common.rank")</th>
                                            <th class="px-4 py-3 players-session-name-heading">@Context.T("common.name")</th>
                                            <th class="px-4 py-3">@Context.T("players.index.happiness_points")</th>
                                            <th class="px-4 py-3">@Context.T("players.index.analytics_column")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (!isSessionEnded)
                                    {
                                        <tr class="border-t border-slate-200">
                                            <td class="px-4 py-5 text-center text-slate-500" colspan="5">@Context.T("players.index.results_pending")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var player in session.Players)
                                        {
                                            var playerRank = player.FinalRank;
                                            var winnerRowClass = playerRank == 1 ? "winner-row" : string.Empty;
                                            <tr class="border-t border-slate-200 @winnerRowClass">
                                                <td class="px-4 py-3 text-slate-700 players-session-number" data-label="@Context.T("common.turn_order")">@(player.PlayerOrder > 0 ? player.PlayerOrder : "-")</td>
                                                <td class="px-4 py-3 text-slate-700 players-session-number" data-label="@Context.T("common.rank")">
                                                    <span class="players-session-rank rank-@playerRank">@(playerRank > 0 ? playerRank : "-")</span>
                                                </td>
                                                <td class="px-4 py-3 players-session-player" data-label="@Context.T("common.name")">
                                                    <div class="flex items-center gap-3">
                                                        <img class="h-7 w-7 rounded-full border border-slate-200 object-cover"
                                                             src="@ResolvePlayerAvatarPath(player.PlayerOrder)"
                                                             alt="@($"{Context.T("common.turn_order")} {(player.PlayerOrder > 0 ? player.PlayerOrder : 1)}")" />
                                                        <span class="font-medium text-slate-900">@player.DisplayName</span>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 players-session-number" data-label="@Context.T("players.index.happiness_points")">
                                                    <strong class="players-session-score">@player.HappinessPointsTotal</strong>
                                                </td>
                                                <td class="px-4 py-3 players-session-action" data-label="@Context.T("players.index.analytics_column")">
                                                    @if (isInstructor || (hasCurrentPlayerId && player.PlayerId == currentPlayerId))
                                                    {
                                                        <a class="table-link"
                                                           asp-controller="Players"
                                                           asp-action="Details"
                                                           asp-route-sessionId="@session.SessionId"
                                                           asp-route-playerId="@player.PlayerId">@Context.T("players.index.view_detail")</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-slate-400" aria-label="@Context.T("players.index.detail_unavailable")">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </div>
            }
        </section>
        }
    </div>
</section>
