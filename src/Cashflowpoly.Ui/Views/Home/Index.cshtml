@* Fungsi file: Merender tampilan Razor untuk bagian Home/Index.cshtml beserta interaksi presentasinya. *@
@model Cashflowpoly.Ui.Models.HomeIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Context.T("nav.home");
    ViewData["MetaDescription"] = Context.T("home.meta_desc");
    ViewData["MetaKeywords"] = Context.T("home.meta_keywords");
    var isInstructor = Context.IsInstructor();
    var heroBadge = isInstructor ? Context.T("home.badge") : Context.T("home.player_badge");
    var heroTitle = isInstructor
        ? Context.T("home.title")
        : Context.T("home.player_title");
    var heroSubtitle = isInstructor
        ? Context.T("home.subtitle")
        : Context.T("home.player_subtitle");
    var primaryCtaController = "Sessions";
    var primaryCtaText = isInstructor ? Context.T("home.cta.sessions") : Context.T("home.cta.my_progress");
    var secondaryCtaController = isInstructor ? "Rulesets" : "Sessions";
    var secondaryCtaText = isInstructor
        ? Context.T("home.cta.open_ruleset")
        : Context.T("home.cta.session_ruleset");
    var totalSessionsLabel = isInstructor ? Context.T("home.total_sessions") : Context.T("home.my_sessions");
    var totalPlayersLabel = isInstructor ? Context.T("home.players_monitored") : Context.T("home.players_in_my_sessions");
    var hasWorkspaceData = Model.TotalSessions > 0 || Model.TotalPlayers > 0 || (isInstructor && Model.TotalRulesets > 0);
    var activeSessionPercent = Model.TotalSessions > 0 && Model.ActiveSessions.HasValue
        ? Math.Clamp((int)Math.Round(Model.ActiveSessions.Value * 100d / Model.TotalSessions.Value), 0, 100)
        : 0;
}

<section class="home-hero section-shell @(isInstructor ? "home-hero-instructor" : "home-hero-player")">
    <div class="home-command">
        <div class="home-command-main">
            <div class="home-command-intro page-intro">
                <div class="home-command-copy page-intro-main">
                    <p class="eyebrow">@heroBadge</p>
                    <h1 class="headline">@heroTitle</h1>
                    <p class="subhead">@heroSubtitle</p>
                </div>
                <div class="home-command-actions">
                    <a class="btn-primary" asp-controller="@primaryCtaController" asp-action="Index">@primaryCtaText</a>
                    <a class="btn-ghost" asp-controller="@secondaryCtaController" asp-action="Index">@secondaryCtaText</a>
                </div>
            </div>

            <aside class="home-live-card" aria-label="@Context.T("home.active_sessions")">
                <div class="home-live-header">
                    <span class="home-live-indicator" aria-hidden="true"></span>
                    <span>@Context.T("home.active_sessions")</span>
                </div>
                <div id="home-session-ring"
                     class="home-session-ring"
                     style="--home-active-progress: @(activeSessionPercent)%"
                     role="img"
                     aria-label="@(Model.ActiveSessions?.ToString() ?? "—") / @(Model.TotalSessions?.ToString() ?? "—") @Context.T("home.active_sessions")">
                    <div class="home-session-ring-core">
                        <strong id="home-active-sessions">@(Model.ActiveSessions?.ToString() ?? "—")</strong>
                        <span id="home-active-total-sessions">/ @(Model.TotalSessions?.ToString() ?? "—")</span>
                    </div>
                </div>
            </aside>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div id="home-realtime-error" class="alert alert-warning text-xs" aria-live="polite">
                @Model.ErrorMessage
            </div>
        }
        else
        {
            <div id="home-realtime-error" class="hidden alert alert-warning text-xs" aria-live="polite"></div>
        }

        <div class="home-stat-grid @(isInstructor ? null : "home-stat-grid-player")">
            <article class="home-stat-card home-stat-card-sessions">
                <span class="home-stat-label">@totalSessionsLabel</span>
                <strong id="home-total-sessions">@(Model.TotalSessions?.ToString() ?? "—")</strong>
                <span class="home-stat-accent" aria-hidden="true"></span>
            </article>
            <article class="home-stat-card home-stat-card-players">
                <span class="home-stat-label">@totalPlayersLabel</span>
                <strong id="home-total-players">@(Model.TotalPlayers?.ToString() ?? "—")</strong>
                <span class="home-stat-accent" aria-hidden="true"></span>
            </article>
            @if (isInstructor)
            {
                <article class="home-stat-card home-stat-card-rulesets">
                    <span class="home-stat-label">@Context.T("home.ruleset_active")</span>
                    <strong id="home-total-rulesets">@(Model.TotalRulesets?.ToString() ?? "—")</strong>
                    <span class="home-stat-accent" aria-hidden="true"></span>
                </article>
            }
        </div>

        @if (!hasWorkspaceData && Model.ErrorMessage is null)
        {
            <div class="home-empty-state" aria-live="polite">
                <p class="home-empty-state-title">@Context.T("home.empty_workspace.title")</p>
                <p class="home-empty-state-body">@(isInstructor
                    ? Context.T("home.empty_workspace.instructor")
                    : Context.T("home.empty_workspace.player"))</p>
            </div>
        }

    </div>
</section>



@section Scripts {
    <script>
        (() => {
            const totalSessionsEl = document.getElementById("home-total-sessions");
            const activeSessionsEl = document.getElementById("home-active-sessions");
            const activeTotalSessionsEl = document.getElementById("home-active-total-sessions");
            const sessionRingEl = document.getElementById("home-session-ring");
            const totalPlayersEl = document.getElementById("home-total-players");
            const totalRulesetsEl = document.getElementById("home-total-rulesets");
            const realtimeErrorEl = document.getElementById("home-realtime-error");
            const activeSessionsLabel = @Html.Raw(JsonSerializer.Serialize(Context.T("home.active_sessions")));
            const realtimeStatusTemplate = @Html.Raw(JsonSerializer.Serialize(Context.T("home.error.realtime_status")));
            const realtimeNetworkMessage = @Html.Raw(JsonSerializer.Serialize(Context.T("home.error.realtime_network")));
            const realtimePollIntervalMs = 30000;
            let realtimeTimerId = null;

            const setError = (message) => {
                if (!realtimeErrorEl) return;
                if (!message) {
                    realtimeErrorEl.textContent = "";
                    realtimeErrorEl.classList.add("hidden");
                    return;
                }

                realtimeErrorEl.textContent = message;
                realtimeErrorEl.classList.remove("hidden");
            };

            const syncRealtimeStats = async () => {
                try {
                    const response = await fetch("@Url.Action("RealtimeStats", "Home")", {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    if (response.redirected && response.url.includes("/auth/login")) {
                        window.location.assign(response.url);
                        return;
                    }

                    if (!response.ok) {
                        setError(realtimeStatusTemplate.replace("{status}", `${response.status}`));
                        return;
                    }

                    const data = await response.json();
                    const totalSessions = Number.isFinite(data.totalSessions) ? data.totalSessions : null;
                    const activeSessions = Number.isFinite(data.activeSessions) ? data.activeSessions : null;
                    const totalPlayers = Number.isFinite(data.totalPlayers) ? data.totalPlayers : null;
                    const totalRulesets = Number.isFinite(data.totalRulesets) ? data.totalRulesets : null;
                    const activePercentage = totalSessions > 0 && activeSessions !== null
                        ? Math.min(100, Math.max(0, Math.round(activeSessions * 100 / totalSessions)))
                        : 0;

                    if (totalSessionsEl) totalSessionsEl.textContent = `${totalSessions ?? "—"}`;
                    if (activeSessionsEl) activeSessionsEl.textContent = `${activeSessions ?? "—"}`;
                    if (activeTotalSessionsEl) activeTotalSessionsEl.textContent = `/ ${totalSessions ?? "—"}`;
                    if (sessionRingEl) {
                        sessionRingEl.style.setProperty("--home-active-progress", `${activePercentage}%`);
                        sessionRingEl.setAttribute("aria-label", `${activeSessions ?? "—"} / ${totalSessions ?? "—"} ${activeSessionsLabel}`);
                    }
                    if (totalPlayersEl) totalPlayersEl.textContent = `${totalPlayers ?? "—"}`;
                    if (totalRulesetsEl) totalRulesetsEl.textContent = `${totalRulesets ?? "—"}`;

                    setError(data.errorMessage);
                } catch {
                    setError(realtimeNetworkMessage);
                }
            };

            const stopRealtimeSync = () => {
                if (realtimeTimerId !== null) {
                    clearInterval(realtimeTimerId);
                    realtimeTimerId = null;
                }
            };

            const startRealtimeSync = () => {
                if (realtimeTimerId !== null) {
                    return;
                }

                syncRealtimeStats();
                realtimeTimerId = setInterval(syncRealtimeStats, realtimePollIntervalMs);
            };

            const handleVisibilityChange = () => {
                if (document.visibilityState === "visible") {
                    startRealtimeSync();
                    return;
                }

                stopRealtimeSync();
            };

            document.addEventListener("visibilitychange", handleVisibilityChange);
            handleVisibilityChange();
        })();
    </script>
}
