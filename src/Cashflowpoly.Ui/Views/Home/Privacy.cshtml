@* Fungsi file: Merender halaman Buku Aturan Cashflowpoly dengan struktur referensi yang mudah dipindai. *@
@model Cashflowpoly.Ui.Models.RulebookPageViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = Context.T("privacy.title");
    var sections = Model.Sections ?? new System.Collections.Generic.List<Cashflowpoly.Ui.Models.RulebookSectionViewModel>();
    var scoring = Model.Scoring ?? new System.Collections.Generic.List<Cashflowpoly.Ui.Models.RulebookScoreItemViewModel>();
    var activeLanguage = UiText.NormalizeLanguage(Context.Session.GetString(AuthConstants.SessionLanguageKey));
    var isEnglish = string.Equals(activeLanguage, AuthConstants.LanguageEn, StringComparison.OrdinalIgnoreCase);
    var totalPoints = 0;
    foreach (var section in sections)
    {
        totalPoints += section.Points.Count;
    }

    string L(string id, string en) => isEnglish ? en : id;
}

<section class="section-shell rulebook-page" id="rb-top">
    <div class="page-intro rulebook-hero">
        <div class="page-intro-main">
            <p class="eyebrow">@L("Entrepreneur Edition", "Entrepreneur Edition")</p>
            <h1 class="headline">@ViewData["Title"]</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <p class="subhead">@Model.Subtitle</p>
            }
        </div>
        <div class="page-intro-actions">
            <span class="hint-chip">@Context.T("privacy.total_sections"): @sections.Count</span>
            <span class="hint-chip">@Context.T("privacy.total_points"): @totalPoints</span>
        </div>
    </div>

    <div class="rulebook-flow-map" aria-label='@L("Alur utama buku aturan", "Main rulebook flow")'>
        <a href="#rb-stage-setup">@L("Setup Meja", "Table Setup")</a>
        <a href="#rb-stage-player">@L("Setup Pemain", "Player Setup")</a>
        <a href="#rb-stage-turn">@L("2 Aksi / Giliran", "2 Actions / Turn")</a>
        <a href="#rb-stage-special">@L("Hari Khusus", "Special Days")</a>
        <a href="#rb-stage-score">@L("Skoring", "Scoring")</a>
    </div>

    <div class="rulebook-page-grid">
        <div class="rulebook-main">
            <section id="rb-visual" class="rulebook-surface">
                <div class="rulebook-section-head">
                    <div>
                        <p class="eyebrow">@L("Rujukan PDF", "PDF Reference")</p>
                        <h2 class="rulebook-heading">@L("Alur permainan dari setup sampai skoring", "Gameplay flow from setup to scoring")</h2>
                    </div>
                    <a class="rulebook-top-link" href="#rb-top">@Context.T("privacy.back_to_top")</a>
                </div>

                <div class="rulebook-stage-grid">
                    <article id="rb-stage-setup" class="rulebook-stage-card">
                        <img class="rulebook-stage-shot" src="~/images/rulebook/setup-mode-pemula.jpg" asp-append-version="true" alt='@L("Setup mode pemula", "Beginner mode setup")' loading="lazy" />
                        <div>
                            <h3>@L("Setup Mode Pemula", "Beginner Setup")</h3>
                            <p>@L("Papan poin, penghasilan, pengeluaran, bank koin, bahan, pesanan, dan kebutuhan primer dibaca sebagai dasar semua transaksi awal.", "Point, income, expense, coin bank, ingredient, order, and primary-need boards define the baseline for early transactions.")</p>
                        </div>
                    </article>
                    <article class="rulebook-stage-card">
                        <img class="rulebook-stage-shot" src="~/images/rulebook/setup-mode-mahir.jpg" asp-append-version="true" alt='@L("Setup mode mahir", "Advanced mode setup")' loading="lazy" />
                        <div>
                            <h3>@L("Setup Mode Mahir", "Advanced Setup")</h3>
                            <p>@L("Mode mahir menambah target tabungan, risiko kehidupan, asuransi, dan bank syariah sehingga metrik risiko dan pinjaman bisa diperiksa.", "Advanced mode adds saving goals, life risks, insurance, and sharia bank so risk and debt metrics can be inspected.")</p>
                        </div>
                    </article>
                    <article id="rb-stage-player" class="rulebook-stage-card">
                        <img class="rulebook-stage-shot" src="~/images/rulebook/alur-giliran.jpg" asp-append-version="true" alt='@L("Alur giliran permainan", "Gameplay turn flow")' loading="lazy" />
                        <div>
                            <h3>@L("Setup Pemain dan Giliran", "Player Setup and Turns")</h3>
                            <p>@L("Setiap pemain punya 2 token aksi. Urutan, hari, dan sequence event dipakai untuk membaca kepatuhan giliran.", "Each player has 2 action tokens. Order, day, and event sequence are used to read turn compliance.")</p>
                        </div>
                    </article>
                    <article id="rb-stage-turn" class="rulebook-stage-card">
                        <img class="rulebook-stage-shot" src="~/images/rulebook/aksi-kebutuhan-freelance.jpg" asp-append-version="true" alt='@L("Aksi kebutuhan dan kerja lepas", "Needs and freelance actions")' loading="lazy" />
                        <div>
                            <h3>@L("Aksi Utama", "Core Actions")</h3>
                            <p>@L("Bahan, klaim pesanan, beli kebutuhan, dan kerja lepas adalah alur utama untuk kas, inventory, kebutuhan, dan efisiensi order.", "Ingredients, order claims, need purchases, and freelance work drive cash, inventory, needs, and order efficiency.")</p>
                        </div>
                    </article>
                    <article id="rb-stage-special" class="rulebook-stage-card">
                        <img class="rulebook-stage-shot" src="~/images/rulebook/aksi-risiko-asuransi.jpg" asp-append-version="true" alt='@L("Risiko dan asuransi", "Risk and insurance")' loading="lazy" />
                        <div>
                            <h3>@L("Risiko, Asuransi, Pinjaman", "Risk, Insurance, Debt")</h3>
                            <p>@L("Risiko kehidupan, klaim asuransi, opsi darurat, pinjaman, dan tabungan membentuk metrik ketahanan finansial.", "Life risks, insurance claims, emergency options, loans, and savings form the financial resilience metrics.")</p>
                        </div>
                    </article>
                    <article class="rulebook-stage-card">
                        <img class="rulebook-stage-shot" src="~/images/rulebook/aksi-donasi-emas.jpg" asp-append-version="true" alt='@L("Donasi dan investasi emas", "Donation and gold investment")' loading="lazy" />
                        <div>
                            <h3>@L("Jumat dan Sabtu", "Friday and Saturday")</h3>
                            <p>@L("Donasi Jumat dan investasi emas Sabtu memengaruhi poin sosial, ROI emas, dan strategi likuiditas.", "Friday donations and Saturday gold investment affect social points, gold ROI, and liquidity strategy.")</p>
                        </div>
                    </article>
                    <article id="rb-stage-score" class="rulebook-stage-card">
                        <img class="rulebook-stage-shot" src="~/images/rulebook/perhitungan-poin.jpg" asp-append-version="true" alt='@L("Perhitungan poin kebahagiaan", "Happiness point calculation")' loading="lazy" />
                        <div>
                            <h3>@L("Perhitungan Poin", "Point Calculation")</h3>
                            <p>@L("Poin kebutuhan, bonus set, donasi, emas, dana pensiun, tujuan keuangan, penalti misi, dan penalti pinjaman dihitung di akhir sesi.", "Need points, set bonus, donation, gold, pension, financial goals, mission penalty, and loan penalty are calculated at session end.")</p>
                        </div>
                    </article>
                </div>
            </section>

            <section id="rb-reference" class="rulebook-surface">
                <div class="rulebook-section-head">
                    <div>
                        <p class="eyebrow">@L("Metrik ke aturan", "Metrics to rules")</p>
                        <h2 class="rulebook-heading">@L("Apa yang dilihat di analitika dan sumber aturannya", "What analytics show and where the rule comes from")</h2>
                    </div>
                    <a class="rulebook-top-link" href="#rb-top">@Context.T("privacy.back_to_top")</a>
                </div>
                <div class="table-wrap rulebook-table-shell">
                    <table class="w-full text-left text-sm rulebook-reference-table">
                        <thead class="table-head">
                            <tr>
                                <th class="px-4 py-3">@L("Domain", "Domain")</th>
                                <th class="px-4 py-3">@L("Yang dicek", "What to inspect")</th>
                                <th class="px-4 py-3">@L("Rujukan PDF", "PDF reference")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td class="px-4 py-3 font-semibold">@L("Kas", "Cash")</td><td class="px-4 py-3">@L("Saldo awal, kas masuk, kas keluar, saldo akhir, dan arus kas bersih.", "Starting cash, cash in, cash out, ending cash, and net cashflow.")</td><td class="px-4 py-3">@L("Catatan Arus Kas, Hal. 25", "Cashflow Notes, Pg. 25")</td></tr>
                            <tr><td class="px-4 py-3 font-semibold">@L("Bahan dan Pesanan", "Ingredients and Orders")</td><td class="px-4 py-3">@L("Pembelian bahan, bahan terpakai, order berhasil, order terlewat, dan efisiensi bisnis.", "Ingredient purchases, used ingredients, completed orders, passed orders, and business efficiency.")</td><td class="px-4 py-3">@L("Hal. 13-15", "Pg. 13-15")</td></tr>
                            <tr><td class="px-4 py-3 font-semibold">@L("Kebutuhan dan Misi", "Needs and Mission")</td><td class="px-4 py-3">@L("Primer, sekunder, tersier, misi koleksi, bonus set, dan penalti misi.", "Primary, secondary, tertiary needs, collection mission, set bonus, and mission penalty.")</td><td class="px-4 py-3">@L("Hal. 17 dan 27", "Pg. 17 and 27")</td></tr>
                            <tr><td class="px-4 py-3 font-semibold">@L("Risiko dan Pinjaman", "Risk and Debt")</td><td class="px-4 py-3">@L("Risiko kehidupan, asuransi, opsi darurat, pinjaman syariah, pelunasan, dan penalti pinjaman.", "Life risks, insurance, emergency options, sharia loan, repayment, and loan penalty.")</td><td class="px-4 py-3">@L("Hal. 19-21 dan 27", "Pg. 19-21 and 27")</td></tr>
                            <tr><td class="px-4 py-3 font-semibold">@L("Donasi, Emas, Pensiun", "Donation, Gold, Pension")</td><td class="px-4 py-3">@L("Peringkat donasi, transaksi emas, ROI emas, dana pensiun, dan komposisi poin akhir.", "Donation rank, gold trades, gold ROI, pension fund, and final point portfolio.")</td><td class="px-4 py-3">@L("Hal. 23 dan 27", "Pg. 23 and 27")</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="rulebook-surface">
                <div class="rulebook-section-head">
                    <div>
                        <p class="eyebrow">@L("Alur per mode", "Mode flow")</p>
                        <h2 class="rulebook-heading">@L("Alur permainan dari awal sampai akhir sesi", "Gameplay flow from start to session end")</h2>
                    </div>
                    <a class="rulebook-top-link" href="#rb-top">@Context.T("privacy.back_to_top")</a>
                </div>
                <div class="rulebook-mode-flow-grid">
                    <article class="rulebook-mode-flow-card">
                        <h3>@L("Mode Pemula", "Beginner Mode")</h3>
                        <ol>
                            <li>@L("Siapkan papan poin, bank koin, kartu bahan, kartu pesanan, kartu kebutuhan, kartu emas, kartu donasi, misi koleksi, dan dana pensiun.", "Set up point board, coin bank, ingredient cards, order cards, need cards, gold cards, donation cards, collection mission, and pension fund.")</li>
                            <li>@L("Setiap pemain menerima layar pemain, token aksi, koin awal, target misi, dan urutan giliran.", "Each player receives player screen, action tokens, starting coins, mission target, and turn order.")</li>
                            <li>@L("Pada setiap giliran, pemain memakai maksimal 2 token aksi untuk membeli bahan, klaim pesanan, membeli kebutuhan, bekerja lepas, mencatat transaksi, atau aksi hari khusus.", "On each turn, the player spends up to 2 action tokens for ingredients, orders, needs, freelance work, transaction notes, or special-day actions.")</li>
                            <li>@L("Jumat dipakai untuk donasi, Sabtu untuk investasi emas, lalu seluruh arus kas masuk dan keluar dicatat sebagai dasar analitika.", "Friday is used for donation, Saturday for gold investment, then all cash in and cash out are recorded for analytics.")</li>
                            <li>@L("Sesi berakhir dengan perhitungan poin kebutuhan, bonus set, donasi, emas, dana pensiun, tie breaker, dan penalti misi koleksi.", "The session ends with need points, set bonus, donation, gold, pension fund, tie breaker, and collection mission penalty.")</li>
                        </ol>
                    </article>
                    <article class="rulebook-mode-flow-card">
                        <h3>@L("Mode Mahir", "Advanced Mode")</h3>
                        <ol>
                            <li>@L("Mulai dari seluruh setup mode pemula, lalu tambahkan papan tujuan keuangan, kartu risiko kehidupan, asuransi, tabungan, dan bank syariah.", "Start from the beginner setup, then add financial goal board, life risk cards, insurance, savings, and sharia bank.")</li>
                            <li>@L("Setiap pemain mendapat target keuangan tambahan dan harus mengelola risiko, perlindungan asuransi, pinjaman, serta pelunasan.", "Each player receives additional financial goals and must manage risk, insurance protection, loans, and repayment.")</li>
                            <li>@L("Giliran tetap memakai 2 token aksi, tetapi pilihan aksi bertambah: menabung, mengambil atau melunasi pinjaman, membeli asuransi, memakai klaim, dan merespons risiko.", "Turns still use 2 action tokens, but actions expand to saving, taking or repaying loans, buying insurance, using claims, and responding to risks.")</li>
                            <li>@L("Setiap kejadian risiko, premi, klaim, tabungan, dan pinjaman dicatat agar metrik ketahanan finansial dan leverage bisa dibaca jelas.", "Each risk event, premium, claim, saving, and loan is recorded so resilience and leverage metrics are readable.")</li>
                            <li>@L("Akhir sesi menghitung semua poin mode pemula ditambah poin tujuan keuangan, status pinjaman, perlindungan risiko, serta penalti pinjaman yang belum lunas.", "Session end counts all beginner-mode points plus financial goal points, loan status, risk protection, and penalty for unpaid loans.")</li>
                        </ol>
                    </article>
                </div>
                <div class="rulebook-unified">
                    <div class="rulebook-stream">
                        @if (sections.Count == 0)
                        {
                            <div class="alert alert-info">
                                @Context.T("privacy.empty_sections")
                            </div>
                        }
                        else
                        {
                            @for (var index = 0; index < sections.Count; index++)
                            {
                                var sectionItem = sections[index];
                                var anchor = $"rb-section-{index + 1}";
                                <article class="rulebook-stream-item" id="@anchor">
                                    <div class="rulebook-stream-head">
                                        <div class="rulebook-heading-wrap">
                                            <span class="rulebook-section-chip">@L($"Bagian {index + 1}", $"Section {index + 1}")</span>
                                            <h2 class="rulebook-heading">@sectionItem.Heading</h2>
                                        </div>
                                        <a class="rulebook-top-link" href="#rb-top">@Context.T("privacy.back_to_top")</a>
                                    </div>
                                    <p class="rulebook-desc">@sectionItem.Description</p>
                                    <ul class="rulebook-list">
                                        @foreach (var point in sectionItem.Points)
                                        {
                                            <li>@point</li>
                                        }
                                    </ul>
                                </article>
                            }
                        }
                    </div>
                </div>
            </section>

            <section id="rb-scoring" class="rulebook-surface">
                <div class="rulebook-section-head">
                    <div>
                        <p class="eyebrow">@L("Akhir sesi", "Session end")</p>
                        <h2 class="rulebook-heading">@Context.T("privacy.happiness_summary")</h2>
                    </div>
                    <a class="rulebook-top-link" href="#rb-top">@Context.T("privacy.back_to_top")</a>
                </div>
                <div class="table-wrap rulebook-table-shell">
                    <table class="w-full text-left text-sm rulebook-scoring-table">
                        <thead class="table-head">
                            <tr>
                                <th class="px-4 py-3">@Context.T("privacy.category")</th>
                                <th class="px-4 py-3">@Context.T("privacy.rule")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (scoring.Count == 0)
                        {
                            <tr>
                                <td class="px-4 py-4 text-slate-500" colspan="2">@Context.T("privacy.empty_scoring")</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in scoring)
                            {
                                <tr class="border-t border-slate-200">
                                    <td class="px-4 py-3 font-semibold text-slate-900">@item.Category</td>
                                    <td class="px-4 py-3 text-slate-700">@item.Rule</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </section>

            <article id="rulebook-copyright" class="rulebook-surface rulebook-copyright">
                <h2>@Context.T("privacy.copyright_title")</h2>
                <p>@Context.T("privacy.copyright_desc")</p>
            </article>
        </div>
    </div>
</section>
