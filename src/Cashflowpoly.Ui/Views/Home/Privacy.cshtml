<section class="section-shell rulebook-page" id="rb-top">
    <div class="page-intro rulebook-hero">
        <div class="page-intro-main">
            <p class="eyebrow">@L("Entrepreneur Edition", "Entrepreneur Edition")</p>
            <h1 class="headline">@ViewData["Title"]</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <p class="subhead">@Model.Subtitle</p>
            }
        </div>
        <div class="page-intro-actions">
            <span class="hint-chip">@L("Ringkas untuk dibaca saat main", "Condensed for live play")</span>
        </div>
    </div>

    <div class="rulebook-flow-map" aria-label='@L("Navigasi buku aturan", "Rulebook navigation")'>
        <a href="#rb-guide">@L("Mulai", "Start")</a>
        <a href="#rb-stage-setup">@L("Setup", "Setup")</a>
        <a href="#rb-stage-turn">@L("Main", "Play")</a>
        <a href="#rb-reference">@L("Referensi", "Reference")</a>
        <a href="#rb-scoring">@L("Poin Kebahagiaan", "Scoring")</a>
    </div>

    <div class="rulebook-page-grid">
        <div class="rulebook-main">
            <section id="rb-guide" class="rulebook-surface rulebook-anchor-target">
                <div class="rulebook-section-head">
                    <div>
                        <p class="eyebrow">@L("Panduan ringkas", "Quick guide")</p>
                        <h2 class="rulebook-heading">@L("Panduan ringkas untuk mulai main", "Quick guide to start playing")</h2>
                    </div>
                    <a class="rulebook-top-link" href="#rb-top">@("↑ " + Context.T("privacy.back_to_top"))</a>
                </div>
                <p class="rulebook-surface-lead">@L("Baca bagian ini dari kiri ke kanan bila Anda baru menyiapkan sesi. Setelah itu, cukup lompat ke gambar atau referensi cepat di bawah.", "Read this section from left to right when you are setting up a session for the first time. After that, jump straight to the visuals or quick reference below.")</p>

                <div class="rulebook-guide-grid">
                    @foreach (var step in guideSteps)
                    {
                        <article class="rulebook-guide-card">
                            <p class="rulebook-kicker">@L(step.StepId, step.StepEn)</p>
                            <h3>@L(step.TitleId, step.TitleEn)</h3>
                            <ul class="rulebook-list">
                                @foreach (var point in isEnglish ? step.PointsEn : step.PointsId)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                        </article>
                    }
                </div>
            </section>

            <section id="rb-visual" class="rulebook-surface">
                <div class="rulebook-section-head">
                    <div>
                        <p class="eyebrow">@L("Visual setup dan flow", "Setup and flow visuals")</p>
                        <h2 class="rulebook-heading">@L("Gambar besar untuk titik yang paling sering dicek", "Large visuals for the points you check most often")</h2>
                    </div>
                    <a class="rulebook-top-link" href="#rb-top">@("↑ " + Context.T("privacy.back_to_top"))</a>
                </div>
                <p class="rulebook-surface-lead">@L("Setiap gambar hanya ditemani catatan inti. Tidak ada paragraf panjang supaya Anda bisa cepat melihat meja dan lanjut bermain.", "Each visual comes with only the key notes. No long paragraphs, so you can inspect the board quickly and keep the session moving.")</p>

                <div class="rulebook-visual-stack">
                    @foreach (var panel in visualPanels)
                    {
                        <article class="rulebook-visual-panel rulebook-anchor-target" id="@panel.Id">
                            <img class="rulebook-stage-shot" src="@panel.Image" asp-append-version="true" alt='@L(panel.AltId, panel.AltEn)' loading="lazy" />
                            <div class="rulebook-visual-copy">
                                <p class="eyebrow">@L(panel.PageId, panel.PageEn)</p>
                                <h3>@L(panel.TitleId, panel.TitleEn)</h3>
                                <ul class="rulebook-list">
                                    @foreach (var note in isEnglish ? panel.NotesEn : panel.NotesId)
                                    {
                                        <li>@note</li>
                                    }
                                </ul>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <section id="rb-reference" class="rulebook-surface rulebook-anchor-target">
                <div class="rulebook-section-head">
                    <div>
                        <p class="eyebrow">@L("Referensi cepat", "Quick reference")</p>
                        <h2 class="rulebook-heading">@L("Referensi cepat saat bermain", "Quick reference during play")</h2>
                    </div>
                    <a class="rulebook-top-link" href="#rb-top">@("↑ " + Context.T("privacy.back_to_top"))</a>
                </div>
                <p class="rulebook-surface-lead">@L("Bagian ini dipakai seperti cheat sheet. Buka saat giliran berjalan dan Anda butuh jawaban singkat, bukan penjelasan panjang.", "Use this section like a cheat sheet. Open it while turns are running and you need a short answer, not a long explanation.")</p>

                <div class="rulebook-reference-grid">
                    @foreach (var card in referenceCards)
                    {
                        <article class="rulebook-reference-card">
                            <p class="rulebook-kicker">@L(card.EyebrowId, card.EyebrowEn)</p>
                            <h3>@L(card.TitleId, card.TitleEn)</h3>
                            <ul class="rulebook-list">
                                @foreach (var point in isEnglish ? card.PointsEn : card.PointsId)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                        </article>
                    }
                </div>
            </section>

            <section id="rb-scoring" class="rulebook-surface rulebook-anchor-target">
                <div class="rulebook-section-head">
                    <div>
                        <p class="eyebrow">@L("Perhitungan akhir", "Final scoring")</p>
                        <h2 class="rulebook-heading">@L("Hitung poin kebahagiaan tanpa bolak-balik halaman", "Score without jumping between pages")</h2>
                    </div>
                    <a class="rulebook-top-link" href="#rb-top">@("↑ " + Context.T("privacy.back_to_top"))</a>
                </div>
                <p class="rulebook-surface-lead">@L("Urutan di bawah mengikuti logika perhitungan poin kebahagiaan pada PDF: hitung, tambah, cek syarat mode mahir, lalu kurangi penalti.", "The order below follows the scoring logic from the PDF: count, add, check advanced-mode conditions, then subtract penalties.")</p>

                <div class="rulebook-score-visual">
                    <img class="rulebook-stage-shot" src="~/images/rulebook/perhitungan-poin.jpg" asp-append-version="true" alt='@L("Perhitungan poin kebahagiaan", "Happiness point calculation")' loading="lazy" />
                </div>

                <div class="rulebook-score-flow">
                    @foreach (var item in scoreFlow)
                    {
                        <article class="rulebook-score-step">
                            <h3>@L(item.TitleId, item.TitleEn)</h3>
                            <p>@L(item.DescId, item.DescEn)</p>
                        </article>
                    }
                </div>

                @if (scoring.Count == 0)
                {
                    <div class="alert alert-info">
                        @Context.T("privacy.empty_scoring")
                    </div>
                }
                else
                {
                    <div class="rulebook-score-grid">
                        @foreach (var item in scoring)
                        {
                            <article class="rulebook-score-card">
                                <h3>@item.Category</h3>
                                <p>@item.Rule</p>
                            </article>
                        }
                    </div>
                }
            </section>

            <article id="rulebook-copyright" class="rulebook-surface rulebook-copyright rulebook-anchor-target">
                <h2>@Context.T("privacy.copyright_title")</h2>
                <p>@Context.T("privacy.copyright_desc")</p>
            </article>
        </div>
    </div>
</section>
